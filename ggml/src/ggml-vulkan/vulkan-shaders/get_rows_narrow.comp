#version 450

#include "types.glsl"
#include "generic_binary_head.glsl"

// GET_ROWS for narrow rows (ne00 <= the host's narrow width): one invocation per dst element, the rows packed back to back,
// so a workgroup gathers many rows. get_rows.comp runs one 512-lane workgroup per row, which leaves most lanes idle at
// these widths. Same element read, conversion and store as get_rows.comp. p.ne is the number of dst elements here.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() {
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;

    for (uint idx = gl_GlobalInvocationID.x; idx < p.ne; idx += stride) {
        // dst is [ne00, ne10, ne11, ne12]
        const uint i00 = idx % p.ne00;
        uint r = idx / p.ne00;
        const uint i10 = r % p.ne10;
        r /= p.ne10;
        const uint i11 = r % p.ne11;
        const uint i12 = r / p.ne11;

        const uint i01 = data_b[get_boffset() + i10*p.nb10 + i11*p.nb11 + i12*p.nb12];

        const uint a_offset = get_aoffset() + i01*p.nb01 + i11*p.nb02 + i12*p.nb03;
        const uint d_offset = get_doffset() + i10*p.nb21 + i11*p.nb22 + i12*p.nb23;

#if defined(DATA_A_BF16)
        TEMP_TYPE v = TEMP_TYPE(bf16_to_fp32(data_a[a_offset + i00]));
#else
        TEMP_TYPE v = TEMP_TYPE(data_a[a_offset + i00]);
#endif
        data_d[d_offset + i00] = D_TYPE(v);
    }
}
