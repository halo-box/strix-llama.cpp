#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

#include "types.glsl"

layout(constant_id = 0) const int BLOCK_SIZE = 1024;
layout(constant_id = 1) const int QSA = 0; // 1: fuse the qwen4 QSA indexer gather + f16 mask

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A  {float     data_a[];};   // input values, or QSA block scores [n_tps, n_blocks, n_stream]
layout (binding = 1) writeonly buffer D {int       data_d[];};   // [k, ...]
layout (binding = 2) readonly buffer CB {int       cell_blk[];}; // QSA: cell->block map [n_kv, n_stream]
layout (binding = 3) readonly buffer M  {float16_t mask[];};     // QSA: raw f16 kq_mask [n_kv, n_tps, n_stream]
layout (binding = 4) buffer S           {float     scratch[];};  // QSA: [nrows, n_kv] gathered inputs

layout (push_constant) uniform parameter {
    uint ncols;
    uint k;
    uint nrows;
    uint n_tps;    // QSA only
    uint n_blocks; // QSA only
    uint n_stream; // QSA only
} p;

#define RADIX_BITS 8
#define RADIX_SIZE (1 << RADIX_BITS)

shared uint histo[RADIX_SIZE];
shared uint sh_bucket;
shared uint sh_above;
shared uint sg_cnt[64];  // per-subgroup hit counts for the slot scan

// Histogram add with subgroup aggregation. The early radix passes see only a handful of distinct
// buckets per subgroup (the high bits of similar scores; QSA rows also repeat each block score over
// its cells), so plain per-lane LDS atomics pile onto one or two addresses and serialise. Each round
// the lowest pending lane's bucket is counted with one ballot and added once; after HISTO_PEEL
// rounds the remaining lanes add individually. The totals are identical, so the output is too.
#ifndef HISTO_PEEL
#define HISTO_PEEL 4
#endif
void histo_add(bool want, uint bucket) {
    bool pending = want;
    [[unroll]] for (int it = 0; it < HISTO_PEEL; ++it) {
        const uvec4 bp = subgroupBallot(pending);
        if (bp == uvec4(0)) {
            return;
        }
        const uint leader = subgroupBallotFindLSB(bp);
        const uint lead_bucket = subgroupShuffle(bucket, leader);
        const bool match = pending && bucket == lead_bucket;
        const uint cnt = subgroupBallotBitCount(subgroupBallot(match));
        if (gl_SubgroupInvocationID == leader) {
            atomicAdd(histo[lead_bucket], cnt);
        }
        pending = pending && !match;
    }
    if (pending) {
        atomicAdd(histo[bucket], 1u);
    }
}

// Top-down scan for the bucket holding the desired-th largest candidate, by subgroup 0: each lane
// owns a run of buckets (highest first), an exclusive add gives each lane the count above its run,
// and the highest lane whose run crosses the target reports. Same bucket and count above as the
// serial one-thread walk it replaces (which cost 4 x 256 dependent LDS reads per row).
void select_bucket(const uint desired) {
    if (gl_SubgroupID == 0) {
        const uint lane = gl_SubgroupInvocationID;
        const uint per  = (RADIX_SIZE + gl_SubgroupSize - 1) / gl_SubgroupSize;
        uint s = 0;
        for (uint k = 0; k < per; ++k) {
            const int bb = int(RADIX_SIZE - 1) - int(lane * per + k);
            if (bb >= 0) {
                s += histo[bb];
            }
        }
        const uint total = subgroupAdd(s);
        uint acc   = subgroupExclusiveAdd(s);
        bool found = false;
        uint b     = 0;
        uint above = 0;
        for (uint k = 0; k < per; ++k) {
            const int bb = int(RADIX_SIZE - 1) - int(lane * per + k);
            if (bb >= 0 && !found) {
                const uint c = histo[bb];
                if (acc + c >= desired) {
                    found = true;
                    b     = uint(bb);
                    above = acc;
                } else {
                    acc += c;
                }
            }
        }
        const uvec4 bf = subgroupBallot(found);
        if (bf == uvec4(0)) {
            if (lane == 0) {
                sh_bucket = 0;
                sh_above  = total;
            }
        } else if (lane == subgroupBallotFindLSB(bf)) {
            sh_bucket = b;
            sh_above  = above;
        }
    }
}

// order-preserving float -> uint mapping
uint f2ui(float x) {
    uint y = floatBitsToUint(x);
    if ((y & 0x80000000u) != 0u) {
        y ^= 0xFFFFFFFFu;
    } else {
        y |= 0x80000000u;
    }
    return y;
}

// QSA element i of row (t,s): score[cell_blk[i,s], t, s] + mask[i,t,s]
float gather(uint row, uint i) {
    const uint t = row % p.n_tps;
    const uint s = row / p.n_tps;
    const uint block = uint(cell_blk[s * p.ncols + i]);
    const float a = data_a[(s * p.n_blocks + block) * p.n_tps + t];
    const float m = float(mask[(s * p.n_tps + t) * p.ncols + i]);
    return a + m;
}

float load(uint row, uint i, bool first) {
    if (QSA == 0) {
        return data_a[row * p.ncols + i];
    }
    // materialize the scattered gather on the first pass and reuse it after; each
    // invocation only touches its own scratch entries, so no barrier is needed
    const uint off = row * p.ncols + i;
    if (first) {
        const float v = gather(row, i);
        scratch[off] = v;
        return v;
    }
    return scratch[off];
}

// one workgroup per row: radix-select the K-th largest, then compact it plus enough ties
void topk(const uint row) {
    const uint tid = gl_LocalInvocationID.x;
    const uint ncols = p.ncols;
    const uint row_out = row * p.k;

    uint prefix  = 0;     // fixed high bits of the threshold key
    uint desired = p.k;   // count still needed from the candidate range

    [[unroll]] for (int shift = 32 - RADIX_BITS; shift >= 0; shift -= RADIX_BITS) {
        for (uint i = tid; i < RADIX_SIZE; i += BLOCK_SIZE) {
            histo[i] = 0;
        }
        barrier();

        const bool first     = (shift == 32 - RADIX_BITS);
        const uint hi_mask   = (shift + RADIX_BITS >= 32) ? 0u : (0xFFFFFFFFu << uint(shift + RADIX_BITS));
        const uint prefix_hi = prefix & hi_mask;
        for (uint c = 0; c < ncols; c += BLOCK_SIZE) {
            const uint i   = c + tid;
            const uint key = i < ncols ? f2ui(load(row, i, first)) : 0u;
            histo_add(i < ncols && (key & hi_mask) == prefix_hi, (key >> uint(shift)) & (RADIX_SIZE - 1));
        }
        barrier();

        // top-down scan for the bucket holding the K-th value
        select_bucket(desired);
        barrier();

        prefix  |= sh_bucket << uint(shift);
        desired -= sh_above;
        barrier();
    }


    // Emit everything above the threshold, then fill the rest from ties. Slots come from
    // an exclusive scan over the candidate flags, one BLOCK_SIZE chunk at a time in ascending
    // index order, so the output is identical on every run. The previous atomicAdd slot
    // counter made the ORDER scheduling-dependent, and at the tie boundary the SET as well:
    // the QSA width is top_k + ratio - 1, so the boundary block's ratio tied cells race for
    // ratio - 1 slots and a different cell lost each run (non-repeatable output at depth).
    // With the scan the lowest-indexed tied cells win.
    const uint threshold = prefix;
    uint base = 0;
    [[dont_unroll]] for (uint pass = 0; pass < 2; ++pass) {
        for (uint c = 0; c < ncols; c += BLOCK_SIZE) {
            const uint i   = c + tid;
            bool hit = false;
            if (i < ncols) {
                const uint key = f2ui(load(row, i, false));
                hit = (pass == 0) ? (key > threshold) : (key == threshold);
            }
            const uvec4 ballot  = subgroupBallot(hit);
            const uint  rank_sg = subgroupBallotExclusiveBitCount(ballot);
            const uint  cnt_sg  = subgroupBallotBitCount(ballot);
            if (subgroupElect()) {
                sg_cnt[gl_SubgroupID] = cnt_sg;
            }
            barrier();
            uint sg_base = 0;
            uint total   = 0;
            for (uint sg = 0; sg < gl_NumSubgroups; ++sg) {
                const uint v = sg_cnt[sg];
                sg_base += (sg < gl_SubgroupID) ? v : 0;
                total   += v;
            }
            const uint slot = base + sg_base + rank_sg;
            if (hit && slot < p.k) {
                data_d[row_out + slot] = int(i);
            }
            base += total;
            barrier();
        }
    }
}

#ifdef NPT
// Register-resident QSA variant: the row (ncols <= NPT * BLOCK_SIZE) is gathered once into
// NPT keys per invocation, element j * BLOCK_SIZE + tid in slot j, and every later pass reads
// registers. The scratch variant above streams the whole row back from memory on each of its
// 3 later radix passes and 2 emission passes: 6 x 139 KB per row at 34.8k cells, 1.7 GB per
// layer per 2048-token ubatch, which made TOPK_QSA a DRAM-bound ~125 ms per ubatch at d32768.
// Threshold, emission order and the tie rule (lowest-indexed tied cells win) are unchanged:
// the output is bit-identical to topk() for the same input.
shared uint sh_cnt_gt[NPT * 64];
shared uint sh_cnt_eq[NPT * 64];
shared uint sh_chunk_gt[NPT];
shared uint sh_chunk_eq[NPT];

void topk_reg(const uint row) {
    const uint tid   = gl_LocalInvocationID.x;
    const uint ncols = p.ncols;
    const uint row_out = row * p.k;

    uint keys[NPT];
    [[unroll]] for (uint j = 0; j < NPT; ++j) {
        const uint i = j * BLOCK_SIZE + tid;
        keys[j] = i < ncols ? f2ui(gather(row, i)) : 0u;
    }

    uint prefix  = 0;
    uint desired = p.k;

    [[unroll]] for (int shift = 32 - RADIX_BITS; shift >= 0; shift -= RADIX_BITS) {
        for (uint i = tid; i < RADIX_SIZE; i += BLOCK_SIZE) {
            histo[i] = 0;
        }
        barrier();

        const uint hi_mask   = (shift + RADIX_BITS >= 32) ? 0u : (0xFFFFFFFFu << uint(shift + RADIX_BITS));
        const uint prefix_hi = prefix & hi_mask;
        [[unroll]] for (uint j = 0; j < NPT; ++j) {
            // uniform: slots past the row end hold nothing (a 34.8k row fills 34 of reg64's 64)
            if (j * BLOCK_SIZE < ncols) {
                const uint i = j * BLOCK_SIZE + tid;
                histo_add(i < ncols && (keys[j] & hi_mask) == prefix_hi, (keys[j] >> uint(shift)) & (RADIX_SIZE - 1));
            }
        }
        barrier();

        select_bucket(desired);
        barrier();

        prefix  |= sh_bucket << uint(shift);
        desired -= sh_above;
        barrier();
    }

    // Emission: the scratch variant walks the row one BLOCK_SIZE chunk at a time, above-threshold
    // cells first, then ties, each in ascending index order. Here all per-(chunk, subgroup) hit
    // counts are published at once and scanned, so 3 barriers replace 4 per chunk.
    const uint threshold = prefix;
    const uint sg  = gl_SubgroupID;
    const uint nsg = gl_NumSubgroups;
    [[unroll]] for (uint j = 0; j < NPT; ++j) {
        const uint i = j * BLOCK_SIZE + tid;
        const uvec4 bgt = subgroupBallot(i < ncols && keys[j] >  threshold);
        const uvec4 beq = subgroupBallot(i < ncols && keys[j] == threshold);
        if (subgroupElect()) {
            sh_cnt_gt[j * nsg + sg] = subgroupBallotBitCount(bgt);
            sh_cnt_eq[j * nsg + sg] = subgroupBallotBitCount(beq);
        }
    }
    barrier();
    // per chunk: counts -> exclusive prefix over the subgroups, chunk totals aside
    if (tid < NPT) {
        uint tg = 0, te = 0;
        for (uint s = 0; s < nsg; ++s) {
            const uint cg = sh_cnt_gt[tid * nsg + s];
            const uint ce = sh_cnt_eq[tid * nsg + s];
            sh_cnt_gt[tid * nsg + s] = tg;
            sh_cnt_eq[tid * nsg + s] = te;
            tg += cg;
            te += ce;
        }
        sh_chunk_gt[tid] = tg;
        sh_chunk_eq[tid] = te;
    }
    barrier();
    // chunk totals -> exclusive prefix; the ties start after every above-threshold cell
    if (tid == 0) {
        uint ag = 0, ae = 0;
        for (uint j = 0; j < NPT; ++j) {
            const uint tg = sh_chunk_gt[j];
            const uint te = sh_chunk_eq[j];
            sh_chunk_gt[j] = ag;
            sh_chunk_eq[j] = ae;
            ag += tg;
            ae += te;
        }
        sh_above = ag;
    }
    barrier();
    const uint n_gt = sh_above;
    [[unroll]] for (uint j = 0; j < NPT; ++j) {
        if (j * BLOCK_SIZE >= ncols) {
            break;
        }
        const uint i  = j * BLOCK_SIZE + tid;
        const bool gt = i < ncols && keys[j] >  threshold;
        const bool eq = i < ncols && keys[j] == threshold;
        const uint rgt = subgroupBallotExclusiveBitCount(subgroupBallot(gt));
        const uint req = subgroupBallotExclusiveBitCount(subgroupBallot(eq));
        const uint slot = gt ? sh_chunk_gt[j] + sh_cnt_gt[j * nsg + sg] + rgt
                             : n_gt + sh_chunk_eq[j] + sh_cnt_eq[j * nsg + sg] + req;
        if ((gt || eq) && slot < p.k) {
            data_d[row_out + slot] = int(i);
        }
    }
    barrier();
}
#endif

void main() {
    for (uint row = gl_WorkGroupID.y; row < p.nrows; row += gl_NumWorkGroups.y) {
#ifdef NPT
        topk_reg(row);
#else
        topk(row);
#endif
    }
}
