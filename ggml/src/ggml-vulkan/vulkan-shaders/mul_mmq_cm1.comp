#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_shader_subgroup_shuffle : enable

#if defined(MUL_MAT_ID_USE_SUBGROUPS)
#extension GL_KHR_shader_subgroup_ballot : enable
#endif

#ifdef MUL_MAT_ID
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#endif

#ifdef D16
#extension GL_KHR_shader_subgroup_shuffle : enable
#endif

#include "types.glsl"

#if defined(DATA_A_Q3_K) || defined(DATA_A_Q6_K) || defined(DATA_A_NVFP4)
#define KSCALES 2
#else
#define KSCALES 1
#endif

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {A_TYPE data_a[];};
#if defined(A_TYPE_PACKED16)
layout (binding = 0) readonly buffer A_PACKED16 {A_TYPE_PACKED16 data_a_packed16[];};
#endif
#if defined(A_TYPE_PACKED32)
layout (binding = 0) readonly buffer A_PACKED32 {A_TYPE_PACKED32 data_a_packed32[];};
#endif
layout (binding = 1) readonly buffer B {block_q8_1_x4_packed128 data_b[];};
layout (binding = 2) writeonly buffer D {D_TYPE data_d[];};
#ifdef D16
// f16 output: pairs of adjacent rows go out as one 32-bit store
layout (binding = 2) writeonly buffer D2 {f16vec2 data_d2[];};
#endif

#ifndef D16
// f32 output: four adjacent rows of a column go out as one 128-bit store
layout (binding = 2) writeonly buffer D4 {vec4 data_d4[];};
#endif
#ifdef HC_EPI
// HC_UP_MIX (wave 5): the qwen4exp hc up GEMM with the gated hc pre in its epilogue. The f16 hc norm output x [n_embd, 4, N]
// is read here; D (binding 2) is the f32 mixed stream [n_embd, N]; the gate [4*n_embd, N] is never written.
layout (binding = 3) readonly buffer X {float16_t data_x[];};
#endif

#ifdef MUL_MAT_ID
layout (binding = 3) readonly buffer IDS {int data_ids[];};
layout (binding = 4) readonly buffer RowMap {uint data_row_map[];};
// MUL_MAT_ID + MUL(router weights) epilogue: one f32 weight per (expert slot, token), [1, nei0, nei1] contiguous
layout (binding = 5) readonly buffer FusedScale {float data_fscale[];};
#ifdef GLU_UP
// MUL_MAT_ID+CPY(f16)+SWIGLU: the store writes silu(gate) * up, with the other projection (f16, laid out like D) read
// here; MMID_GLU_ACC_GATE set: this GEMM is the gate projection, clear: it is the up projection
layout (binding = 6) readonly buffer UP {float16_t data_up[];};
layout (binding = 6) readonly buffer UP2 {f16vec2 data_up2[];};
#endif
#endif

layout (push_constant) uniform parameter
{
    uint M;
    uint N;
    uint K;
    uint stride_a;
    uint stride_b;
    uint stride_d;

    uint batch_stride_a;
    uint batch_stride_b;
    uint batch_stride_d;

#ifdef MUL_MAT_ID
    uint nei0;
    uint nei1;
    uint nbi1;
    uint ne11;
    uint n_experts;
    uint row_ids_offset;
    uint fusion_flags; // != 0: scale each output row by data_fscale (MUL_MAT_ID + MUL epilogue)
#else
    uint base_work_group_z;
    uint num_batches;
    uint k_split;
    uint ne02;
    uint ne12;
    uint broadcast2;
    uint broadcast3;
#ifdef HC_EPI
    uint padded_n_unused;   // vk_mat_mat_push_constants.padded_N
    uint hc_n_embd;         // n_embd; M = 4 * n_embd
    uint hc_x_offset;       // element offset of x (f16 [n_embd, 4, N]) in binding 3
    uint hc_x_s1;           // x element stride between streams
    uint hc_x_s2;           // x element stride between tokens
    uint hc_d_offset;       // element offset of the mixed output (f32 [n_embd, N]) in binding 2
    uint hc_d_s1;           // mixed element stride between tokens
    float hc_scale;
    uint hc_zero;           // always 0, opaque to the compiler: keeps the gate's f16 rounding (see the epilogue)
    uint hc_round;          // 1: the unfused gate is f16 (LLAMA_HC_GATE_F16), round it; 0: the f32 gate = the accumulator
#endif
#endif
} p;

layout (constant_id = 0) const uint BLOCK_SIZE = 256;
layout (constant_id = 1) const uint BM = 128;
layout (constant_id = 2) const uint BN = 128;
// layout (constant_id = 3) const uint BK = 32;
layout (constant_id = 4) const uint WM = 64;
layout (constant_id = 5) const uint WN = 32;
layout (constant_id = 7) const uint TM = 16;
layout (constant_id = 8) const uint TN = 16;
layout (constant_id = 9) const uint TK = 16;
layout (constant_id = 10) const uint WARP = 32;
layout (constant_id = 11) const uint DEVICE_ARCH = 0; // vk_device_architecture (ggml-vulkan.cpp)
#define VK_ARCH_AMD_RDNA4 5u
layout (constant_id = 12) const uint PACKSTORE = 1; // 0: per-element f32 stores (GGML_VK_MMQ_PACKSTORE=0)

#define BK 32
#ifdef MUL_MAT_ID
#define BK_STEP 2
#else
#define BK_STEP 4
#endif
#define GROUP_A_BUDGET (16u * 1024u * 1024u)

const uint QPITCH = BK_STEP * (BK / 4) + 4;

shared uint32_t buf_a_qs[BM * QPITCH];
#if defined(DATA_A_Q4_1) || defined(DATA_A_Q5_1) || defined(DATA_A_Q4_K) || defined(DATA_A_Q5_K)
shared vec2 buf_a_dm[BM * BK_STEP];   // .x = d, .y = m
#else
shared float buf_a_d[BM * BK_STEP * KSCALES];
#endif

shared uint32_t buf_b_qs[BN * QPITCH];
shared float buf_b_d[BN * BK_STEP];

#if defined(DATA_A_Q4_1) || defined(DATA_A_Q5_1) || defined(DATA_A_Q4_K) || defined(DATA_A_Q5_K)
shared float buf_b_s[BN * BK_STEP];
#endif

#if defined(DATA_A_IQ4_NL) || defined(DATA_A_IQ4_XS) || defined(DATA_A_MXFP4) || defined(DATA_A_NVFP4)
shared int8_t cm1_kvalues[16];
#endif

#if defined(DATA_A_QUANT_K) || defined(DATA_A_IQ4_XS) || defined(DATA_A_NVFP4)
#define LOAD_VEC_A 8
#else
#define LOAD_VEC_A (4 * QUANT_R)
#endif
#define LOAD_VEC_B 16

const uint CM_ELEMS = (TM * TN) / WARP;
#define ACC_BIAS_BITS 0x4B400000
#define ACC_BIAS_F    12582912.0f
const bool USE_MAGIC_BIAS = WARP != 32;

// RDNA3/3.5 wave32 accumulator: lane l holds column l % 16, rows (l / 16) + 2e. Two shuffles with the lane 16
// away give each lane four adjacent rows of its column: for element group e..e+3 the low half stores rows
// 2e..2e+3 and the high half rows 2e+4..2e+7, so every lane writes one vec4 per four elements instead of four
// scattered dwords. All lanes must reach the shuffles, so the caller only branches on uniform values.
#ifndef D16
const uint PACK_F32 = PACKSTORE * uint(DEVICE_ARCH != VK_ARCH_AMD_RDNA4) * uint(WARP == 32) * uint(TM == 16) * uint(TN == 16);

void store_f32x4(const uint idx, const uint row_g, const vec4 v) {
    if (row_g + 3 < p.M) {
        data_d4[idx / 4] = v;
    } else {
        // ragged tail: never write past the row end
        if (row_g     < p.M) { data_d[idx]     = v.x; }
        if (row_g + 1 < p.M) { data_d[idx + 1] = v.y; }
        if (row_g + 2 < p.M) { data_d[idx + 2] = v.z; }
    }
}
#endif

// Accumulator row for element e: RDNA4 blocked, RDNA3/3.5 interleaved.
uint cm_elem_row(uint e) {
    const uint row_half = gl_SubgroupInvocationID / TN;
    return (DEVICE_ARCH == VK_ARCH_AMD_RDNA4) ? (e + row_half * CM_ELEMS) : (row_half + 2u * e);
}

// min_term = asymmetric-quant min*b_sum correction (0 for symmetric types).
ACC_TYPE cm1_accumulate(ACC_TYPE prev, int acc_e, float scale_a, float nbias_a, float scale_b, float min_term) {
    if (USE_MAGIC_BIAS) {
        const float t = fma(intBitsToFloat(acc_e), scale_a, nbias_a);
        return ACC_TYPE(fma(t, scale_b, float(prev) + min_term));
    }
    return prev + ACC_TYPE(fma(float(acc_e) * scale_a, scale_b, min_term));
}

#ifdef MUL_MAT_ID
#define MMID_GLU_ACC_GATE  8u   // fusion_flags bit 3: the SwiGLU epilogue's GEMM is the gate projection
#include "mul_mm_id_funcs.glsl"
#endif

#if defined(MUL_MAT_ID) && defined(D16)
// f16 stores that must equal the unfused chain (f32 store, then CPY / the f16 SWIGLU): written plainly, the compiler may fold
// the last f32 multiply and the f16 conversion into one single-rounding mixed-precision op (~6 in 1e5 values one ulp off),
// and it drops a bare float(float16_t(x)) round trip. The values go through an XOR with a push-constant zero: bit 2 of
// fusion_flags is never set (ggml_vk_matmul_id sets bits 0 and 3).
uint mmid_zero() { return p.fusion_flags & 4u; }
float16_t mmid_store16(const float x) { return float16_t(uintBitsToFloat(floatBitsToUint(x) ^ mmid_zero())); }
f16vec2 mmid_store16x2(const vec2 x) { return f16vec2(uintBitsToFloat(floatBitsToUint(x) ^ uvec2(mmid_zero()))); }
#ifdef GLU_UP
// the unfused chain stores this projection as f16 (MUL_MAT_ID_CPY16) and the SWIGLU reads it back: round it the same way
vec2 mmid_round16x2(const vec2 x) { return vec2(unpackFloat2x16(packFloat2x16(f16vec2(x)) ^ mmid_zero())); }
float mmid_round16(const float x) { return mmid_round16x2(vec2(x, 0.0f)).x; }
// the SWIGLU op's expression (swiglu.comp)
float glu_silu_mul(const float g, const float u) { return g / (1.0f + exp(-g)) * u; }
#endif
#endif
#if defined(HC_EPI) && defined(D16)
// wave 6 f16 mixed stream: equal to the f32 mixed stream stored, then converted (as dsv4_hc_pre.comp D_F16); hc_zero is 0
float16_t hc_store16(const float x) { return float16_t(uintBitsToFloat(floatBitsToUint(x) ^ p.hc_zero)); }
#endif

#ifdef HC_EPI
// logical row L (i*4 + c) -> weight row c*n_embd + i; rows past M read row 0 (their results are never stored)
uint hc_a_row_ib(const uint L) {
    const uint phys = (L < p.M) ? ((L & 3u) * p.hc_n_embd + (L >> 2u)) : 0u;
    return phys * (p.stride_a / BK);
}
#define A_ROW_IB(r) hc_a_row_ib(ir * BM + (r))
#endif
#include "mul_mmq_cm1_funcs.glsl"

void main() {
#ifdef MUL_MAT_ID
    const uint tile_idx = gl_WorkGroupID.y + gl_WorkGroupID.z * gl_NumWorkGroups.y;
    if (tile_idx >= data_row_map[0]) {
        return;
    }
    const uint expert_idx = data_row_map[1 + 2 * tile_idx];
    const uint row_begin = tile_idx * BN;
    _ne1 = data_row_map[2 + 2 * tile_idx];
    const uint ic = 0;
#endif
#if defined(DATA_A_IQ4_NL) || defined(DATA_A_IQ4_XS)
    if (gl_LocalInvocationIndex < 16u) {
        cm1_kvalues[gl_LocalInvocationIndex] = kvalues_iq4nl_const[gl_LocalInvocationIndex];
    }
    barrier();
#elif defined(DATA_A_MXFP4)
    if (gl_LocalInvocationIndex < 16u) {
        cm1_kvalues[gl_LocalInvocationIndex] = kvalues_mxfp4_const[gl_LocalInvocationIndex];
    }
    barrier();
#elif defined(DATA_A_NVFP4)
    if (gl_LocalInvocationIndex < 16u) {
        cm1_kvalues[gl_LocalInvocationIndex] = kvalues_mxfp4_const[gl_LocalInvocationIndex];
    }
#if !defined(USE_OCP_FP4)
    for (uint i = gl_LocalInvocationIndex; i < 128u; i += BLOCK_SIZE) {
        ue4m3_fp32_lut[i] = ue4m3_to_fp32_build(i);
    }
#endif
    barrier();
#endif

    const uint blocks_m = (p.M + BM - 1) / BM;
    const uint ik = gl_WorkGroupID.x / blocks_m;

#ifdef MUL_MAT_ID
    const uint ir = gl_WorkGroupID.x % blocks_m;
#else
    // L2-friendly workgroup scheduling
    const uint blocks_n = (p.N + BN - 1) / BN;
#if defined(DATA_A_IQ4_XS)
    const uint a_panel_bytes = (BM * p.K) / 2 + (BM * p.K) / 32;
#else
    const uint a_panel_bytes = BM * p.K + (BM * p.K) / 16;
#endif
    const uint group_m = clamp(GROUP_A_BUDGET / max(a_panel_bytes, 1u), 1u, min(blocks_m, 32u));
    const uint tiles_per_group = group_m * blocks_n;
    const uint lin = gl_WorkGroupID.y * blocks_m + (gl_WorkGroupID.x % blocks_m);
    const uint group_id = lin / tiles_per_group;
    const uint first_m = group_id * group_m;
    const uint gsize = min(blocks_m - first_m, group_m);
    const uint in_group = lin - group_id * tiles_per_group;
    const uint ir = first_m + in_group % gsize;
    const uint ic = in_group / gsize;
#endif

#ifndef MUL_MAT_ID
    const uint batch_idx = gl_WorkGroupID.z + p.base_work_group_z;

    const uint i13 = batch_idx / p.ne12;
    const uint i12 = batch_idx % p.ne12;

    const uint i03 = i13 / p.broadcast3;
    const uint i02 = i12 / p.broadcast2;

    const uint batch_idx_a = i03 * p.ne02 + i02;
#endif

    const uint warp_i = gl_SubgroupID;

    const uint cms_per_row = WM / TM;
    const uint cms_per_col = WN / TN;

    const uint warp_r = warp_i % (BM / WM);
    const uint warp_c = warp_i / (BM / WM);

    const uint elem_col0 = gl_SubgroupInvocationID % TN;

    const uint loadr_a = gl_LocalInvocationID.x % (BK / LOAD_VEC_A);
    const uint loadc_a = gl_LocalInvocationID.x / (BK / LOAD_VEC_A);
    const uint loadr_b = gl_LocalInvocationID.x % (BK / LOAD_VEC_B);
    const uint loadc_b = gl_LocalInvocationID.x / (BK / LOAD_VEC_B);

    const uint loadstride_a = BLOCK_SIZE * LOAD_VEC_A / BK;
    const uint loadstride_b = BLOCK_SIZE * LOAD_VEC_B / BK;

#ifdef MUL_MAT_ID
    load_row_ids(row_begin);
#endif

#ifdef MUL_MAT_ID
    const uint start_k = 0;
    const uint end_k = p.K;
#else
    const uint start_k = ik * p.k_split;
    const uint end_k = min(p.K, (ik + 1) * p.k_split);
#endif

    uint pos_a_ib =
#ifdef MUL_MAT_ID
        expert_idx * (p.batch_stride_a / BK) +
#else
        batch_idx_a * (p.batch_stride_a / BK) +
#endif
#ifdef HC_EPI
        start_k / BK;   // the tile's rows are added per row by A_ROW_IB (interleaved remap)
#else
        (ir * BM * p.stride_a + start_k) / BK;
#endif
#ifdef MUL_MAT_ID
    uint pos_b_ib = 0;
#else
    uint pos_b_ib = (batch_idx * p.batch_stride_b + ic * BN * p.stride_b + start_k) / BK;
#endif

    ACC_TYPE sums[cms_per_row * cms_per_col * CM_ELEMS];
    [[unroll]] for (uint i = 0; i < cms_per_row * cms_per_col * CM_ELEMS; i++) {
        sums[i] = ACC_TYPE(0.0);
    }

    // Double-buffering: prefetch registers
    const uint A_LOADS = (BM + loadstride_a - 1) / loadstride_a;
    const uint B_LOADS = (BN + loadstride_b - 1) / loadstride_b;

    block_a_prefetch pre_a[A_LOADS * BK_STEP];
    block_b_prefetch pre_b[B_LOADS * BK_STEP];

    if (start_k < end_k) {
        PREFETCH_BLOCK(start_k)
    }

    const uint a_row0 = warp_r * WM;
    const uint b_col0 = warp_c * WN;
#ifdef MUL_MAT_ID
    const bool active_col_tile = ic * BN + b_col0 < _ne1;
#else
    const bool active_col_tile = ic * BN + b_col0 < p.N;
#endif

    barrier();

    for (uint block = start_k; block < end_k; block += BK * BK_STEP) {
        STORE_BLOCK_TO_LDS(block)

        barrier();

        pos_a_ib += BK_STEP;
        pos_b_ib += BK_STEP;

        const uint next_block = block + BK * BK_STEP;
        if (next_block < end_k) {
            PREFETCH_BLOCK(next_block)
        }

        if (active_col_tile) {
        [[unroll]] for (uint ks = 0; ks < BK_STEP; ks++) {
            const uint K_SUB = BK / TK;

#if KSCALES == 2
            [[unroll]] for (uint h = 0; h < K_SUB; h++) {
                [[unroll]] for (uint r = 0; r < cms_per_row; r++) {
                    coopmat<int8_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> cache_a;
                    coopMatLoad(cache_a, buf_a_qs, (a_row0 + r * TM) * QPITCH + ks * (BK / 4) + h * (TK / 4), QPITCH, gl_CooperativeMatrixLayoutRowMajor);

                    float scale_a[CM_ELEMS];
                    float nbias_a[CM_ELEMS];
                    [[unroll]] for (uint e = 0; e < CM_ELEMS; e++) {
                        scale_a[e] = buf_a_d[(ks * KSCALES + h) * BM + a_row0 + r * TM + cm_elem_row(e)];
                        if (USE_MAGIC_BIAS) {
                            nbias_a[e] = -ACC_BIAS_F * scale_a[e];
                        }
                    }

                    [[unroll]] for (uint c = 0; c < cms_per_col; c++) {
                        coopmat<int8_t, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> cache_b;
                        coopMatLoad(cache_b, buf_b_qs, (b_col0 + c * TN) * QPITCH + ks * (BK / 4) + h * (TK / 4), QPITCH, gl_CooperativeMatrixLayoutColumnMajor);

                        const float scale_b_v = buf_b_d[ks * BN + b_col0 + c * TN + elem_col0];

                        coopmat<int32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> acc =
                            coopmat<int32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(
                                USE_MAGIC_BIAS ? ACC_BIAS_BITS : 0);
                        acc = coopMatMulAdd(cache_a, cache_b, acc);

                        const uint tile_idx = r * cms_per_col + c;
                        [[unroll]] for (uint e = 0; e < CM_ELEMS; e++) {
                            sums[tile_idx * CM_ELEMS + e] = cm1_accumulate(
                                sums[tile_idx * CM_ELEMS + e], int(acc[e]),
                                scale_a[e], nbias_a[e], scale_b_v, 0.0);
                        }
                    }
                }
            }
#elif defined(DATA_A_Q4_1) || defined(DATA_A_Q5_1) || defined(DATA_A_Q4_K) || defined(DATA_A_Q5_K)
            // Preload all A/B fragments up front (ILP).
            coopmat<int8_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> cache_a[cms_per_row * K_SUB];
            coopmat<int8_t, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> cache_b[cms_per_col * K_SUB];

            [[unroll]] for (uint r = 0; r < cms_per_row; r++) {
                [[unroll]] for (uint h = 0; h < K_SUB; h++) {
                    coopMatLoad(cache_a[r * K_SUB + h], buf_a_qs, (a_row0 + r * TM) * QPITCH + ks * (BK / 4) + h * (TK / 4), QPITCH, gl_CooperativeMatrixLayoutRowMajor);
                }
            }
            [[unroll]] for (uint c = 0; c < cms_per_col; c++) {
                [[unroll]] for (uint h = 0; h < K_SUB; h++) {
                    coopMatLoad(cache_b[c * K_SUB + h], buf_b_qs, (b_col0 + c * TN) * QPITCH + ks * (BK / 4) + h * (TK / 4), QPITCH, gl_CooperativeMatrixLayoutColumnMajor);
                }
            }

            float scale_b[cms_per_col];
            float bs[cms_per_col];
            [[unroll]] for (uint c = 0; c < cms_per_col; c++) {
                scale_b[c] = buf_b_d[ks * BN + b_col0 + c * TN + elem_col0];
                bs[c] = float(buf_b_s[ks * BN + b_col0 + c * TN + elem_col0]);
            }

            [[unroll]] for (uint r = 0; r < cms_per_row; r++) {
                float scale_a[CM_ELEMS];
                float nbias_a[CM_ELEMS];
                float ma[CM_ELEMS];
                [[unroll]] for (uint e = 0; e < CM_ELEMS; e++) {
                    vec2 dm = buf_a_dm[ks * BM + a_row0 + r * TM + cm_elem_row(e)];
                    scale_a[e] = dm.x;
                    if (USE_MAGIC_BIAS) {
                        nbias_a[e] = -ACC_BIAS_F * scale_a[e];
                    }
                    ma[e] = dm.y;
                }

                [[unroll]] for (uint c = 0; c < cms_per_col; c++) {
                    coopmat<int32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> acc =
                        coopmat<int32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(
                            USE_MAGIC_BIAS ? ACC_BIAS_BITS : 0);

                    [[unroll]] for (uint h = 0; h < K_SUB; h++) {
                        acc = coopMatMulAdd(cache_a[r * K_SUB + h], cache_b[c * K_SUB + h], acc);
                    }

                    const uint tile_idx = r * cms_per_col + c;
                    [[unroll]] for (uint e = 0; e < CM_ELEMS; e++) {
                        sums[tile_idx * CM_ELEMS + e] = cm1_accumulate(
                            sums[tile_idx * CM_ELEMS + e], int(acc[e]),
                            scale_a[e], nbias_a[e], scale_b[c], ma[e] * bs[c]);
                    }
                }
            }
#else
            // Preload all A/B fragments up front (ILP).
            coopmat<int8_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> cache_a[cms_per_row * K_SUB];
            coopmat<int8_t, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> cache_b[cms_per_col * K_SUB];

            [[unroll]] for (uint r = 0; r < cms_per_row; r++) {
                [[unroll]] for (uint h = 0; h < K_SUB; h++) {
                    coopMatLoad(cache_a[r * K_SUB + h], buf_a_qs, (a_row0 + r * TM) * QPITCH + ks * (BK / 4) + h * (TK / 4), QPITCH, gl_CooperativeMatrixLayoutRowMajor);
                }
            }
            [[unroll]] for (uint c = 0; c < cms_per_col; c++) {
                [[unroll]] for (uint h = 0; h < K_SUB; h++) {
                    coopMatLoad(cache_b[c * K_SUB + h], buf_b_qs, (b_col0 + c * TN) * QPITCH + ks * (BK / 4) + h * (TK / 4), QPITCH, gl_CooperativeMatrixLayoutColumnMajor);
                }
            }

            float scale_b[cms_per_col];
            [[unroll]] for (uint c = 0; c < cms_per_col; c++) {
                scale_b[c] = buf_b_d[ks * BN + b_col0 + c * TN + elem_col0];
            }

            [[unroll]] for (uint r = 0; r < cms_per_row; r++) {
                float scale_a[CM_ELEMS];
                float nbias_a[CM_ELEMS];
                [[unroll]] for (uint e = 0; e < CM_ELEMS; e++) {
                    scale_a[e] = buf_a_d[ks * BM + a_row0 + r * TM + cm_elem_row(e)];
                    if (USE_MAGIC_BIAS) {
                        nbias_a[e] = -ACC_BIAS_F * scale_a[e];
                    }
                }

                [[unroll]] for (uint c = 0; c < cms_per_col; c++) {
                    coopmat<int32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> acc =
                        coopmat<int32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(
                            USE_MAGIC_BIAS ? ACC_BIAS_BITS : 0);

                    [[unroll]] for (uint h = 0; h < K_SUB; h++) {
                        acc = coopMatMulAdd(cache_a[r * K_SUB + h], cache_b[c * K_SUB + h], acc);
                    }

                    const uint tile_idx = r * cms_per_col + c;
                    [[unroll]] for (uint e = 0; e < CM_ELEMS; e++) {
                        sums[tile_idx * CM_ELEMS + e] = cm1_accumulate(
                            sums[tile_idx * CM_ELEMS + e], int(acc[e]),
                            scale_a[e], nbias_a[e], scale_b[c], 0.0);
                    }
                }
            }
#endif // KSCALES
        }
        }

        barrier();
    }

#undef PREFETCH_BLOCK
#undef STORE_BLOCK_TO_LDS
#undef B_IB_CALC

    const uint dr = ir * BM + a_row0;
    const uint dc = ic * BN + b_col0;

#ifdef MUL_MAT_ID
    const bool scale_rows = (p.fusion_flags & 1u) != 0;
#ifndef D16
    if (PACK_F32 != 0) {
        if ((p.stride_d % 4) == 0 && (p.batch_stride_d % 4) == 0) {
            const bool lo_half = gl_SubgroupInvocationID < 16;
            [[unroll]] for (uint r = 0; r < cms_per_row; r++) {
                [[unroll]] for (uint c = 0; c < cms_per_col; c++) {
                    const uint tile_idx = r * cms_per_col + c;
                    const uint col_i = dc + c * TN + elem_col0;
                    [[unroll]] for (uint e = 0; e < CM_ELEMS; e += 4) {
                        const float a0 = float(sums[tile_idx * CM_ELEMS + e]);
                        const float a1 = float(sums[tile_idx * CM_ELEMS + e + 1]);
                        const float a2 = float(sums[tile_idx * CM_ELEMS + e + 2]);
                        const float a3 = float(sums[tile_idx * CM_ELEMS + e + 3]);
                        const float r0 = subgroupShuffleXor(lo_half ? a2 : a0, 16);
                        const float r1 = subgroupShuffleXor(lo_half ? a3 : a1, 16);
                        const vec4 v = lo_half ? vec4(a0, r0, a1, r1) : vec4(r0, a2, r1, a3);
                        const uint row_g = dr + r * TM + 2u * e + (lo_half ? 0u : 4u);
                        if (col_i < _ne1) {
                            const u16vec2 row_idx = row_ids[col_i - ic * BN];
                            const vec4 vs = scale_rows ? v * data_fscale[uint(row_idx.y) * p.nei0 + uint(row_idx.x)] : v;
                            store_f32x4(row_idx.y * p.batch_stride_d + row_idx.x * p.stride_d + row_g, row_g, vs);
                        }
                    }
                }
            }
            return;
        }
    }
#endif
#ifdef D16
    // f16 output (MUL_MAT_ID(+MUL)+CPY(f16)): the RDNA3/3.5 wave32 accumulator pairing of the dense f16 store
    // below, one f16vec2 per two adjacent rows of an (expert slot, token) column, both scaled by its weight
    bool packed_id = false;
    if (DEVICE_ARCH != VK_ARCH_AMD_RDNA4) {
        if (WARP == 32) {
            if (TN == 16) {
                packed_id = (p.stride_d % 2) == 0 && (p.batch_stride_d % 2) == 0;
            }
        }
    }
    if (packed_id) {
        const bool lo_half = gl_SubgroupInvocationID < 16;
        [[unroll]] for (uint r = 0; r < cms_per_row; r++) {
            [[unroll]] for (uint c = 0; c < cms_per_col; c++) {
                const uint tile_idx = r * cms_per_col + c;
                const uint col_i = dc + c * TN + elem_col0;
                [[unroll]] for (uint e = 0; e < CM_ELEMS; e += 2) {
                    const float own0 = float(sums[tile_idx * CM_ELEMS + e]);
                    const float own1 = float(sums[tile_idx * CM_ELEMS + e + 1]);
                    const float recv = subgroupShuffleXor(lo_half ? own1 : own0, 16);
                    const uint row_g = dr + r * TM + 2u * e + (lo_half ? 0u : 2u);
                    const vec2 v = lo_half ? vec2(own0, recv) : vec2(recv, own1);
                    if (col_i < _ne1) {
                        const u16vec2 row_idx = row_ids[col_i - ic * BN];
                        const float w = scale_rows ? data_fscale[uint(row_idx.y) * p.nei0 + uint(row_idx.x)] : 1.0;
                        const uint idx = row_idx.y * p.batch_stride_d + row_idx.x * p.stride_d + row_g;
#ifdef GLU_UP
                        const bool acc_gate = (p.fusion_flags & MMID_GLU_ACC_GATE) != 0;
                        if (row_g + 1 < p.M) {
                            const vec2 o = vec2(data_up2[idx / 2]);
                            const vec2 v16 = mmid_round16x2(v);
                            const vec2 g = acc_gate ? v16 : o;
                            const vec2 u = acc_gate ? o : v16;
                            data_d2[idx / 2] = mmid_store16x2(vec2(glu_silu_mul(g.x, u.x), glu_silu_mul(g.y, u.y)));
                        } else if (row_g < p.M) {
                            const float o = float(data_up[idx]);
                            const float v16 = mmid_round16(v.x);
                            data_d[idx] = mmid_store16(acc_gate ? glu_silu_mul(v16, o) : glu_silu_mul(o, v16));
                        }
#else
                        if (row_g + 1 < p.M) {
                            data_d2[idx / 2] = mmid_store16x2(v * w);
                        } else if (row_g < p.M) {
                            data_d[idx] = mmid_store16(v.x * w);
                        }
#endif
                    }
                }
            }
        }
        return;
    }
#endif
    [[unroll]] for (uint r = 0; r < cms_per_row; r++) {
        [[unroll]] for (uint c = 0; c < cms_per_col; c++) {
            const uint tile_idx = r * cms_per_col + c;
            [[unroll]] for (uint e = 0; e < CM_ELEMS; e++) {
                const uint col_i = dc + c * TN + elem_col0;
                if (col_i >= _ne1) continue;

                const uint row_g = dr + r * TM + cm_elem_row(e);
                if (row_g >= p.M) continue;

                const u16vec2 row_idx = row_ids[col_i - ic * BN];
                const uint store_offset = row_idx.y * p.batch_stride_d + row_idx.x * p.stride_d + row_g;
                float val = float(sums[tile_idx * CM_ELEMS + e]);
                if (scale_rows) {
                    val *= data_fscale[uint(row_idx.y) * p.nei0 + uint(row_idx.x)];
                }
#ifdef GLU_UP
                {
                    const float o = float(data_up[store_offset]);
                    const bool acc_gate = (p.fusion_flags & MMID_GLU_ACC_GATE) != 0;
                    const float v16 = mmid_round16(val);
                    val = acc_gate ? glu_silu_mul(v16, o) : glu_silu_mul(o, v16);
                }
#endif
#ifdef D16
                data_d[store_offset] = mmid_store16(val);
#else
                data_d[store_offset] = D_TYPE(val);
#endif
            }
        }
    }
#else
    const uint offsets = batch_idx * p.batch_stride_d + ik * p.batch_stride_d * p.num_batches;

#ifdef HC_EPI
    // RDNA3/3.5 wave32 (the host creates this variant only there): the 32-bit pack shuffles give each lane rows 4j..4j+3 of
    // its column = the 4 streams of element j. Bit-exact against MUL_MAT+CPY(f16) + DSV4_HC_PRE (gated, f16 x, f16 gate):
    // the gate is rounded to f16 as the d16 store writes it, and the mix is the dsv4_hc_pre.comp expression, in its order.
    {
        const bool lo_half = gl_SubgroupInvocationID < 16;
        [[unroll]] for (uint r = 0; r < cms_per_row; r++) {
            [[unroll]] for (uint c = 0; c < cms_per_col; c++) {
                const uint tile_idx = r * cms_per_col + c;
                const uint col_g = dc + c * TN + elem_col0;
                [[unroll]] for (uint e = 0; e < CM_ELEMS; e += 4) {
                    const float a0 = float(sums[tile_idx * CM_ELEMS + e]);
                    const float a1 = float(sums[tile_idx * CM_ELEMS + e + 1]);
                    const float a2 = float(sums[tile_idx * CM_ELEMS + e + 2]);
                    const float a3 = float(sums[tile_idx * CM_ELEMS + e + 3]);
                    const float r0 = subgroupShuffleXor(lo_half ? a2 : a0, 16);
                    const float r1 = subgroupShuffleXor(lo_half ? a3 : a1, 16);
                    const vec4 v = lo_half ? vec4(a0, r0, a1, r1) : vec4(r0, a2, r1, a3);
                    const uint row_g = dr + r * TM + 2u * e + (lo_half ? 0u : 4u);
                    if (col_g < p.N && row_g + 3 < p.M) {
                        const uint i0 = row_g >> 2u;
                        const uint xb = p.hc_x_offset + i0 + col_g * p.hc_x_s2;
                        float result = 0.0f;
                        [[unroll]]
                        for (uint ih = 0; ih < 4; ++ih) {
                            // RADV/ACO drops a bare float(float16_t(x)) round-trip (tbo-b1d: the fused mix matched the UNROUNDED
                            // gate). The f16 bits pass through an integer op on a push-constant zero, so the v_cvt_f16_f32 the
                            // d16 store uses must run and the gate is the f16 value the unfused chain reads.
                            const uint gbits = packFloat2x16(f16vec2(float16_t(v[ih]), float16_t(0.0))) ^ p.hc_zero;
                            const float g = p.hc_round != 0u ? float(unpackFloat2x16(gbits).x) : v[ih];
                            const float wv = 1.0f / (1.0f + exp(-g));
                            result = fma(float(data_x[xb + ih * p.hc_x_s1]), wv, result);
                        }
#ifdef D16
                        data_d[p.hc_d_offset + i0 + col_g * p.hc_d_s1] = hc_store16(p.hc_scale * result);   // wave 6: the f16 mixed stream
#else
                        data_d[p.hc_d_offset + i0 + col_g * p.hc_d_s1] = D_TYPE(p.hc_scale * result);
#endif
                    }
                }
            }
        }
        return;
    }
#endif

#ifdef D16
    // RDNA3/3.5 wave32 accumulator: lane l holds column l % 16, rows (l / 16) + 2e. One shuffle with the lane
    // 16 away gives each lane two adjacent rows of its column: the low half stores rows 2e, 2e+1 and the high
    // half rows 2e+2, 2e+3, so every lane writes one f16vec2 per element pair instead of two 16-bit values.
    bool packed = false;
    if (DEVICE_ARCH != VK_ARCH_AMD_RDNA4) {
        if (WARP == 32) {
            if (TN == 16) {
                packed = (p.stride_d % 2) == 0 && (offsets % 2) == 0;
            }
        }
    }
    if (packed) {
        const bool lo_half = gl_SubgroupInvocationID < 16;
        [[unroll]] for (uint r = 0; r < cms_per_row; r++) {
            [[unroll]] for (uint c = 0; c < cms_per_col; c++) {
                const uint tile_idx = r * cms_per_col + c;
                const uint col_g = dc + c * TN + elem_col0;
                [[unroll]] for (uint e = 0; e < CM_ELEMS; e += 2) {
                    const float own0 = float(sums[tile_idx * CM_ELEMS + e]);
                    const float own1 = float(sums[tile_idx * CM_ELEMS + e + 1]);
                    const float recv = subgroupShuffleXor(lo_half ? own1 : own0, 16);
                    const uint row_g = dr + r * TM + 2u * e + (lo_half ? 0u : 2u);
                    const vec2 v = lo_half ? vec2(own0, recv) : vec2(recv, own1);
                    if (col_g < p.N) {
                        const uint idx = offsets + col_g * p.stride_d + row_g;
                        if (row_g + 1 < p.M) {
                            data_d2[idx / 2] = f16vec2(v);
                        } else if (row_g < p.M) {
                            data_d[idx] = float16_t(v.x);
                        }
                    }
                }
            }
        }
        return;
    }
#endif

#ifndef D16
    if (PACK_F32 != 0) {
        if ((p.stride_d % 4) == 0 && (offsets % 4) == 0) {
            const bool lo_half = gl_SubgroupInvocationID < 16;
            [[unroll]] for (uint r = 0; r < cms_per_row; r++) {
                [[unroll]] for (uint c = 0; c < cms_per_col; c++) {
                    const uint tile_idx = r * cms_per_col + c;
                    const uint col_g = dc + c * TN + elem_col0;
                    [[unroll]] for (uint e = 0; e < CM_ELEMS; e += 4) {
                        const float a0 = float(sums[tile_idx * CM_ELEMS + e]);
                        const float a1 = float(sums[tile_idx * CM_ELEMS + e + 1]);
                        const float a2 = float(sums[tile_idx * CM_ELEMS + e + 2]);
                        const float a3 = float(sums[tile_idx * CM_ELEMS + e + 3]);
                        const float r0 = subgroupShuffleXor(lo_half ? a2 : a0, 16);
                        const float r1 = subgroupShuffleXor(lo_half ? a3 : a1, 16);
                        const vec4 v = lo_half ? vec4(a0, r0, a1, r1) : vec4(r0, a2, r1, a3);
                        const uint row_g = dr + r * TM + 2u * e + (lo_half ? 0u : 4u);
                        if (col_g < p.N) {
                            store_f32x4(offsets + col_g * p.stride_d + row_g, row_g, v);
                        }
                    }
                }
            }
            return;
        }
    }
#endif

    [[unroll]] for (uint r = 0; r < cms_per_row; r++) {
        [[unroll]] for (uint c = 0; c < cms_per_col; c++) {
            const uint tile_idx = r * cms_per_col + c;
            [[unroll]] for (uint e = 0; e < CM_ELEMS; e++) {
                const uint row_g = dr + r * TM + cm_elem_row(e);
                const uint col_g = dc + c * TN + elem_col0;
                if (row_g < p.M && col_g < p.N) {
                    data_d[offsets + col_g * p.stride_d + row_g] = D_TYPE(sums[tile_idx * CM_ELEMS + e]);
                }
            }
        }
    }
#endif // MUL_MAT_ID
}
