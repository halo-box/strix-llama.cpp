#version 450

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

#define FLOAT_TYPE float
#include "types.glsl"

// Maskless selected-key attention with a quantized (or mixed) K/V cache, few queries: after flash_attn_sel_prep.comp has
// cleaned the rows, copy the cells each row names into a compact f16 buffer, [row * list_stride + slot][K/V head][256],
// dequantizing on the way. With write_list set this dispatch also writes the identity list (entry = its own slot) and
// the row counts, so the f16 attention kernels read the compact rows unchanged. One dispatch per tensor (K, then V).
// Every slot is copied, padding included: the prep pass pads with a live cell.
// Decode only: below N * list_stride < n_kv this reads fewer cells than dequantizing the whole cache once.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#if defined(DATA_A_F16)
layout(binding = 0) readonly buffer ABuf { float16_t data_a[]; };
#else
layout(binding = 0) readonly buffer ABuf { A_TYPE_PACKED16 data_a[]; };
#endif
layout(binding = 1) readonly  buffer ListBuf  { uint  data_list[];  };
layout(binding = 2) writeonly buffer DstBuf   { uvec4 data_dst[];   };
layout(binding = 3) writeonly buffer List2Buf { uint  data_list2[]; };

layout(push_constant) uniform Parameters {
    uint n_rows;      // query rows (all streams)
    uint n_tok;       // query rows per stream
    uint list_stride;
    uint n_head_kv;
    uint nb1;         // cell, head and stream strides of the source: elements (f16) or blocks (quantized)
    uint nb2;
    uint nb3;
    uint write_list;
} p;

const uint D = 256;          // host gate: head size 256
const uint SLOTS = 4;        // slots per workgroup

void main() {
    const uint row = gl_WorkGroupID.y;
    const uint slot0 = gl_WorkGroupID.x * SLOTS;
    const uint stream = row / p.n_tok;
    const uint per_slot = p.n_head_kv * (D / 8);   // 8-element pieces per slot

    for (uint i = gl_LocalInvocationIndex; i < SLOTS * per_slot; i += gl_WorkGroupSize.x) {
        const uint s = slot0 + i / per_slot;
        if (s >= p.list_stride) {
            break;
        }
        const uint g = row * p.list_stride + s;
        const uint cell = data_list[g];
        const uint head = (i % per_slot) / (D / 8);
        const uint d0 = (i % (D / 8)) * 8;

        float16_t v[8];
#if defined(DATA_A_F16)
        const uint a = cell * p.nb1 + head * p.nb2 + stream * p.nb3 + d0;
        [[unroll]] for (uint j = 0; j < 8; ++j) {
            v[j] = data_a[a + j];
        }
#else
        const uint ib = cell * p.nb1 + head * p.nb2 + stream * p.nb3 + d0 / 32;
        const uint e = d0 % 32;   // first element of this piece within its block
        const float16_t dm = data_a[ib].d;
#if defined(DATA_A_Q8_0)
        // element j of the block is byte j
        [[unroll]] for (uint j = 0; j < 4; ++j) {
            const int w = int(data_a[ib].qs[e / 2 + j]);   // sign-extended: the high byte is already right
            v[2 * j]     = dm * float16_t((w << 24) >> 24);
            v[2 * j + 1] = dm * float16_t(w >> 8);
        }
#else
        // 4-bit types: byte j holds element j in its low nibble and element j + 16 in its high one (see dequant_q4_0.comp);
        // q5 types add bit j of qh as bit 4
#if defined(DATA_A_Q4_1) || defined(DATA_A_Q5_1)
        const float m = float(data_a[ib].m);
#endif
#if defined(DATA_A_Q5_0)
        const uint qh = uint(data_a[ib].qh[1]) << 16 | uint(data_a[ib].qh[0]);
#elif defined(DATA_A_Q5_1)
        const uint qh = data_a[ib].qh;
#endif
        [[unroll]] for (uint j = 0; j < 8; ++j) {
            const uint el = e + j;
            const uint byte = el % 16;
            uint q = (uint(data_a[ib].qs[byte / 2]) >> (8 * (byte % 2) + (el < 16 ? 0 : 4))) & 0xf;
#if defined(DATA_A_Q5_0) || defined(DATA_A_Q5_1)
            q |= ((qh >> el) & 1) << 4;
#endif
#if defined(DATA_A_Q4_0)
            v[j] = float16_t(float(dm) * (float(q) - 8.0));
#elif defined(DATA_A_Q5_0)
            v[j] = float16_t(float(dm) * (float(q) - 16.0));
#elif defined(DATA_A_Q4_1) || defined(DATA_A_Q5_1)
            v[j] = float16_t(float(dm) * float(q) + m);
#elif defined(DATA_A_IQ4_NL)
            v[j] = float16_t(float(dm) * float(kvalues_iq4nl_const[q]));
#else
#error flash_attn_sel_gather: unhandled K/V type
#endif
        }
#endif
#endif
        data_dst[(g * p.n_head_kv + head) * (D / 8) + d0 / 8] = uvec4(
            packFloat2x16(f16vec2(v[0], v[1])), packFloat2x16(f16vec2(v[2], v[3])),
            packFloat2x16(f16vec2(v[4], v[5])), packFloat2x16(f16vec2(v[6], v[7])));
    }

    if (p.write_list != 0) {
        const uint s = slot0 + gl_LocalInvocationIndex;
        if (gl_LocalInvocationIndex < SLOTS && s < p.list_stride) {
            data_list2[row * p.list_stride + s] = row * p.list_stride + s;
        }
        if (gl_WorkGroupID.x == 0 && gl_LocalInvocationIndex == 0) {
            const uint c = p.n_rows * p.list_stride + row;
            data_list2[c] = data_list[c];
        }
    }
}
