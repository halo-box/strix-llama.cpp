#version 450

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require

// Routed MoE down projection, MUL_MAT_ID (+ MUL by the router weights) + CPY(f16), q5_1 experts, f16 output = the CPY's
// destination. Weight-streaming design (after halo-box PR #213's HIP R2 down kernel): at prefill every expert's rows are read
// once per 64-token tile, so the kernel is bound by how fast it streams the weights. They go from global memory straight
// into registers, one 64-K stage ahead, and never touch shared memory.
//
// Workgroup = one tile of the count_experts list (expert, up to 64 routed rows) x 256 output features, 8 wave32 subgroups.
// Wave w owns features 32 w .. 32 w + 31, one row per lane; lanes 0..15 hold the first 16, lanes 16..31 the second 16, and one
// xor-16 shuffle per f16 pair gives every lane both fragments in the gfx11 layout. B (the routed rows' activations) is gathered
// by row id into double-buffered shared memory, 64 K per stage. Token sub-tiles past the tile's row count skip their WMMA.
//
// Fragment layout (RDNA3 + RADV, wave32; the host requires ggml_vk_check_coopmat_rdna3_layout):
//   A: lane L holds row L % 16, element i = k i;  B: lane L holds column L % 16, element i = k i;
//   f32 accumulator: lane L holds column L % 16, element e = row L / 16 + 2 e.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform parameter {
    uint M;              // output features per expert (n_embd), multiple of 256
    uint K;              // n_ff, multiple of 64
    uint a_offset;       // weights, uvec4 units
    uint stride_e;       // uvec4 per expert (M * K / 32 * 24 / 16)
    uint b_offset;       // B, in uvec4 units
    uint b_s1;           // B stride per slot (ne11 > 1), uvec4 units
    uint b_s2;           // B stride per token, uvec4 units
    uint ne11;
    uint d_offset;       // D, in f16vec4 units
    uint n_used;
    uint row_ids_offset;
    uint s_offset;       // router weights [1, n_used, n_tokens], floats
    uint scaled;         // 0: no MUL in the chain (the scale binding is not read)
} p;

layout(binding = 0) readonly buffer A  { uvec4 data_a[]; };
layout(binding = 1) readonly buffer B  { uvec4 data_b[]; };
layout(binding = 2) writeonly buffer D { f16vec4 data_d[]; };
layout(binding = 3) readonly buffer E  { uint data_e[]; };   // count_experts: [0] tiles, (expert, rows) per tile, row ids
layout(binding = 4) readonly buffer S  { float data_s[]; };

#define MATA coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA>
#define MATB coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB>
#define ACC  coopmat<float,     gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>

#define BN 64            // tokens per tile (the count_experts row tile)
#ifndef KC
#define KC 64            // K per stage: two q5_1 blocks, 48 bytes = 3 uvec4 per row (KC=128: four blocks, 6 uvec4)
#endif
#ifndef TPW
#define TPW 1            // count_experts tiles per workgroup, run back to back (the next tile's first stage loads under the epilogue)
#endif
#define NBL (KC / 32)    // q5_1 blocks per stage
#define AU  (NBL * 3 / 2) // A uvec4 per lane and stage
#define KS  (KC / 16)    // 16-K WMMA steps per stage
#define SB  (KC / 2 + 4) // shared row stride in uints (KC halves + 4 pad, 16-byte aligned rows)

shared uint buf_b[2][BN * SB];
shared uint s_rid[TPW][BN];

#if defined(PK16)
// one half of a q5_1 block -> 8 packed f16 pairs fma(q, d, m) in f16 (one rounding). The pairs hold K positions (4w, 4w + 2) and
// (4w + 1, 4w + 3): the byte lanes 0/2 and 1/3 of a dword become f16 1024 + q by an OR with 0x6400, minus 1024 exactly. B is
// stored in shared memory with the same 4-group order (STORE_B), so the products pair up as before.
void q51_frag(const uvec4 qs, const uint qh, const uint h, const uint dm, out uint o[8]) {
    const f16vec2 dmh = unpackFloat2x16(dm);
    const f16vec2 d2 = f16vec2(dmh.x, dmh.x);
    const f16vec2 m2 = f16vec2(dmh.y, dmh.y);
    const f16vec2 off = f16vec2(float16_t(1024.0), float16_t(1024.0));
    [[unroll]] for (uint w = 0; w < 4; w++) {
        const uint hb = bitfieldExtract(qh, int(4 * w + 16 * h), 4);
        // fifth bits 0..3 -> bit 4 of bytes 0..3 (shifted copies at 4 + 7 j never collide for j < 4)
        const uint nb = ((qs[w] >> (4 * h)) & 0x0F0F0F0Fu) | ((hb * 0x02040810u) & 0x10101010u);
        const uint x0 = (nb & 0x00FF00FFu) | 0x64006400u;
        const uint x1 = ((nb >> 8) & 0x00FF00FFu) | 0x64006400u;
        o[2 * w]     = packFloat2x16(fma(unpackFloat2x16(x0) - off, d2, m2));
        o[2 * w + 1] = packFloat2x16(fma(unpackFloat2x16(x1) - off, d2, m2));
    }
}
#else
// one half (h = 0: values 0..15, the low nibbles; h = 1: values 16..31, the high nibbles) of a q5_1 block -> 8 packed f16
// pairs f16(fma(d, q, m)); qs = the block's 16 quant bytes, qh its 32 fifth bits
void q51_frag(const uvec4 qs, const uint qh, const uint h, const uint dm, out uint o[8]) {
    const vec2 dmf = unpackHalf2x16(dm);
    const float d = dmf.x, m = dmf.y;
    [[unroll]] for (uint w = 0; w < 4; w++) {
        const uint hb = (qh >> (4 * w + 16 * h)) & 0xFu;
        const uint nb = ((qs[w] >> (4 * h)) & 0x0F0F0F0Fu) |
                        ((hb & 1u) << 4) | ((hb & 2u) << 11) | ((hb & 4u) << 18) | ((hb & 8u) << 25);
        const vec4 v = vec4(float(nb & 0xFFu), float((nb >> 8) & 0xFFu), float((nb >> 16) & 0xFFu), float(nb >> 24));
        o[2 * w]     = packFloat2x16(f16vec2(fma(d, v.x, m), fma(d, v.y, m)));
        o[2 * w + 1] = packFloat2x16(f16vec2(fma(d, v.z, m), fma(d, v.w, m)));
    }
}
#endif

uint pick(const uint v[TPW], const uint i) {
    uint r = v[0];
    [[unroll]] for (uint k = 1; k < TPW; k++) {
        if (i == k) {
            r = v[k];
        }
    }
    return r;
}

void main() {
    const uint n_tiles = data_e[0];
    const uint tile0 = (gl_WorkGroupID.y + gl_WorkGroupID.z * gl_NumWorkGroups.y) * TPW;
    if (tile0 >= n_tiles) {
        return;
    }
    const uint ntl = min(uint(TPW), n_tiles - tile0);   // tiles of this workgroup (uniform)

    const uint tid  = gl_LocalInvocationID.x;
    const uint wave = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const bool lo   = lane < 16;

    if (tid < BN) {
        [[unroll]] for (uint tt = 0; tt < TPW; tt++) {
            if (tt < ntl) {
                // rows past nrows reuse row 0, so the B gather stays in bounds; their results are not stored
                const uint nr = data_e[2 + 2 * (tile0 + tt)];
                s_rid[tt][tid] = data_e[p.row_ids_offset + (tile0 + tt) * BN + (tid < nr ? tid : 0)];
            }
        }
    }
    barrier();

    // B gather: thread tid fills token tid / 4, K quarter tid % 4 (KC / 4 values) of each stage
    const uint b_tok = tid / 4;
    const uint b_q   = tid % 4;
    uint b_base[TPW];
    [[unroll]] for (uint tt = 0; tt < TPW; tt++) {
        const uint rid = s_rid[tt < ntl ? tt : 0][b_tok];
        b_base[tt] = p.b_offset + (rid >> 16) * p.b_s2 + ((rid & 0xFFFFu) % p.ne11) * p.b_s1;
    }
    const uint b_lds = b_tok * SB + b_q * (KC / 8);
#if defined(B_F32)
#define BR (KC / 16)            // uvec4 per thread and stage (4 floats each)
#define B_PER_STAGE (KC / 4)
#else
#define BR (KC / 32)            // uvec4 per thread and stage (8 halves each)
#define B_PER_STAGE (KC / 8)
#endif
    uvec4 br[BR];
#define LOAD_B(base, st) { const uint bi = (base) + (st) * B_PER_STAGE + b_q * BR; \
        [[unroll]] for (uint i = 0; i < BR; i++) { br[i] = data_b[bi + i]; } }
#if defined(B_F32)
#define STORE_B(buf) { [[unroll]] for (uint i = 0; i < BR; i++) { \
        buf_b[buf][b_lds + 2 * i]     = packFloat2x16(f16vec2(uintBitsToFloat(br[i].xy))); \
        buf_b[buf][b_lds + 2 * i + 1] = packFloat2x16(f16vec2(uintBitsToFloat(br[i].zw))); } }
#elif defined(PK16)
    // K order (4g, 4g + 2), (4g + 1, 4g + 3) per dword pair, as q51_frag's A pairs
#define STORE_B(buf) { [[unroll]] for (uint i = 0; i < BR; i++) { \
        buf_b[buf][b_lds + 4 * i]     = (br[i].x & 0xFFFFu) | (br[i].y << 16); \
        buf_b[buf][b_lds + 4 * i + 1] = (br[i].x >> 16) | (br[i].y & 0xFFFF0000u); \
        buf_b[buf][b_lds + 4 * i + 2] = (br[i].z & 0xFFFFu) | (br[i].w << 16); \
        buf_b[buf][b_lds + 4 * i + 3] = (br[i].z >> 16) | (br[i].w & 0xFFFF0000u); } }
#else
#define STORE_B(buf) { [[unroll]] for (uint i = 0; i < BR; i++) { \
        buf_b[buf][b_lds + 4 * i] = br[i].x; buf_b[buf][b_lds + 4 * i + 1] = br[i].y; \
        buf_b[buf][b_lds + 4 * i + 2] = br[i].z; buf_b[buf][b_lds + 4 * i + 3] = br[i].w; } }
#endif

    // A: this lane's row, AU uvec4 per KC stage = NBL 24-byte q5_1 blocks (d, m | qh | 16 qs bytes)
    const uint feat0 = gl_WorkGroupID.x * 256 + wave * 32;
    const uint row_u = p.K * 3 / 64;                     // uvec4 per row
    uint a_base[TPW];
    [[unroll]] for (uint tt = 0; tt < TPW; tt++) {
        const uint expert = data_e[1 + 2 * (tile0 + (tt < ntl ? tt : 0))];
#if defined(A_REPACK)
        // expert-repacked weights (Vulkan expert repack buffer): per 32-row block the 16-byte units are stored unit-major,
        // [uvec4 k][32 rows], so each load is 512 contiguous bytes across the wave
        a_base[tt] = p.a_offset + expert * p.stride_e + feat0 * row_u + lane;
#else
        a_base[tt] = p.a_offset + expert * p.stride_e + (feat0 + lane) * row_u;
#endif
    }
#if defined(A_REPACK)
#define LOAD_A(base, st, r) { const uint ai = (base) + (st) * (AU * 32); [[unroll]] for (uint j = 0; j < AU; j++) { r[j] = data_a[ai + 32 * j]; } }
#else
#define LOAD_A(base, st, r) { const uint ai = (base) + (st) * AU; [[unroll]] for (uint j = 0; j < AU; j++) { r[j] = data_a[ai + j]; } }
#endif

    ACC acc0[4];   // features feat0 .. feat0 + 15
    ACC acc1[4];   // features feat0 + 16 .. feat0 + 31
    [[unroll]] for (uint t = 0; t < 4; t++) {
        acc0[t] = ACC(0.0);
        acc1[t] = ACC(0.0);
    }

    const uint n_stages = p.K / KC;
    const uint steps = ntl * n_stages;
    uvec4 a[AU];
    LOAD_A(a_base[0], 0, a);
    LOAD_B(b_base[0], 0);
    STORE_B(0);
    barrier();

    uint tt = 0, st = 0;
    uint nrows = data_e[2 + 2 * tile0];
    for (uint i = 0; i < steps; i++) {
        const uint cur = i & 1;
        const bool more = i + 1 < steps;
        const bool last = st + 1 == n_stages;
        const uint nt = (nrows + 15) / 16;              // live 16-token sub-tiles (uniform)
        uvec4 n[AU];
        if (more) {
            const uint ntt = last ? tt + 1 : tt;
            const uint nst = last ? 0 : st + 1;
            LOAD_A(pick(a_base, ntt), nst, n);
            LOAD_B(pick(b_base, ntt), nst);
        }

        // KS 16-K steps: (block 0, values 0..15), (block 0, 16..31), (block 1, 0..15), ...
        [[unroll]] for (uint ks = 0; ks < KS; ks++) {
            const uint bl = ks / 2, h = ks % 2, pr = 3 * (bl / 2);
            uint own[8];
            if ((bl & 1) == 0) {
                q51_frag(uvec4(a[pr].z, a[pr].w, a[pr + 1].x, a[pr + 1].y), a[pr].y, h, a[pr].x, own);
            } else {
                q51_frag(a[pr + 2], a[pr + 1].w, h, a[pr + 1].z, own);
            }
            MATA f0, f1;
            [[unroll]] for (uint j = 0; j < 8; j++) {
                const uint oth = subgroupShuffleXor(own[j], 16);
                const f16vec2 v0 = unpackFloat2x16(lo ? own[j] : oth);
                const f16vec2 v1 = unpackFloat2x16(lo ? oth : own[j]);
                f0[2 * j] = v0.x; f0[2 * j + 1] = v0.y;
                f1[2 * j] = v1.x; f1[2 * j + 1] = v1.y;
            }
            [[unroll]] for (uint t = 0; t < 4; t++) {
                if (t < nt) {
                    MATB bf;
                    const uint bb = (t * 16 + lane % 16) * SB + ks * 8;
                    [[unroll]] for (uint j = 0; j < 8; j++) {
                        const f16vec2 v = unpackFloat2x16(buf_b[cur][bb + j]);
                        bf[2 * j] = v.x; bf[2 * j + 1] = v.y;
                    }
                    acc0[t] = coopMatMulAdd(f0, bf, acc0[t]);
                    acc1[t] = coopMatMulAdd(f1, bf, acc1[t]);
                }
            }
        }

        if (last) {
            // epilogue: times the router weight, then f16 (the unfused chain's MUL in f32, then the CPY); one xor-16 shuffle gives
            // each lane 4 consecutive features of its token (low half: rows 2e .. 2e + 3, high half: the next four), one f16vec4 store
            [[unroll]] for (uint t = 0; t < 4; t++) {
                if (t < nt) {
                    const uint row = t * 16 + lane % 16;
                    const uint rid = s_rid[tt][row];
                    const uint slot = ((rid >> 16) * p.n_used + (rid & 0xFFFFu));
                    const float w = p.scaled != 0 ? data_s[p.s_offset + slot] : 1.0f;
                    const uint dst_row = slot * (p.M / 4);
                    [[unroll]] for (uint f = 0; f < 2; f++) {
                        [[unroll]] for (uint e = 0; e < 8; e += 4) {
                            const float c0 = (f == 0 ? acc0[t][e]     : acc1[t][e])     * w;
                            const float c1 = (f == 0 ? acc0[t][e + 1] : acc1[t][e + 1]) * w;
                            const float c2 = (f == 0 ? acc0[t][e + 2] : acc1[t][e + 2]) * w;
                            const float c3 = (f == 0 ? acc0[t][e + 3] : acc1[t][e + 3]) * w;
                            const float r0 = subgroupShuffleXor(lo ? c2 : c0, 16);
                            const float r1 = subgroupShuffleXor(lo ? c3 : c1, 16);
                            const vec4 v = lo ? vec4(c0, r0, c1, r1) : vec4(r0, c2, r1, c3);
                            const uint fe = feat0 + 16 * f + 2 * e + (lo ? 0u : 4u);
#if defined(EPI_OFF)
                            // measurement only: keeps the GEMM, drops (almost) every store
                            if (row < nrows && v.x == 1234.5f) {
#else
                            if (row < nrows) {
#endif
                                data_d[p.d_offset + dst_row + fe / 4] = f16vec4(v);
                            }
                        }
                    }
                    acc0[t] = ACC(0.0);
                    acc1[t] = ACC(0.0);
                }
            }
        }

        if (more) {
            STORE_B(cur ^ 1);
            [[unroll]] for (uint j = 0; j < AU; j++) {
                a[j] = n[j];
            }
        }
        barrier();
        if (last) {
            tt++;
            st = 0;
            nrows = tt < ntl ? data_e[2 + 2 * (tile0 + tt)] : 0;
        } else {
            st++;
        }
    }
}
