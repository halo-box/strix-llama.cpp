#version 450

#include "glu_head.glsl"

// SITU activation (a = gate, b = up) and the optional signs MUL in one pass, with the unfused shaders' f32 expressions.
// alpha/limit: the gate scales, su1/su2: the up scales, zero: the scales' bias.

layout (binding = 3) readonly buffer S {float data_s[];};
layout (constant_id = 0) const bool SIGNS = false;

float situ_tanh(float x) {
    return 1.0f - 2.0f / (exp(2.0f*x) + 1.0f);
}

void main() {
    const uint i = gl_GlobalInvocationID.z * 262144 + gl_GlobalInvocationID.y * 512 + gl_GlobalInvocationID.x;

    if (i >= p.N) {
        return;
    }

    const uint i23 = fastdiv(i, p.ne2_012mp, p.ne2_012L);
    const uint i23_offset = i23 * p.ne22*p.ne21*p.ne20;
    const uint i22 = fastdiv(i - i23_offset, p.ne2_01mp, p.ne2_01L);
    const uint i22_offset = i22*p.ne21*p.ne20;
    const uint i21 = fastdiv(i - i23_offset - i22_offset, p.ne2_0mp, p.ne2_0L);
    const uint i20 = i - i23_offset - i22_offset - i21*p.ne20;

    const float a = float(data_a[get_aoffset() + i23 * p.nb03 + i22 * p.nb02 + i21 * p.nb01 + i20 * p.nb00]);
    const float b = float(data_b[get_boffset() + i23 * p.nb13 + i22 * p.nb12 + i21 * p.nb11 + i20 * p.nb10]);

    const float c   = situ_tanh(a * p.alpha + p.zero) * p.limit + p.zero;
    const float act = c * (1.0f / (1.0f + exp(-a)));
    const float u   = situ_tanh(b * p.su1 + p.zero) * p.su2 + p.zero;
    float r = act * u;
    if (SIGNS) {
        r = r * data_s[i20];
    }

    data_d[get_doffset() + i23 * p.nb23 + i22 * p.nb22 + i21 * p.nb21 + i20 * p.nb20] = D_TYPE(r);
}
