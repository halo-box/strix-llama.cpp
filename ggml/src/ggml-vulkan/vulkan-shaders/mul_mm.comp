// Register-direct A for MUL_MAT_ID (REG_A, after Halogen's expert-loading design; host gate GGML_VK_MMID_REGA): each wave32 subgroup
// owns 32 rows; lanes 0..15 / 16..31 dequantize one 16-row fragment each, one K step ahead, into the A fragment elements (gfx11
// layout) and swap halves with one xor-16 shuffle per f16 pair. A skips shared memory; aligned iq3_xxs / iq4_nl pipelines only.
layout(constant_id = 15) const uint REG_A = 0;
#if defined(MUL_MAT_ID) && defined(COOPMAT) && defined(FLOAT16) && defined(A_PREFETCH) && LOAD_VEC_A == 8 && (defined(DATA_A_IQ3_XXS) || defined(DATA_A_IQ4_NL))
#define MMID_REGA 1
struct rega_raw_t { uvec4 q; uint d; };
#if defined(DATA_A_IQ3_XXS)
#define REGA_BLK_K 256
// q.x: grid bytes 0..3, q.y: grid bytes 4..7, q.z: sign/scale dword, q.w: d bits (the lane's row, sub-block ib32)
rega_raw_t rega_fetch(const uint pos_a, const uint row_off) {
    const uint sb   = (pos_a / 32 + row_off) * 98;
    const uint ib32 = (pos_a / 4) % 8;
    const uint q    = (sb + 2 + 8 * ib32) / 2;
    const uint so   = (sb + 66 + 4 * ib32) / 2;
    return rega_raw_t(uvec4(uint(data_a_u16[q])      | (uint(data_a_u16[q + 1]) << 16),
                            uint(data_a_u16[q + 2])  | (uint(data_a_u16[q + 3]) << 16),
                            uint(data_a_u16[so])     | (uint(data_a_u16[so + 1]) << 16),
                            uint(data_a_u16[sb / 2])), 0u);
}
#else
#define REGA_BLK_K 32
// q: the block's 16 nibble bytes (low nibbles k 0..15, high k 16..31), d: d bits
rega_raw_t rega_fetch(const uint pos_a, const uint row_off) {
    const uint base = (pos_a / 4 + row_off) * 18;
    const bool odd  = ((base + 2) & 2) != 0;
    return rega_raw_t(uvec4(unpack8b(fetch8(base + 2), odd), unpack8b(fetch8(base + 10), odd)), uint(data_a_u16[base / 2]));
}
#endif
// k 16*h .. 16*h+15 of the sub-block into an A fragment
void rega_build(const rega_raw_t raw, const uint h, inout coopmat<FLOAT_TYPE, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> a) {
#if defined(DATA_A_IQ3_XXS)
    const float db = unpackHalf2x16(raw.q.w).x * 0.5 * (0.5 + float(raw.q.z >> 28));
    const uint g = h == 0 ? raw.q.x : raw.q.y;
    [[unroll]] for (uint j = 0; j < 2; j++) {
        const uint s7 = bitfieldExtract(raw.q.z, int(7 * (2 * h + j)), 7);
        const uint s8 = s7 | ((bitCount(s7) & 1) << 7);
        const vec4 v0 = db * vec4(unpack8(iq3xxs_grid[(g >> (16 * j)) & 0xFF]));
        const vec4 v1 = db * vec4(unpack8(iq3xxs_grid[(g >> (16 * j + 8)) & 0xFF]));
        const vec4 m0 = vec4(1.0) - 2.0 * vec4(uvec4(s8, s8 >> 1, s8 >> 2, s8 >> 3) & 1u);
        const vec4 m1 = vec4(1.0) - 2.0 * vec4(uvec4(s8 >> 4, s8 >> 5, s8 >> 6, s8 >> 7) & 1u);
        const vec4 a0 = v0 * m0;
        const vec4 a1 = v1 * m1;
        a[8 * j + 0] = FLOAT_TYPE(a0.x); a[8 * j + 1] = FLOAT_TYPE(a0.y);
        a[8 * j + 2] = FLOAT_TYPE(a0.z); a[8 * j + 3] = FLOAT_TYPE(a0.w);
        a[8 * j + 4] = FLOAT_TYPE(a1.x); a[8 * j + 5] = FLOAT_TYPE(a1.y);
        a[8 * j + 6] = FLOAT_TYPE(a1.z); a[8 * j + 7] = FLOAT_TYPE(a1.w);
    }
#else
    const float d = unpackHalf2x16(raw.d).x;
    [[unroll]] for (uint w = 0; w < 4; w++) {
        const uint nb = (raw.q[w] >> (4 * h)) & 0x0F0F0F0F;
        a[4 * w + 0] = FLOAT_TYPE(d * float(kvalues_iq4nl[nb & 0xFF]));
        a[4 * w + 1] = FLOAT_TYPE(d * float(kvalues_iq4nl[(nb >> 8) & 0xFF]));
        a[4 * w + 2] = FLOAT_TYPE(d * float(kvalues_iq4nl[(nb >> 16) & 0xFF]));
        a[4 * w + 3] = FLOAT_TYPE(d * float(kvalues_iq4nl[nb >> 24]));
    }
#endif
}
#endif

#ifdef MULMAT_QUANT
#include "iq_shmem_init.glsl"
#endif

void main() {
#ifdef MUL_MAT_ID
    const uint tile_idx = gl_WorkGroupID.y + gl_WorkGroupID.z * gl_NumWorkGroups.y;
    if (tile_idx >= data_row_map[0]) {
        return;
    }
    const uint expert_idx = data_row_map[1 + 2 * tile_idx];
    const uint row_begin = tile_idx * BN;
    _ne1 = data_row_map[2 + 2 * tile_idx];
    const uint ic = 0;
#else
    const uint ic = gl_WorkGroupID.y;
#endif
#if defined(NEEDS_INIT_IQ_SHMEM) || defined(MULMAT_QUANT)
    init_iq_shmem(gl_WorkGroupSize);
#endif

#ifndef MUL_MAT_ID
    const uint batch_idx = gl_WorkGroupID.z + p.base_work_group_z;

    const uint i13 = batch_idx / p.ne12;
    const uint i12 = batch_idx % p.ne12;

    const uint i03 = i13 / p.broadcast3;
    const uint i02 = i12 / p.broadcast2;

    const uint batch_idx_a = i03 * p.ne02 + i02;
#endif

    const uint blocks_m = (p.M + BM - 1) / BM;
    const uint ir = gl_WorkGroupID.x % blocks_m;
    const uint ik = gl_WorkGroupID.x / blocks_m;

    const uint WNITER = (WM * WN) / (WARP * TM * TN * WMITER);
    const uint WSUBM = WM / WMITER;
    const uint WSUBN = WN / WNITER;

#ifdef COOPMAT
    const uint warp_i = gl_SubgroupID;

    const uint tiw = gl_SubgroupInvocationID;

    const uint cms_per_row = WM / TM;
    const uint cms_per_col = WN / TN;

    const uint storestride = WARP / TM;
    const uint store_r = tiw % TM;
    const uint store_c = tiw / TM;
#else
    const uint warp_i = gl_LocalInvocationID.x / WARP;

    const uint tiw = gl_LocalInvocationID.x % WARP;

    const uint tiwr = tiw % (WSUBM / TM);
    const uint tiwc = tiw / (WSUBM / TM);
#endif

    const uint warp_r = warp_i % (BM / WM);
    const uint warp_c = warp_i / (BM / WM);

#if defined(DATA_A_F32) || defined(DATA_A_F16) || defined(DATA_A_BF16)
    const uint LOAD_VEC_A_EFF = (ALIGNED != 0) ? LOAD_VEC_A : 1;
    const uint LOAD_VEC_BATCH_A = (ALIGNED != 0) ? 1 : 2;
#elif !defined(MULMAT_QUANT)
    const uint LOAD_VEC_A_EFF = LOAD_VEC_A;
    const uint LOAD_VEC_BATCH_A = 1;
#else
    const uint LOAD_VEC_A_EFF = mm_load_vec_a();
    const uint LOAD_VEC_BATCH_A = 1;
#endif
    const uint LOAD_VEC_B_EFF = (ALIGNED != 0) ? LOAD_VEC_B : 1;
    const uint LOAD_VEC_BATCH_B = (ALIGNED != 0) ? 1 : 2;

    const uint loadr_a = gl_LocalInvocationID.x % (BK / LOAD_VEC_A_EFF / LOAD_VEC_BATCH_A);
    const uint loadc_a = gl_LocalInvocationID.x / (BK / LOAD_VEC_A_EFF / LOAD_VEC_BATCH_A);
    const uint loadr_b = gl_LocalInvocationID.x % (BK / LOAD_VEC_B_EFF / LOAD_VEC_BATCH_B);
    const uint loadc_b = gl_LocalInvocationID.x / (BK / LOAD_VEC_B_EFF / LOAD_VEC_BATCH_B);

    const uint loadstride_a = gl_WorkGroupSize.x * LOAD_VEC_A_EFF * LOAD_VEC_BATCH_A / BK;
    const uint loadstride_b = gl_WorkGroupSize.x * LOAD_VEC_B_EFF * LOAD_VEC_BATCH_B / BK;

#ifdef MUL_MAT_ID
    load_row_ids(row_begin);
    uint required_work_items = _ne1 * BK / LOAD_VEC_B_EFF / LOAD_VEC_BATCH_B;
    uint required_warp_c = (_ne1 + WN - 1) / WN;
#endif

#ifdef MUL_MAT_ID
    const uint start_k = 0;
    const uint end_k = p.K;
#else
    const uint start_k = ik * p.k_split;
    const uint end_k = min(p.K, (ik + 1) * p.k_split);
#endif

    uint pos_a =
#ifdef MUL_MAT_ID
        expert_idx * (p.batch_stride_a / LOAD_VEC_A_EFF) +
#else
        batch_idx_a * (p.batch_stride_a / LOAD_VEC_A_EFF) +
#endif
        (ir * BM * p.stride_a + start_k) / LOAD_VEC_A_EFF;
#ifdef MUL_MAT_ID
    uint pos_b = 0;
#else
    uint pos_b = (batch_idx * p.batch_stride_b + ic * BN * p.stride_b + start_k) / LOAD_VEC_B_EFF;
#endif

#ifdef COOPMAT
    coopmat<FLOAT_TYPE, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> cache_a;
    coopmat<FLOAT_TYPE, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> cache_b;
    coopmat<ACC_TYPE, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> sums[cms_per_row * cms_per_col];

    [[unroll]] for (uint i = 0; i < cms_per_row * cms_per_col; i++) {
        sums[i] = coopmat<ACC_TYPE, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(0.0f);
    }
#else
    ACC_TYPEV2 sums[WMITER * TM * WNITER * TN/2];
#if defined(DATA_A_F32) || defined(DATA_A_F16)
    FLOAT_TYPEV4 cache_a[WMITER * TM];
    FLOAT_TYPEV4 cache_b;
#else
    FLOAT_TYPEV2 cache_a[WMITER * TM];
    FLOAT_TYPEV2 cache_b;
#endif

    [[unroll]] for (uint i = 0; i < WMITER*TM*WNITER*TN/2; i++) {
        sums[i] = ACC_TYPEV2(0.0f, 0.0f);
    }
#endif

#if defined(DATA_A_Q5_K) || defined(DATA_A_Q4_K)
#if defined(SCACHE_DM)
// refill all 8 sub-block (d, m) pairs per row at each superblock boundary (reads at the current pos_a)
#define SCACHE_REFILL(blk) if (((blk) & 255) == 0) { \
            for (uint x = gl_LocalInvocationID.x; x < BM * 8; x += gl_WorkGroupSize.x) { \
                const uint r  = x / 8; \
                const uint is = x % 8; \
                const uint idx = pos_a + r * (p.stride_a / LOAD_VEC_A); \
                const uint ib = idx / 64; \
 \
                const vec2 loadd = vec2(data_a[ib].dm); \
                const uvec3 scales = uvec3(data_a_packed32[ib].scales[0], \
                                           data_a_packed32[ib].scales[1], \
                                           data_a_packed32[ib].scales[2]); \
                const uint scalesoffs = (is & 3) * 8; \
                const uint scidx0 = (is < 4) ? 0 : 2; \
                const uint scidxshift1 = (is < 4) ? scalesoffs : scalesoffs + 2; \
                const uint mbidx0 = (is < 4) ? 1 : 2; \
                const uint mbidxshift0 = (is < 4) ? scalesoffs : scalesoffs + 4; \
                const uint mbidxshift1 = (is < 4) ? scalesoffs : scalesoffs + 2; \
                const uint sc    = ((scales[scidx0] >> scalesoffs) & 0xF) | ((scales[0] >> scidxshift1) & 0x30); \
                const uint mbyte = ((scales[mbidx0] >> mbidxshift0) & 0xF) | ((scales[1] >> mbidxshift1) & 0x30); \
 \
                scache_dm[x] = SCACHE_T(loadd.x * sc, -loadd.y * mbyte); \
            } \
            barrier(); \
}
#endif
#endif
#if !defined(SCACHE_REFILL)
#define SCACHE_REFILL(blk)
#endif

#if defined(A_PREFETCH) && defined(B_PREFETCH)
    // The 256x256 XL tier (16 wave32 subgroups, 192 VGPRs each, 128 for the accumulators) stays spill-free by re-reading B per
    // accumulator row and (XL_IDX_BASE, not q4_K) keeping only row 0's tile addressing in registers; other tiles are unchanged.
    const bool XL_TILE = BM * BN >= 256 * 256;
#if defined(DATA_A_Q4_K)
    const bool XL_IDX_BASE = false;
#else
    const bool XL_IDX_BASE = XL_TILE;
#endif
    // Register double-buffer for the next K tile (mul_mm_pf_funcs.glsl); aligned pipelines only. The raw
    // registers hold the tile at pos_a / pos_b; store_*_raw dequantise it into LDS while the next tile's
    // loads are in flight. The lane-invariant parts of the tile addressing are computed once (NIR does
    // not hoist them out of the K loop).
    const uint NA_RAW = (BM + loadstride_a - 1) / loadstride_a;
    const uint NB_RAW = (BN + loadstride_b - 1) / loadstride_b;
    A_RAW_T a_raw[NA_RAW];
    B_TYPE b_raw[NB_RAW];
    uint a_lane[NA_RAW];
    uint a_sidx[NA_RAW];
    uint b_sidx[NB_RAW];
    const uint a_lane0 = a_lane_off(loadr_a, loadc_a);
    const uint a_sidx0 = a_shmem_index(loadc_a, loadr_a * LOAD_VEC_A / 2);
    const uint b_sidx0 = loadc_b * SHMEM_STRIDE + loadr_b * LOAD_VEC_B / 2;
    if (!XL_IDX_BASE) {
        [[unroll]] for (uint l = 0; l < BM; l += loadstride_a) {
            a_lane[l / loadstride_a] = a_lane_off(loadr_a, loadc_a + l);
            a_sidx[l / loadstride_a] = a_shmem_index(loadc_a + l, loadr_a * LOAD_VEC_A / 2);
        }
        [[unroll]] for (uint l = 0; l < BN; l += loadstride_b) {
            b_sidx[l / loadstride_b] = (loadc_b + l) * SHMEM_STRIDE + loadr_b * LOAD_VEC_B / 2;
        }
    }
#define A_LANE(l) (XL_IDX_BASE ? a_lane0 + a_lane_off(0, (l)) : a_lane[(l) / loadstride_a])
#define A_SIDX(l) (XL_IDX_BASE ? a_sidx0 + a_shmem_index((l), 0) : a_sidx[(l) / loadstride_a])
#define B_SIDX(l) (XL_IDX_BASE ? b_sidx0 + (l) * SHMEM_STRIDE : b_sidx[(l) / loadstride_b])
#ifdef MUL_MAT_ID
// spec constant 17 (GGML_VK_MMID_B_FULL, only with the row-id fill): load B for the whole BN tile, so the per-lane guard folds away
// and the prefetch loads stay in flight across the WMMAs (no vmcnt(0) at a K-loop branch on gfx1151 ACO). Only where
// BN % loadstride_b == 0, else a lane's last pass would land past the B tile; other tiles keep the guard.
layout(constant_id = 17) const uint MMID_B_FULL = 0;
#define PF_B_GUARD if ((MMID_B_FULL != 0 && BN % loadstride_b == 0) || gl_LocalInvocationID.x < required_work_items)
// with the whole B tile valid (B_FULL above) every warp column may run the WMMAs (empty columns compute token-0 rows never stored)
#define PF_WARP_GUARD if ((MMID_B_FULL != 0 && BN % loadstride_b == 0) || warp_c < required_warp_c)
#else
#define PF_B_GUARD
#endif
#define PF_FETCH() \
    [[unroll]] for (uint l = 0; l < BM; l += loadstride_a) { fetch_a(pos_a, loadr_a, loadc_a + l, A_LANE(l), a_raw[l / loadstride_a]); } \
    PF_B_GUARD { [[unroll]] for (uint l = 0; l < BN; l += loadstride_b) { fetch_b(pos_b, loadr_b, loadc_b + l, b_raw[l / loadstride_b]); } }
#define PF_STORE() \
    [[unroll]] for (uint l = 0; l < BM; l += loadstride_a) { store_a_raw(pos_a, loadr_a, loadc_a + l, A_SIDX(l), a_raw[l / loadstride_a]); } \
    PF_B_GUARD { [[unroll]] for (uint l = 0; l < BN; l += loadstride_b) { store_b_raw(B_SIDX(l), b_raw[l / loadstride_b]); } }
    const bool prefetch = ALIGNED != 0;
#if defined(MMID_REGA)
    if (REG_A != 0 && prefetch) {
        // lane-split register-direct A (REG_A == 3): WM == 32, the lane half selects which of the subgroup's two 16-row
        // blocks it loads; rows past p.M clamp to the last row (never stored)
        const uint rl = warp_r * WM + (gl_SubgroupInvocationID < 16 ? 0 : TM) + gl_SubgroupInvocationID % 16;
        const uint row_off1 = min(ir * BM + rl, p.M - 1) * (p.stride_a / REGA_BLK_K) - ir * BM * (p.stride_a / REGA_BLK_K);
        rega_raw_t a1 = rega_fetch(pos_a, row_off1);
        PF_B_GUARD { [[unroll]] for (uint l = 0; l < BN; l += loadstride_b) { fetch_b(pos_b, loadr_b, loadc_b + l, b_raw[l / loadstride_b]); } }
        const bool lo = gl_SubgroupInvocationID < 16;
        for (uint block = start_k; block < end_k; block += BK) {
            PF_B_GUARD { [[unroll]] for (uint l = 0; l < BN; l += loadstride_b) { store_b_raw(B_SIDX(l), b_raw[l / loadstride_b]); } }
            const bool more = block + BK < end_k;
            pos_a += more ? BK / LOAD_VEC_A_EFF : 0;
            pos_b += more ? BK / LOAD_VEC_B_EFF : 0;
            const rega_raw_t a1n = rega_fetch(pos_a, row_off1);
            PF_B_GUARD { [[unroll]] for (uint l = 0; l < BN; l += loadstride_b) { fetch_b(pos_b, loadr_b, loadc_b + l, b_raw[l / loadstride_b]); } }
            barrier();
            PF_WARP_GUARD {
                coopmat<FLOAT_TYPE, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> ar0, ar1;
                [[unroll]] for (uint h = 0; h < 2; h++) {
                    coopmat<FLOAT_TYPE, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> mine;
                    rega_build(a1, h, mine);
                    [[unroll]] for (uint e = 0; e < 8; e++) {
                        const uint pm = packFloat2x16(f16vec2(mine[2 * e], mine[2 * e + 1]));
                        const uint po = subgroupShuffleXor(pm, 16);
                        const f16vec2 v0 = unpackFloat2x16(lo ? pm : po);
                        const f16vec2 v1 = unpackFloat2x16(lo ? po : pm);
                        ar0[2 * e] = v0.x; ar0[2 * e + 1] = v0.y;
                        ar1[2 * e] = v1.x; ar1[2 * e + 1] = v1.y;
                    }
                    [[unroll]] for (uint cm_col = 0; cm_col < cms_per_col; cm_col++) {
                        LOAD_B_FRAG(cache_b, warp_c * WN + cm_col * TN, 8 * h);
                        sums[cm_col * cms_per_row]     = coopMatMulAdd(ar0, cache_b, sums[cm_col * cms_per_row]);
                        sums[cm_col * cms_per_row + 1] = coopMatMulAdd(ar1, cache_b, sums[cm_col * cms_per_row + 1]);
                    }
                }
            }
            barrier();
            a1 = a1n;
        }
    } else
#endif
    if (prefetch) {
        a_fetch_all = true;
        PF_FETCH()
        a_fetch_all = false;
        for (uint block = start_k; block < end_k; block += BK) {
            SCACHE_REFILL(block)
            PF_STORE()
            // past the last tile the fetch re-reads the last tile (in bounds, never stored), which keeps
            // the raw registers free of a loop-carried select
            const bool more = block + BK < end_k;
            pos_a += more ? BK / LOAD_VEC_A_EFF : 0;
            pos_b += more ? BK / LOAD_VEC_B_EFF : 0;
            PF_FETCH()
            barrier();
#ifdef COOPMAT
#ifdef MUL_MAT_ID
            PF_WARP_GUARD {
#endif
            [[unroll]] for (uint i = 0; i < BK; i += TK) {
                [[unroll]] for (uint cm_row = 0; cm_row < cms_per_row; cm_row++) {
                    LOAD_A_FRAG(cache_a, warp_r * WM + cm_row * TM, i / 2);
                    [[unroll]] for (uint cm_col = 0; cm_col < cms_per_col; cm_col++) {
                        LOAD_B_FRAG(cache_b, warp_c * WN + cm_col * TN, i / 2);
                        sums[cm_col * cms_per_row + cm_row] = coopMatMulAdd(cache_a, cache_b, sums[cm_col * cms_per_row + cm_row]);
                    }
                    // XL: re-read the B fragments for every row (see XL_TILE)
                    if (XL_TILE) { subgroupMemoryBarrierShared(); }
                }
            }
#ifdef MUL_MAT_ID
            }
#endif
#else
#error "MM_PREFETCH variants are KHR coopmat only"
#endif
            barrier();
        }
    } else
#endif // A_PREFETCH && B_PREFETCH
    {
    for (uint block = start_k; block < end_k; block += BK) {
        SCACHE_REFILL(block)
        [[unroll]] for (uint l = 0; l < BM; l += loadstride_a) {
            load_a_to_shmem(pos_a, loadr_a, loadc_a + l, ir * BM + loadc_a + l, block, end_k);
        }
        #ifdef MUL_MAT_ID
        if (gl_LocalInvocationID.x < required_work_items) {
        #endif
        [[unroll]] for (uint l = 0; l < BN; l += loadstride_b) {
#if !defined(MUL_MAT_ID)
            load_b_to_shmem(pos_b, loadr_b, loadc_b + l, ic * BN + loadc_b + l, block, end_k);
#else
            load_b_to_shmem(pos_b, loadr_b, loadc_b + l, ic, _ne1, block, end_k);
#endif
        }
        #ifdef MUL_MAT_ID
        }
        #endif

        barrier();

        pos_a += BK / LOAD_VEC_A_EFF;
        pos_b += BK / LOAD_VEC_B_EFF;

#ifdef COOPMAT
#ifdef MUL_MAT_ID
        if (warp_c < required_warp_c) {
#endif
        [[unroll]] for (uint i = 0; i < BK; i += TK) {
            [[unroll]] for (uint cm_row = 0; cm_row < cms_per_row; cm_row++) {
                // Load from shared into cache
                LOAD_A_FRAG(cache_a, warp_r * WM + cm_row * TM, i / 2);

                [[unroll]] for (uint cm_col = 0; cm_col < cms_per_col; cm_col++) {
                    LOAD_B_FRAG(cache_b, warp_c * WN + cm_col * TN, i / 2);

                    sums[cm_col * cms_per_row + cm_row] = coopMatMulAdd(cache_a, cache_b, sums[cm_col * cms_per_row + cm_row]);
                }
            }
        }
#ifdef MUL_MAT_ID
        }
#endif
#else
        [[unroll]] for (uint i = 0; i < BK / BK_STEP; i++) {
            // Load from shared into cache
            [[unroll]] for (uint wsir = 0; wsir < WMITER; wsir++) {
                [[unroll]] for (uint j = 0; j < TM; j++) {
                #if defined(DATA_A_F32) || defined(DATA_A_F16)
                    cache_a[wsir * TM + j].xy = buf_a[(warp_r * WM + wsir * WSUBM + tiwr * TM + j) * SHMEM_STRIDE + 2 * i    ];
                    cache_a[wsir * TM + j].zw = buf_a[(warp_r * WM + wsir * WSUBM + tiwr * TM + j) * SHMEM_STRIDE + 2 * i + 1];
                #else
                    cache_a[wsir * TM + j] = buf_a[(warp_r * WM + wsir * WSUBM + tiwr * TM + j) * SHMEM_STRIDE + i];
                #endif
                }
            }

            [[unroll]] for (uint wsic = 0; wsic < WNITER; wsic++) {
                [[unroll]] for (uint cc = 0; cc < TN; cc++) {
                #if defined(DATA_A_F32) || defined(DATA_A_F16)
                    cache_b.xy = buf_b[(warp_c * WN + wsic * WSUBN + tiwc * TN + cc) * SHMEM_STRIDE + 2 * i    ];
                    cache_b.zw = buf_b[(warp_c * WN + wsic * WSUBN + tiwc * TN + cc) * SHMEM_STRIDE + 2 * i + 1];
                #else
                    cache_b = buf_b[(warp_c * WN + wsic * WSUBN + tiwc * TN + cc) * SHMEM_STRIDE + i];
                #endif

                    [[unroll]] for (uint wsir = 0; wsir < WMITER; wsir++) {
                        [[unroll]] for (uint cr = 0; cr < TM / 2; cr++) {
                            // [WNITER][TN][WMITER][TM / 2] -> [wsic][cc][wsir][cr]
                            const uint sums_idx = (wsic * TN + cc) * WMITER * (TM / 2) + wsir * (TM / 2) + cr;
                            sums[sums_idx] = dot_product_v2(cache_a[wsir * TM + 2 * cr], cache_a[wsir * TM + 2 * cr + 1], cache_b, sums[sums_idx]);
                        }
                    }
                }
            }

        }
#endif

        barrier();
    }
    }

#if defined(ACC_TYPE_MAX)
#ifdef COOPMAT
    [[unroll]] for (uint j = 0; j < cms_per_row * cms_per_col; j++) {
        [[unroll]] for (uint i = 0; i < sums[j].length(); ++i) {
            sums[j][i] = clamp(sums[j][i], -ACC_TYPE_MAX, ACC_TYPE_MAX);
        }
    }
#else
    [[unroll]] for (uint i = 0; i < WMITER*TM*WNITER*TN/2; i++) {
        sums[i].x = clamp(sums[i].x, -ACC_TYPE_MAX, ACC_TYPE_MAX);
        sums[i].y = clamp(sums[i].y, -ACC_TYPE_MAX, ACC_TYPE_MAX);
    }
#endif
#endif

    const uint dr = ir * BM + warp_r * WM;
    const uint dc = ic * BN + warp_c * WN;

#ifndef MUL_MAT_ID
    const uint offsets = batch_idx * p.batch_stride_d + ik * p.batch_stride_d * p.num_batches;
#endif

#ifdef COOPMAT
#ifdef MUL_MAT_ID
    [[unroll]] for (uint cm_row = 0; cm_row < cms_per_row; cm_row++) {
        [[unroll]] for (uint cm_col = 0; cm_col < cms_per_col; cm_col++) {
            coopMatStore(sums[cm_col * cms_per_row + cm_row], coopmat_stage, warp_i * TM * TN, TM, gl_CooperativeMatrixLayoutColumnMajor);

            barrier();
            [[unroll]] for (uint col = 0; col < TN; col += storestride) {
                const uint row_i = dc + cm_col * TN + col + store_c;
                if (row_i >= _ne1) break;

                const u16vec2 row_idx = row_ids[row_i - ic * BN];
                if (dr + cm_row * TM + store_r < p.M) {
                    const uint didx = row_idx.y * p.batch_stride_d + row_idx.x * p.stride_d + dr + cm_row * TM + store_r;
#ifdef MMID_SCALE
                    const float sc = (p.fusion_flags & 1u) != 0 ? data_fscale[row_idx.y * p.nei0 + row_idx.x] : 1.0;
                    data_d[didx] = mmid_scaled_store(float(coopmat_stage[warp_i * TM * TN + (col + store_c) * TM + store_r]), sc);
#else
                    if ((p.fusion_flags & 1u) != 0) {
                        data_d[didx] = D_TYPE(float(coopmat_stage[warp_i * TM * TN + (col + store_c) * TM + store_r]) * data_fscale[row_idx.y * p.nei0 + row_idx.x]);
                    } else {
                        data_d[didx] = D_TYPE(coopmat_stage[warp_i * TM * TN + (col + store_c) * TM + store_r]);
                    }
#endif
                }
            }
            barrier();
        }
    }
#else
#ifdef D16
    const bool is_aligned = p.stride_d % 8 == 0;  // 16-byte rows of float16_t
#else
    const bool is_aligned = p.stride_d % 4 == 0;  // Assumption: D_TYPE == float
#endif

    [[unroll]] for (uint cm_row = 0; cm_row < cms_per_row; cm_row++) {
        [[unroll]] for (uint cm_col = 0; cm_col < cms_per_col; cm_col++) {
            const bool is_in_bounds = dr + (cm_row + 1) * TM <= p.M && dc + (cm_col + 1) * TN <= p.N;

            if (is_aligned && is_in_bounds) {
                // Full coopMat is within bounds and stride_d is aligned with 16B
                coopmat<D_TYPE, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> cm_dtype = coopmat<D_TYPE, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(sums[cm_col * cms_per_row + cm_row]);
                coopMatStore(cm_dtype, data_d, offsets + (dc + cm_col * TN) * p.stride_d + dr + cm_row * TM, p.stride_d, gl_CooperativeMatrixLayoutColumnMajor);
            } else if (is_in_bounds) {
                // Full coopMat is within bounds, but stride_d is not aligned
                coopMatStore(sums[cm_col * cms_per_row + cm_row], coopmat_stage, warp_i * TM * TN, TM, gl_CooperativeMatrixLayoutColumnMajor);

                controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
                [[unroll]] for (uint col = 0; col < TN; col += storestride) {
                    data_d[offsets + (dc + cm_col * TN + col + store_c) * p.stride_d + dr + cm_row * TM + store_r] = D_TYPE(coopmat_stage[warp_i * TM * TN + (col + store_c) * TM + store_r]);
                }
                controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
            } else if (dr + cm_row * TM < p.M && dc + cm_col * TN < p.N) {
                // Partial coopMat is within bounds
                coopMatStore(sums[cm_col * cms_per_row + cm_row], coopmat_stage, warp_i * TM * TN, TM, gl_CooperativeMatrixLayoutColumnMajor);

                controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
                [[unroll]] for (uint col = 0; col < TN; col += storestride) {
                    if (dr + cm_row * TM + store_r < p.M && dc + cm_col * TN + col + store_c < p.N) {
                        data_d[offsets + (dc + cm_col * TN + col + store_c) * p.stride_d + dr + cm_row * TM + store_r] = D_TYPE(coopmat_stage[warp_i * TM * TN + (col + store_c) * TM + store_r]);
                    }
                }
                controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
            }
        }
    }
#endif // MUL_MAT_ID
#else
    [[unroll]] for (uint wsic = 0; wsic < WNITER; wsic++) {
        [[unroll]] for (uint wsir = 0; wsir < WMITER; wsir++) {

            const uint dr_warp = dr + wsir * WSUBM + tiwr * TM;
            const uint dc_warp = dc + wsic * WSUBN + tiwc * TN;
            [[unroll]] for (uint cc = 0; cc < TN; cc++) {
#ifdef MUL_MAT_ID
                const uint row_i = dc_warp + cc;
                if (row_i >= _ne1) break;

                const u16vec2 row_idx = row_ids[row_i - ic * BN];
                const bool do_scale = (p.fusion_flags & 1u) != 0;
                const float fscale = do_scale ? data_fscale[row_idx.y * p.nei0 + row_idx.x] : 1.0f;
#endif // MUL_MAT_ID
                [[unroll]] for (uint cr = 0; cr < TM / 2; cr++) {
                    const uint sums_idx = (wsic * TN + cc) * WMITER * (TM / 2) + wsir * (TM / 2) + cr;
#ifdef MUL_MAT_ID
                    if (dr_warp + 2 * cr < p.M) {
                        const uint didx = row_idx.y * p.batch_stride_d + row_idx.x * p.stride_d + dr_warp + 2 * cr;
                        data_d[didx] = do_scale ? D_TYPE(float(sums[sums_idx].x) * fscale) : D_TYPE(sums[sums_idx].x);
                    }
                    if (dr_warp + 2 * cr + 1 < p.M) {
                        const uint didx = row_idx.y * p.batch_stride_d + row_idx.x * p.stride_d + dr_warp + 2 * cr + 1;
                        data_d[didx] = do_scale ? D_TYPE(float(sums[sums_idx].y) * fscale) : D_TYPE(sums[sums_idx].y);
                    }
#else
                    if (dr_warp + 2 * cr < p.M && dc_warp + cc < p.N) {
                        data_d[offsets + (dc_warp + cc) * p.stride_d + dr_warp + 2 * cr] = D_TYPE(sums[sums_idx].x);
                    }
                    if (dr_warp + 2 * cr + 1 < p.M && dc_warp + cc < p.N) {
                        data_d[offsets + (dc_warp + cc) * p.stride_d + dr_warp + 2 * cr + 1] = D_TYPE(sums[sums_idx].y);
                    }
#endif // MUL_MAT_ID
                }
            }
        }
    }
#endif // COOPMAT
}
