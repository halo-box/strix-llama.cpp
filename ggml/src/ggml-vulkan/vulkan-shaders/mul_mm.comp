#if defined(MUL_MAT_ID) && defined(MMID_SCALE)
// MUL_MAT_ID + MUL + CPY(f16) must equal the unfused chain: the product goes through an XOR with a push-constant zero (bit 2 of
// fusion_flags, asserted clear by ggml_vk_matmul_id) so the compiler cannot fold the multiply into the f16 conversion.
D_TYPE mmid_scaled_store(const float acc, const float sc) {
    return D_TYPE(uintBitsToFloat(floatBitsToUint(acc * sc) ^ (p.fusion_flags & 4u)));
}
