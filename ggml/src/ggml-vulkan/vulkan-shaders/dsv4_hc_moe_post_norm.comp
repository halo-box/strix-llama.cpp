#version 450

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require

// qwen4exp MoE epilogue + hyper-connection combine + the next mix's grouped RMS norm, one workgroup per token over all streams:
//
//   x[i, t]          = ((s_0[i, t] + s_1[i, t]) + ... + s_{n-1}[i, t]) + sh[i, t]    (MULTI_ADD of the routed slots, then the
//                                                                                    shared-expert ADD; sh_mode 0: no sh)
//   sh[i, t]         = sigmoid(gate[t]) * down[i, t]                               (sh_mode 2: the shared expert's gate, the
//                                                                                    SIGMOID_MUL in front of the ADD)
//   res_out[i, h, t] = x[i, t] * post[h, t] + res[i, h, t]                          (DSV4_HC_POST, no comb)
//   xn[i, h, t]      = res_out[i, h, t] * rsqrt(mean_i(res_out^2) + eps) * gamma[i, h]   (RMS_NORM + MUL (+ CPY f16))
//   inj[r, t]        = sum_{h, i} w[h * n_embd + i, r] * xn[i, h, t]                (INJ: the next mix's inject MUL_MAT)
//
// The slots are the routed experts' weighted outputs, n of them per token in one tensor (slot k of token t at
// so + k * ss1 + t * ss2 elements), f16 (SLOT_F16) or f32. Every step repeats the unfused chain's arithmetic in its order:
// the f32 running sum from 0 over the slots in the MULTI_ADD's source order, the gated shared expert as SIGMOID_MUL
// computes and stores it, the ADD, then dsv4_hc_post_norm.comp's combine and norm. The norm's per-thread layout and
// reduction are those of the kernel this replaces, so the result is bit-identical to the unfused chain:
//   INJ == 0: dsv4_hc_post_norm.comp (thread j owns the vec4s j, j + 256, ... of each stream row);
//   INJ != 0: dsv4_hc_post_norm_inj.comp (thread j owns the 8-column groups j and j + 256 of each stream).
// The host guarantees n_embd % 4 == 0 (% 8 with INJ), n_embd <= 4096, hc <= 4 (== 4 with INJ), unit element strides,
// 16-byte aligned rows (slot offsets and strides multiples of 4 elements) and zero misalignment on every operand.

layout(constant_id = 0) const uint HAS_POST = 1;   // kept for the pipeline layout; the MoE epilogue always combines
// LOADS_FIRST (GGML_VK_HC_CMB, default on): the routed slots are loaded in batches of SLOT_BATCH before they are summed (one round
// trip per batch instead of one per slot), and every residual row of the token is loaded before the first store. Same values,
// same arithmetic in the same order: bit-identical.
layout(constant_id = 1) const uint LOADS_FIRST = 0;
const uint SLOT_BATCH = 8;

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

const uint BLOCK = 256;
const uint HC_MAX = 4;

#if defined(SLOT_F16)
layout(binding = 0, std430) readonly  buffer SBuf { f16vec4 data_s[]; };
#else
layout(binding = 0, std430) readonly  buffer SBuf { vec4    data_s[]; };
#endif
layout(binding = 1, std430) readonly  buffer HBuf { vec4    data_h[]; };
layout(binding = 2, std430) readonly  buffer RBuf { vec4    data_r[]; };
layout(binding = 3, std430) readonly  buffer PBuf { float   data_p[]; };
layout(binding = 4, std430) readonly  buffer GBuf { vec4    data_g[]; };
layout(binding = 5, std430) writeonly buffer OBuf { vec4    data_o[]; };
#if defined(OUT_F16)
layout(binding = 6, std430) writeonly buffer NBuf { f16vec4 data_n[]; };
#else
layout(binding = 6, std430) writeonly buffer NBuf { vec4    data_n[]; };
#endif
#if defined(INJ)
layout(binding = 7, std430) readonly  buffer WBuf { vec4    data_w[]; };
layout(binding = 8, std430) writeonly buffer IBuf { float   data_i[]; };
layout(binding = 9, std430) readonly  buffer TBuf { float   data_gt[]; };
#else
layout(binding = 7, std430) readonly  buffer TBuf { float   data_gt[]; };
#endif
#if defined(DEFER)
// HC_DEFER: the residual bound at binding 2 is the attention-side combine's residual input; that combine's output (this kernel's
// residual) was not stored, so it is recomputed here from the attention block output and its post weights, with the expression
// dsv4_hc_post_norm_inj.comp evaluates (bit-identical)
layout(binding = 10, std430) readonly buffer XABuf { vec4  data_xa[]; };
layout(binding = 11, std430) readonly buffer PABuf { float data_pa[]; };
#endif

layout(push_constant) uniform parameter {
    uint  n_embd;
    uint  hc;
    uint  n_tokens;
    uint  sx1;             // sh token stride (floats)
    uint  sr1; uint sr2;   // residual stream / token strides (floats)
    uint  sp0; uint sp1;   // post stream / token strides (floats)
    uint  sg1;             // gamma stream stride (floats)
    uint  so1; uint so2;   // res_out stream / token strides (floats)
    uint  sn1; uint sn2;   // xn stream / token strides (elements)
    float eps;
    uint  gate;
    float gate_in;
    float gate_out;
    uint  zero;            // always 0 (the f16 store's XOR operand)
    uint  sw1;             // inject weight row stride (floats; INJ)
    uint  si1;             // inject output token stride (floats; INJ)
    uint  n_slots;
    uint  so;              // slot 0 offset (elements)
    uint  ss1;             // slot stride (elements)
    uint  ss2;             // slot token stride (elements)
    uint  sh_mode;         // 0: no shared expert, 1: sh added, 2: sh = down, gated by sigmoid(gate[t]) first
    uint  sgt;             // gate token stride (floats; sh_mode 2)
#if defined(DEFER)
    uint  sxa1;            // attention block output token stride (floats)
    uint  spa0; uint spa1; // attention post weight stream / token strides (floats)
    uint  gate_a;
    float gate_in_a;
    float gate_out_a;
#endif
} p;

// the shared expert's gate for token t (sh_mode 2): unary.comp's op_sigmoid
float shared_gate(const uint t) {
    return p.sh_mode == 2 ? 1.0f / (1.0f + exp(-data_gt[t * p.sgt])) : 0.0f;
}

// x for the 4 columns at element e of token t: the slot sum, then the shared expert (sg: shared_gate(t))
vec4 moe_x(const uint t, const uint e, const float sg) {
    vec4 s = vec4(0.0f);
    uint sb = p.so + t * p.ss2 + e;
    if (LOADS_FIRST != 0) {
        for (uint k0 = 0; k0 < p.n_slots; k0 += SLOT_BATCH) {
            vec4 l[SLOT_BATCH];
            [[unroll]] for (uint k = 0; k < SLOT_BATCH; ++k) {
                l[k] = k0 + k < p.n_slots ? vec4(data_s[(sb + k * p.ss1) / 4]) : vec4(0.0f);
            }
            [[unroll]] for (uint k = 0; k < SLOT_BATCH; ++k) {
                if (k0 + k < p.n_slots) {
                    s += l[k];
                }
            }
            sb += SLOT_BATCH * p.ss1;
        }
    } else {
        for (uint k = 0; k < p.n_slots; ++k) {
            s += vec4(data_s[sb / 4]);
            sb += p.ss1;
        }
    }
    if (p.sh_mode != 0) {
        vec4 h = data_h[(t * p.sx1 + e) / 4];
        if (p.sh_mode == 2) {
            // SIGMOID_MUL (op on b): sigmoid(gate) * down, rounded to f32 on its own as that kernel stores it; the XOR with a
            // push-constant zero keeps the product from contracting into the ADD below
            h = uintBitsToFloat(floatBitsToUint(sg * h) ^ uvec4(p.zero));
        }
        s = s + h;
    }
    return s;
}

// LOADS_FIRST, INJ: x for the 8 columns at element e of token t, both halves' slot loads of a batch issued together
void moe_x8(const uint t, const uint e, const float sg, out vec4 x0, out vec4 x1) {
    vec4 s0 = vec4(0.0f);
    vec4 s1 = vec4(0.0f);
    uint sb = p.so + t * p.ss2 + e;
    // LOADS_FIRST == 2: the tests' negative control (GGML_VK_HC_CMB_TEST_BREAK=1) drops the last routed slot
    const uint ns = LOADS_FIRST == 2 ? p.n_slots - 1 : p.n_slots;
    for (uint k0 = 0; k0 < ns; k0 += SLOT_BATCH) {
        vec4 l0[SLOT_BATCH];
        vec4 l1[SLOT_BATCH];
        [[unroll]] for (uint k = 0; k < SLOT_BATCH; ++k) {
            const bool ok = k0 + k < ns;
            l0[k] = ok ? vec4(data_s[(sb + k * p.ss1) / 4])     : vec4(0.0f);
            l1[k] = ok ? vec4(data_s[(sb + k * p.ss1) / 4 + 1]) : vec4(0.0f);
        }
        [[unroll]] for (uint k = 0; k < SLOT_BATCH; ++k) {
            if (k0 + k < ns) {
                s0 += l0[k];
                s1 += l1[k];
            }
        }
        sb += SLOT_BATCH * p.ss1;
    }
    if (p.sh_mode != 0) {
        vec4 h0 = data_h[(t * p.sx1 + e) / 4];
        vec4 h1 = data_h[(t * p.sx1 + e + 4) / 4];
        if (p.sh_mode == 2) {
            h0 = uintBitsToFloat(floatBitsToUint(sg * h0) ^ uvec4(p.zero));
            h1 = uintBitsToFloat(floatBitsToUint(sg * h1) ^ uvec4(p.zero));
        }
        s0 = s0 + h0;
        s1 = s1 + h1;
    }
    x0 = s0;
    x1 = s1;
}

#if defined(DEFER)
// the attention-side post weight, as dsv4_hc_post_norm_inj.comp computes it
float post_weight_a(float pw) {
    if (p.gate_a != 0) {
        pw = (1.0f / (1.0f + exp(-(pw * p.gate_in_a)))) * p.gate_out_a;
    }
    return pw;
}
#endif

float post_weight(const uint c, const uint t) {
    float pw = data_p[c * p.sp0 + t * p.sp1];
    if (p.gate != 0) {
        pw = (1.0f / (1.0f + exp(-(pw * p.gate_in)))) * p.gate_out;
    }
    return pw;
}

#if !defined(INJ)

const uint MAX_V4 = 4;

shared float sumsh[HC_MAX][32];

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint t   = gl_WorkGroupID.x;
    const uint nv4 = p.n_embd / 4;

    const float sg = shared_gate(t);
    vec4 xv[MAX_V4];
    [[unroll]] for (uint k = 0; k < MAX_V4; ++k) {
        const uint i4 = tid + k * BLOCK;
        xv[k] = i4 < nv4 ? moe_x(t, i4 * 4, sg) : vec4(0.0f);
    }

    vec4 v[HC_MAX][MAX_V4];
    if (LOADS_FIRST != 0) {
        [[unroll]] for (uint c = 0; c < HC_MAX; ++c) {
            const uint rb = (c * p.sr1 + t * p.sr2) / 4;
            [[unroll]] for (uint k = 0; k < MAX_V4; ++k) {
                const uint i4 = tid + k * BLOCK;
                v[c][k] = c < p.hc && i4 < nv4 ? data_r[rb + i4] : vec4(0.0f);
            }
        }
    }
    [[unroll]] for (uint c = 0; c < HC_MAX; ++c) {
        if (c >= p.hc) {
            break;
        }
        const float pw = post_weight(c, t);
        const uint rb = (c * p.sr1 + t * p.sr2) / 4;
        const uint ob = (c * p.so1 + t * p.so2) / 4;
        float sum = 0.0f;
        [[unroll]] for (uint k = 0; k < MAX_V4; ++k) {
            const uint i4 = tid + k * BLOCK;
            vec4 r = vec4(0.0f);
            if (i4 < nv4) {
                r = LOADS_FIRST != 0 ? v[c][k] : data_r[rb + i4];
                r = xv[k] * pw + r;
                data_o[ob + i4] = r;
            }
            v[c][k] = r;
            sum += dot(r, r);
        }
        // dsv4_hc_post_norm.comp's row reduction: subgroup partials, then the subgroups in order
        sum = subgroupAdd(sum);
        if (gl_SubgroupInvocationID == 0) {
            sumsh[c][gl_SubgroupID] = sum;
        }
    }
    barrier();

    [[unroll]] for (uint c = 0; c < HC_MAX; ++c) {
        if (c >= p.hc) {
            break;
        }
        float total = 0.0f;
        for (uint s = 0; s < gl_NumSubgroups; ++s) {
            total += sumsh[c][s];
        }
        const float scale = inversesqrt(total / float(p.n_embd) + p.eps);
        const uint gb = (c * p.sg1) / 4;
        const uint nb = (c * p.sn1 + t * p.sn2) / 4;
        [[unroll]] for (uint k = 0; k < MAX_V4; ++k) {
            const uint i4 = tid + k * BLOCK;
            if (i4 < nv4) {
                const vec4 n = v[c][k] * scale * data_g[gb + i4];
#if defined(OUT_F16)
                // equal to the f32 norm stored, then CPY: the XOR with a push-constant zero keeps the multiply and the
                // conversion two separately rounded operations
                data_n[nb + i4] = f16vec4(uintBitsToFloat(floatBitsToUint(n) ^ uvec4(p.zero)));
#else
                data_n[nb + i4] = n;
#endif
            }
        }
    }
}

#else // INJ

const uint HC = 4;
const uint NG = 2;   // 8-column groups per thread

shared float sumsh[HC][32];
shared float injsh[HC][32];

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint t   = gl_WorkGroupID.x;
    const uint ng  = p.n_embd / 8;

    const float sg = shared_gate(t);
    vec4 a[HC][NG][2];
    if (LOADS_FIRST != 0) {
        [[unroll]] for (uint c = 0; c < HC; ++c) {
            [[unroll]] for (uint g = 0; g < NG; ++g) {
                const uint e4 = (tid + g * BLOCK) * 2;
                a[c][g][0] = vec4(0.0f);
                a[c][g][1] = vec4(0.0f);
                if (tid + g * BLOCK < ng) {
                    const uint rb = (c * p.sr1 + t * p.sr2) / 4 + e4;
                    a[c][g][0] = data_r[rb];
                    a[c][g][1] = data_r[rb + 1];
                }
            }
        }
    }
#if defined(DEFER)
    // the recompute's inputs, loaded with the residual rows, ahead of the slot sums
    vec4 xa[NG][2];
    [[unroll]] for (uint g = 0; g < NG; ++g) {
        const uint e4 = (tid + g * BLOCK) * 2;
        xa[g][0] = vec4(0.0f);
        xa[g][1] = vec4(0.0f);
        if (tid + g * BLOCK < ng) {
            const uint xb = (t * p.sxa1) / 4 + e4;
            xa[g][0] = data_xa[xb];
            xa[g][1] = data_xa[xb + 1];
        }
    }
    float pwa_raw[HC];
    [[unroll]] for (uint c = 0; c < HC; ++c) {
        pwa_raw[c] = data_pa[c * p.spa0 + t * p.spa1];
    }
#endif
    vec4 xv[NG][2];
    [[unroll]] for (uint g = 0; g < NG; ++g) {
        const uint e = (tid + g * BLOCK) * 8;
        xv[g][0] = vec4(0.0f);
        xv[g][1] = vec4(0.0f);
        if (tid + g * BLOCK < ng) {
            if (LOADS_FIRST != 0) {
                moe_x8(t, e, sg, xv[g][0], xv[g][1]);
            } else {
                xv[g][0] = moe_x(t, e, sg);
                xv[g][1] = moe_x(t, e + 4, sg);
            }
        }
    }
    float ss[HC];
    [[unroll]] for (uint c = 0; c < HC; ++c) {
        const float pw = post_weight(c, t);
#if defined(DEFER)
        const float pwa = post_weight_a(pwa_raw[c]);
#endif
        ss[c] = 0.0f;
        [[unroll]] for (uint g = 0; g < NG; ++g) {
            const uint e4 = (tid + g * BLOCK) * 2;
            vec4 r0 = vec4(0.0f);
            vec4 r1 = vec4(0.0f);
            if (tid + g * BLOCK < ng) {
                const uint rb = (c * p.sr1 + t * p.sr2) / 4 + e4;
                r0 = LOADS_FIRST != 0 ? a[c][g][0] : data_r[rb];
                r1 = LOADS_FIRST != 0 ? a[c][g][1] : data_r[rb + 1];
#if defined(DEFER)
                // the attention-side combine (dsv4_hc_post_norm_inj.comp: r = xv * pw + r)
                r0 = xa[g][0] * pwa + r0;
                r1 = xa[g][1] * pwa + r1;
#endif
                r0 = xv[g][0] * pw + r0;
                r1 = xv[g][1] * pw + r1;
                const uint ob = (c * p.so1 + t * p.so2) / 4 + e4;
                data_o[ob]     = r0;
                data_o[ob + 1] = r1;
            }
            a[c][g][0] = r0;
            a[c][g][1] = r1;
            ss[c] += dot(r0, r0) + dot(r1, r1);
        }
    }

    // dsv4_hc_post_norm_inj.comp's reduction: the four stream sums, subgroup partials, then the subgroups in order
    [[unroll]] for (uint c = 0; c < HC; ++c) {
        const float s = subgroupAdd(ss[c]);
        if (gl_SubgroupInvocationID == 0) {
            sumsh[c][gl_SubgroupID] = s;
        }
    }
    barrier();

    vec4 inj = vec4(0.0f);
    [[unroll]] for (uint c = 0; c < HC; ++c) {
        float total = 0.0f;
        for (uint s = 0; s < gl_NumSubgroups; ++s) {
            total += sumsh[c][s];
        }
        const float scale = inversesqrt(total / float(p.n_embd) + p.eps);
        [[unroll]] for (uint g = 0; g < NG; ++g) {
            if (tid + g * BLOCK >= ng) {
                continue;
            }
            const uint e4 = (tid + g * BLOCK) * 2;
            const uint gb = (c * p.sg1) / 4 + e4;
            const uint nb = (c * p.sn1 + t * p.sn2) / 4 + e4;
            [[unroll]] for (uint k = 0; k < 2; ++k) {
                const vec4 n = a[c][g][k] * scale * data_g[gb + k];
                const f16vec4 n16 = f16vec4(uintBitsToFloat(floatBitsToUint(n) ^ uvec4(p.zero)));
                data_n[nb + k] = n16;
                const vec4 nf = vec4(n16);
                const uint wb = (c * p.n_embd) / 4 + e4 + k;
                [[unroll]] for (uint r = 0; r < HC; ++r) {
                    inj[r] += dot(data_w[(r * p.sw1) / 4 + wb], nf);
                }
            }
        }
    }

    [[unroll]] for (uint r = 0; r < HC; ++r) {
        const float s = subgroupAdd(inj[r]);
        if (gl_SubgroupInvocationID == 0) {
            injsh[r][gl_SubgroupID] = s;
        }
    }
    barrier();
    if (tid < HC) {
        float total = 0.0f;
        for (uint s = 0; s < gl_NumSubgroups; ++s) {
            total += injsh[tid][s];
        }
        data_i[t * p.si1 + tid] = total;
    }
}

#endif
