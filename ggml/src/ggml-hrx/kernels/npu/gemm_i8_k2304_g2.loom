pipeline.def<kernel> public retain target(@npu) @gemm_i8() run(%xarg: buffer, %warg: buffer, %yarg: buffer) {
  %xu, %wu, %yu = buffer.assume.noalias %xarg, %warg, %yarg : buffer, buffer, buffer
  %x, %wt, %y = buffer.assume.alignment %xu, %wu, %yu {minimum_alignment = 64} : buffer, buffer, buffer
