  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %x_rows = index.constant 128 : index
  %col1 = index.add %col0, %c16 : index
  %row1 = index.add %row0, %c16 : index
  %row2 = index.add %row0, %c32 : index
  %row3 = index.add %row0, %c48 : index
  %t00 = func.call @ggml_mma_tile16(%x_stage, %x_rows, %w_stage, %col0, %row0, %acc00) : (buffer, index, buffer, index, index, vector<8xf32>) -> (vector<8xf32>)
