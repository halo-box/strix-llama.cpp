  %r0_0 = vector.fragment.load<rhs> %w_view[%kh0, %row0] shape [%m, %m] : view<64x128xf16, %w_layout> -> vector<16xf16>
  %n00_0 = vector.mma %l0_0, %r0_0, %acc00 : vector<16xf16>, vector<16xf16>, vector<8xf32>
