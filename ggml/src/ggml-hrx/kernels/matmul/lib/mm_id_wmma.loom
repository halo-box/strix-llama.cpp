// Parts of the 128 x 128 MUL_MAT_ID matrix-op kernel (matmul/mul_mat_id_wmma.loom).
// x_stage holds [col][k] f16 rows with a pitch of 72. w_stage holds [k][row] f16 with a row pitch of 72 (128 rows).

target.decl @ggml_gfx11
target.decl @ggml_gfx12

template.decl @ggml.q8_0.decode32_f16(%d_bits: i16, %q0: vector<8xi16>, %q1: vector<8xi16>) -> (vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>)

func.decl @ggml_mma_lhs_lane_gfx12() -> (index, index)

func.decl @ggml_mma_tile16(%x_stage: buffer, %x_rows: index, %w_stage: buffer, %col: index, %row: index, %acc: vector<8xf32>) -> (vector<8xf32>)

// 2 x 4 tiles of 16 x 16 for each subgroup: columns col0 to col0+31, rows row0 to row0+63.
template.decl @ggml.mma.k64_2x4(%x_stage: buffer, %w_stage: buffer, %col0: index, %row0: index, %acc00: vector<8xf32>, %acc01: vector<8xf32>, %acc02: vector<8xf32>, %acc03: vector<8xf32>, %acc10: vector<8xf32>, %acc11: vector<8xf32>, %acc12: vector<8xf32>, %acc13: vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>)

