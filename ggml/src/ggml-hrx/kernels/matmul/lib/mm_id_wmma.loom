template.def<@ggml.mma.k64_2x4> device target(@ggml_gfx12) requires [#target.subgroup.size<32>] priority(20) @ggml_mma_k64_2x4_gfx12(%x_stage: buffer, %w_stage: buffer, %col0: index, %row0: index, %acc00: vector<8xf32>, %acc01: vector<8xf32>, %acc02: vector<8xf32>, %acc03: vector<8xf32>, %acc10: vector<8xf32>, %acc11: vector<8xf32>, %acc12: vector<8xf32>, %acc13: vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
  %c0 = index.constant 0 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c0_offset = index.constant 0 : offset
  %m = index.constant 16 : index
  %w_layout = encoding.layout.strided [1, 72] : encoding<layout>
  %x_view = buffer.view %x_stage[%c0_offset] : buffer -> view<128x72xf16>
  %w_view = buffer.view %w_stage[%c0_offset] : buffer -> view<64x128xf16, %w_layout>
  %lane_row, %lane_k = func.call @ggml_mma_lhs_lane_gfx12() : () -> (index, index)
  %x_row0 = index.add %col0, %lane_row : index
  %x_row1 = index.add %x_row0, %c16 : index
  %row1 = index.add %row0, %c16 : index
  %row2 = index.add %row0, %c32 : index
  %row3 = index.add %row0, %c48 : index
  %r00, %r01, %r02, %r03, %r10, %r11, %r12, %r13 = scf.for %kh = [%c0 to %c64 step %c16](%a00 = %acc00 : vector<8xf32>, %a01 = %acc01 : vector<8xf32>, %a02 = %acc02 : vector<8xf32>, %a03 = %acc03 : vector<8xf32>, %a10 = %acc10 : vector<8xf32>, %a11 = %acc11 : vector<8xf32>, %a12 = %acc12 : vector<8xf32>, %a13 = %acc13 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) unroll {
    %xk = index.add %kh, %lane_k : index
    %x0 = vector.load %x_view[%x_row0, %xk] : view<128x72xf16> -> vector<8xf16>
    %x1 = vector.load %x_view[%x_row1, %xk] : view<128x72xf16> -> vector<8xf16>
    %lhs0 = vector.fragment<lhs> %x0 shape [%m, %m] : vector<8xf16>
    %lhs1 = vector.fragment<lhs> %x1 shape [%m, %m] : vector<8xf16>
    %rhs0 = vector.fragment.load<rhs> %w_view[%kh, %row0] shape [%m, %m] : view<64x128xf16, %w_layout> -> vector<8xf16>
    %rhs1 = vector.fragment.load<rhs> %w_view[%kh, %row1] shape [%m, %m] : view<64x128xf16, %w_layout> -> vector<8xf16>
    %rhs2 = vector.fragment.load<rhs> %w_view[%kh, %row2] shape [%m, %m] : view<64x128xf16, %w_layout> -> vector<8xf16>
    %rhs3 = vector.fragment.load<rhs> %w_view[%kh, %row3] shape [%m, %m] : view<64x128xf16, %w_layout> -> vector<8xf16>
    %n00 = vector.mma %lhs0, %rhs0, %a00 : vector<8xf16>, vector<8xf16>, vector<8xf32>
    %n10 = vector.mma %lhs1, %rhs0, %a10 : vector<8xf16>, vector<8xf16>, vector<8xf32>
    %n01 = vector.mma %lhs0, %rhs1, %a01 : vector<8xf16>, vector<8xf16>, vector<8xf32>
    %n11 = vector.mma %lhs1, %rhs1, %a11 : vector<8xf16>, vector<8xf16>, vector<8xf32>
    %n02 = vector.mma %lhs0, %rhs2, %a02 : vector<8xf16>, vector<8xf16>, vector<8xf32>
    %n12 = vector.mma %lhs1, %rhs2, %a12 : vector<8xf16>, vector<8xf16>, vector<8xf32>
    %n03 = vector.mma %lhs0, %rhs3, %a03 : vector<8xf16>, vector<8xf16>, vector<8xf32>
    %n13 = vector.mma %lhs1, %rhs3, %a13 : vector<8xf16>, vector<8xf16>, vector<8xf32>
    scf.yield %n00, %n01, %n02, %n03, %n10, %n11, %n12, %n13 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  template.return %r00, %r01, %r02, %r03, %r10, %r11, %r12, %r13 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
}

template.def<@ggml.mma.k64_2x4> device requires [#target.subgroup.size<32>] priority(1) @ggml_mma_k64_2x4(%x_stage: buffer, %w_stage: buffer, %col0: index, %row0: index, %acc00: vector<8xf32>, %acc01: vector<8xf32>, %acc02: vector<8xf32>, %acc03: vector<8xf32>, %acc10: vector<8xf32>, %acc11: vector<8xf32>, %acc12: vector<8xf32>, %acc13: vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
