  %r2_0 = vector.fragment.load<rhs> %w_view[%kh0, %row2] shape [%m, %m] : view<64x128xf16, %w_layout> -> vector<16xf16>
  %n02_0 = vector.mma %l0_0, %r2_0, %acc02 : vector<16xf16>, vector<16xf16>, vector<8xf32>
