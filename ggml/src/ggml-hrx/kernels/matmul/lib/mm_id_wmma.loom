  %l0_3 = vector.fragment.load<lhs> %x_view[%col0, %kh3] shape [%m, %m] : view<128x72xf16> -> vector<16xf16>
  %l1_3 = vector.fragment.load<lhs> %x_view[%col1, %kh3] shape [%m, %m] : view<128x72xf16> -> vector<16xf16>
