  %l1_2 = vector.fragment.load<lhs> %x_view[%col1, %kh2] shape [%m, %m] : view<128x72xf16> -> vector<16xf16>
  %r0_2 = vector.fragment.load<rhs> %w_view[%kh2, %row0] shape [%m, %m] : view<64x128xf16, %w_layout> -> vector<16xf16>
  %n00_2 = vector.mma %l0_2, %r0_2, %n00_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
  %n10_2 = vector.mma %l1_2, %r0_2, %n10_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
  %r1_2 = vector.fragment.load<rhs> %w_view[%kh2, %row1] shape [%m, %m] : view<64x128xf16, %w_layout> -> vector<16xf16>
  %n01_2 = vector.mma %l0_2, %r1_2, %n01_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
  %n11_2 = vector.mma %l1_2, %r1_2, %n11_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
