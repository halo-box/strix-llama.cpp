// Weights and activations are rounded to f16. The sums are in f32.
// The launch arguments are the same as in mul_mat.loom. The caller makes sure that K is a multiple of 32 and that x_s0 is 1.

config.decl @ggml.mul_mat.weight_type : %value: index where [range(%value, 1, 4)]

target.decl @ggml_wave32

template.decl @ggml.mma.k64_2x2(%x_stage: buffer, %w_stage: buffer, %col0: index, %row0: index, %acc00: vector<8xf32>, %acc01: vector<8xf32>, %acc10: vector<8xf32>, %acc11: vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>)

template.decl @ggml.mma.zero_acc() -> (vector<8xf32>)

func.decl @ggml_hrx_mm_wmma_stage_weights64(%wtype: index, %weight: buffer, %w_span: index, %row_base: index, %row_valid: i1, %k: index, %k_size: index, %w_stage: buffer)

func.decl @ggml_hrx_mm_wmma_stage_input64(%input: buffer, %x_span: index, %col_base: index, %col_valid: i1, %k: index, %k_size: index, %x_stage: buffer)

func.decl @ggml_hrx_mm_wmma_store(%dst: buffer, %d_span: index, %d_base: index, %d_s1: index, %col0: index, %n_cols: index, %row0: index, %n_rows: index, %acc: vector<8xf32>)

kernel.def target(@ggml_wave32) export("ggml_mul_mat_wmma") @ggml_mul_mat_wmma(%n_rows: index, %n_cols: index, %n_batch: index) {
  %one = index.constant 1 : index
  %wg_size = index.constant 256 : index
  %c63 = index.constant 63 : index
  %c64 = index.constant 64 : index
  %c127 = index.constant 127 : index
  %c128 = index.constant 128 : index
  %rows_round = index.add %n_rows, %c127 : index
  %row_tiles = index.div %rows_round, %c128 : index
  %cols_round = index.add %n_cols, %c63 : index
  %col_tiles = index.div %cols_round, %c64 : index
  kernel.launch.config workgroups(%row_tiles, %col_tiles, %n_batch) workgroup_size(%wg_size, %one, %one) : index
} launch(%k_size_in: index, %n_rows_in: index, %n_cols_in: index, %ne12_in: index, %r2_in: index, %r3_in: index, %w_s1_in: index, %w_s2_in: index, %w_s3_in: index, %w_span_in: index, %x_s0_in: index, %x_s1_in: index, %x_s2_in: index, %x_s3_in: index, %x_span_in: index, %d_s1_in: index, %d_s2_in: index, %d_s3_in: index, %d_span_in: index, %weight: buffer, %input: buffer, %dst: buffer) {
  // supports_mul_mat checks these ranges.
  %k_size = index.assume %k_size_in [range(%k_size_in, 1, 2147483647)] : index
  %n_rows = index.assume %n_rows_in [range(%n_rows_in, 1, 2147483647)] : index
  %n_cols = index.assume %n_cols_in [range(%n_cols_in, 1, 2147483647)] : index
  %ne12 = index.assume %ne12_in [range(%ne12_in, 1, 2147483647)] : index
  %r2 = index.assume %r2_in [range(%r2_in, 1, 2147483647)] : index
  %r3 = index.assume %r3_in [range(%r3_in, 1, 2147483647)] : index
  %w_s1 = index.assume %w_s1_in [range(%w_s1_in, 0, 2147483647)] : index
  %w_s2 = index.assume %w_s2_in [range(%w_s2_in, 0, 2147483647)] : index
  %w_s3 = index.assume %w_s3_in [range(%w_s3_in, 0, 2147483647)] : index
  %w_span = index.assume %w_span_in [range(%w_span_in, 1, 2147483647)] : index
  %x_s1 = index.assume %x_s1_in [range(%x_s1_in, 0, 2147483647)] : index
  %x_s2 = index.assume %x_s2_in [range(%x_s2_in, 0, 2147483647)] : index
  %x_s3 = index.assume %x_s3_in [range(%x_s3_in, 0, 2147483647)] : index
  %x_span = index.assume %x_span_in [range(%x_span_in, 1, 2147483647)] : index
  %d_s1 = index.assume %d_s1_in [range(%d_s1_in, 0, 2147483647)] : index
  %d_s2 = index.assume %d_s2_in [range(%d_s2_in, 0, 2147483647)] : index
  %d_s3 = index.assume %d_s3_in [range(%d_s3_in, 0, 2147483647)] : index
  %d_span = index.assume %d_span_in [range(%d_span_in, 1, 2147483647)] : index
  %wtype = config.get @ggml.mul_mat.weight_type : index
  %c0 = index.constant 0 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %w_stage_bytes = index.constant 18432 : offset
  %x_stage_bytes = index.constant 9216 : offset
  %t0 = kernel.workitem.id<x> : index
  %t = index.assume %t0 [range(%t0, 0, 255)] : index
  %s0 = kernel.subgroup.id : index
  %s = index.assume %s0 [range(%s0, 0, 7)] : index
  %row_tile = kernel.workgroup.id<x> : index
  %col_tile = kernel.workgroup.id<y> : index
  %batch = kernel.workgroup.id<z> : index
  %weight_noalias, %input_noalias, %dst_noalias = buffer.assume.noalias %weight, %input, %dst : buffer, buffer, buffer
  %w_stage = buffer.alloca<workgroup> align(16) %w_stage_bytes : buffer
  %x_stage = buffer.alloca<workgroup> align(16) %x_stage_bytes : buffer

  %i12 = index.rem %batch, %ne12 : index
  %i13 = index.div %batch, %ne12 : index
  %i02 = index.div %i12, %r2 : index
  %i03 = index.div %i13, %r3 : index
  %w2 = index.mul %i02, %w_s2 : index
  %w3 = index.mul %i03, %w_s3 : index
  %w_batch = index.add %w2, %w3 : index
  %x2 = index.mul %i12, %x_s2 : index
  %x3 = index.mul %i13, %x_s3 : index
  %x_batch = index.add %x2, %x3 : index
  %d2 = index.mul %i12, %d_s2 : index
  %d3 = index.mul %i13, %d_s3 : index
  %d_batch = index.add %d2, %d3 : index
  %tile_row0 = index.mul %row_tile, %c128 : index
  %tile_col0 = index.mul %col_tile, %c64 : index

  %w_local = index.div %t, %c2 : index
  %w_row = index.add %tile_row0, %w_local : index
  %w_valid = index.cmp ult, %w_row, %n_rows : index
  %w_offset = index.mul %w_row, %w_s1 : index
  %w_base = index.add %w_batch, %w_offset : index

  %x_local = index.div %t, %c4 : index
  %x_col = index.add %tile_col0, %x_local : index
  %x_valid = index.cmp ult, %x_col, %n_cols : index
  %x_offset = index.mul %x_col, %x_s1 : index
  %x_base = index.add %x_batch, %x_offset : index

  %sub_col_group = index.rem %s, %c2 : index
  %sub_row_group = index.div %s, %c2 : index
  %sub_col0 = index.mul %sub_col_group, %c32 : index
  %sub_row0 = index.mul %sub_row_group, %c32 : index

  %init = template.apply<@ggml.mma.zero_acc>() : () -> (vector<8xf32>)
  %acc00, %acc01, %acc10, %acc11 = scf.for %k0 = [%c0 to %k_size step %c64](%a00 = %init : vector<8xf32>, %a01 = %init : vector<8xf32>, %a10 = %init : vector<8xf32>, %a11 = %init : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    func.call @ggml_hrx_mm_wmma_stage_weights64(%wtype, %weight_noalias, %w_span, %w_base, %w_valid, %k0, %k_size, %w_stage) : (index, buffer, index, index, i1, index, index, buffer)
    func.call @ggml_hrx_mm_wmma_stage_input64(%input_noalias, %x_span, %x_base, %x_valid, %k0, %k_size, %x_stage) : (buffer, index, index, i1, index, index, buffer)
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %n00, %n01, %n10, %n11 = template.apply<@ggml.mma.k64_2x2>(%x_stage, %w_stage, %sub_col0, %sub_row0, %a00, %a01, %a10, %a11) : (buffer, buffer, index, index, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>)
    // The next K step overwrites the stages.
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %n00, %n01, %n10, %n11 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }

  %out_col0 = index.add %tile_col0, %sub_col0 : index
  %out_col1 = index.add %out_col0, %c16 : index
  %out_row0 = index.add %tile_row0, %sub_row0 : index
  %out_row1 = index.add %out_row0, %c16 : index
  func.call @ggml_hrx_mm_wmma_store(%dst_noalias, %d_span, %d_batch, %d_s1, %out_col0, %n_cols, %out_row0, %n_rows, %acc00) : (buffer, index, index, index, index, index, index, index, vector<8xf32>)
  func.call @ggml_hrx_mm_wmma_store(%dst_noalias, %d_span, %d_batch, %d_s1, %out_col0, %n_cols, %out_row1, %n_rows, %acc01) : (buffer, index, index, index, index, index, index, index, vector<8xf32>)
  func.call @ggml_hrx_mm_wmma_store(%dst_noalias, %d_span, %d_batch, %d_s1, %out_col1, %n_cols, %out_row0, %n_rows, %acc10) : (buffer, index, index, index, index, index, index, index, vector<8xf32>)
  func.call @ggml_hrx_mm_wmma_store(%dst_noalias, %d_span, %d_batch, %d_s1, %out_col1, %n_cols, %out_row1, %n_rows, %acc11) : (buffer, index, index, index, index, index, index, index, vector<8xf32>)
  kernel.return
}

// Up to 32 rows of F16 weights and 64 input columns for each workgroup of 4 waves: wave s takes columns 16 s and both 16-row
// tiles. The global loads of the next K step overlap the matrix ops. The sums are in the same order as in ggml_mul_mat_wmma.
// The caller makes sure that K is a multiple of 64 and the rows of x are 16-byte aligned. Rows and columns past the last one
// read the last one. Their results are not stored.
kernel.def target(@ggml_wave32) export("ggml_mul_mat_wmma_r32") @ggml_mul_mat_wmma_r32(%n_rows: index, %n_cols: index, %n_batch: index) {
  %one = index.constant 1 : index
  %wg_size = index.constant 128 : index
  %c63 = index.constant 63 : index
  %c64 = index.constant 64 : index
  %cols_round = index.add %n_cols, %c63 : index
  %col_tiles = index.div %cols_round, %c64 : index
  kernel.launch.config workgroups(%one, %col_tiles, %n_batch) workgroup_size(%wg_size, %one, %one) : index
} launch(%k_size_in: index, %n_rows_in: index, %n_cols_in: index, %ne12_in: index, %r2_in: index, %r3_in: index, %w_s1_in: index, %w_s2_in: index, %w_s3_in: index, %w_span_in: index, %x_s0_in: index, %x_s1_in: index, %x_s2_in: index, %x_s3_in: index, %x_span_in: index, %d_s1_in: index, %d_s2_in: index, %d_s3_in: index, %d_span_in: index, %weight: buffer, %input: buffer, %dst: buffer) {
  %k_size = index.assume %k_size_in [range(%k_size_in, 64, 2147483647), multiple_of(%k_size_in, 64)] : index
  %n_rows = index.assume %n_rows_in [range(%n_rows_in, 1, 32)] : index
  %n_cols = index.assume %n_cols_in [range(%n_cols_in, 1, 2147483647)] : index
  %ne12 = index.assume %ne12_in [range(%ne12_in, 1, 2147483647)] : index
  %r2 = index.assume %r2_in [range(%r2_in, 1, 2147483647)] : index
  %r3 = index.assume %r3_in [range(%r3_in, 1, 2147483647)] : index
  %w_s1 = index.assume %w_s1_in [range(%w_s1_in, 0, 2147483647), multiple_of(%w_s1_in, 8)] : index
  %w_s2 = index.assume %w_s2_in [range(%w_s2_in, 0, 2147483647)] : index
  %w_s3 = index.assume %w_s3_in [range(%w_s3_in, 0, 2147483647)] : index
  %x_s1 = index.assume %x_s1_in [range(%x_s1_in, 0, 2147483647), multiple_of(%x_s1_in, 4)] : index
  %x_s2 = index.assume %x_s2_in [range(%x_s2_in, 0, 2147483647)] : index
  %x_s3 = index.assume %x_s3_in [range(%x_s3_in, 0, 2147483647)] : index
  %d_s1 = index.assume %d_s1_in [range(%d_s1_in, 0, 2147483647)] : index
  %d_s2 = index.assume %d_s2_in [range(%d_s2_in, 0, 2147483647)] : index
  %d_s3 = index.assume %d_s3_in [range(%d_s3_in, 0, 2147483647)] : index
  %d_span = index.assume %d_span_in [range(%d_span_in, 1, 2147483647)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c64 = index.constant 64 : index
  %c0_offset = index.constant 0 : offset
  %two = index.constant 2 : offset
  %four = index.constant 4 : offset
  %t0 = kernel.workitem.id<x> : index
  %t = index.assume %t0 [range(%t0, 0, 127)] : index
  %s0 = kernel.subgroup.id : index
  %s = index.assume %s0 [range(%s0, 0, 3)] : index
  %lane0 = kernel.subgroup.lane.id : index
  %lane = index.assume %lane0 [range(%lane0, 0, 31)] : index
  %col_tile = kernel.workgroup.id<y> : index
  %batch = kernel.workgroup.id<z> : index
  %weight_noalias, %input_noalias, %dst_noalias = buffer.assume.noalias %weight, %input, %dst : buffer, buffer, buffer
  %x_stage_bytes = index.constant 9216 : offset
  %w_stage_bytes = index.constant 4608 : offset
  %x_stage = buffer.alloca<workgroup> align(16) %x_stage_bytes : buffer
  %w_stage = buffer.alloca<workgroup> align(16) %w_stage_bytes : buffer
  %x_view = buffer.view %x_stage[%c0_offset] : buffer -> view<64x72xf16>
  %w_view = buffer.view %w_stage[%c0_offset] : buffer -> view<32x72xf16>

  %i12 = index.rem %batch, %ne12 : index
  %i13 = index.div %batch, %ne12 : index
  %i02 = index.div %i12, %r2 : index
  %i03 = index.div %i13, %r3 : index
  %w2 = index.mul %i02, %w_s2 : index
  %w3 = index.mul %i03, %w_s3 : index
  %w_batch = index.add %w2, %w3 : index
  %x2 = index.mul %i12, %x_s2 : index
  %x3 = index.mul %i13, %x_s3 : index
  %x_batch = index.add %x2, %x3 : index
  %d2 = index.mul %i12, %d_s2 : index
  %d3 = index.mul %i13, %d_s3 : index
  %d_batch = index.add %d2, %d3 : index
  %tile_col0 = index.mul %col_tile, %c64 : index
  %last_col = index.sub %n_cols, %c1 : index
  %last_row = index.sub %n_rows, %c1 : index

  // x: 16 lanes read 64 contiguous K values of a column, columns t / 16 + 8 j. Weights: 4 lanes read 64 K values of row t / 4.
  %x_r = index.div %t, %c16 : index
  %x_c = index.rem %t, %c16 : index
  %x_k = index.mul %x_c, %c4 : index
  %w_r = index.div %t, %c4 : index
  %w_q = index.rem %t, %c4 : index
  %w_k = index.mul %w_q, %c16 : index
  %w_row = index.min %w_r, %last_row : index
  %w_base0 = index.madd %w_row, %w_s1, %w_batch : index
  %w_base = index.add %w_base0, %w_k : index
  %zero_x = vector.splatf 0.0 : vector<8x4xf32>
  %zero_h = vector.splatf 0.0 : vector<16xf16>

  %lane_n = index.rem %lane, %c16 : index
  %n1 = index.add %lane_n, %c16 : index
  %a_row = index.mul %s, %c16 : index
  %init = template.apply<@ggml.mma.zero_acc>() : () -> (vector<8xf32>)
  %k_last = index.sub %k_size, %c64 : index

  %x_first = scf.for %j = [%c0 to %c8 step %c1](%acc = %zero_x : vector<8x4xf32>) -> (vector<8x4xf32>) unroll {
    %row = index.madd %j, %c8, %x_r : index
    %col0 = index.add %tile_col0, %row : index
    %col = index.min %col0, %last_col : index
    %xi0 = index.madd %col, %x_s1, %x_batch : index
    %xi = index.add %xi0, %x_k : index
    %xo = index.scale %xi, %four : index, offset -> offset
    %xv = buffer.view %input_noalias[%xo] : buffer -> view<4xf32>
    %l = vector.load %xv[%c0] : view<4xf32> -> vector<4xf32>
    %n = vector.insert %l into %acc[%j] : vector<4xf32>, vector<8x4xf32>
    scf.yield %n : vector<8x4xf32>
  }
  %wo_first = index.scale %w_base, %two : index, offset -> offset
  %wv_first = buffer.view %weight_noalias[%wo_first] : buffer -> view<16xf16>
  %w_first = vector.load %wv_first[%c0] : view<16xf16> -> vector<16xf16>
  %acc0, %acc1, %xl, %wl = scf.for %k0 = [%c0 to %k_size step %c64](%a0 = %init : vector<8xf32>, %a1 = %init : vector<8xf32>, %cx = %x_first : vector<8x4xf32>, %cw = %w_first : vector<16xf16>) -> (vector<8xf32>, vector<8xf32>, vector<8x4xf32>, vector<16xf16>) {
    scf.for %j = [%c0 to %c8 step %c1] unroll {
      %v4 = vector.extract %cx[%j] : vector<8x4xf32> -> vector<4xf32>
      %h4 = vector.fptrunc %v4 : vector<4xf32> to vector<4xf16>
      %row = index.madd %j, %c8, %x_r : index
      vector.store %h4, %x_view[%row, %x_k] : vector<4xf16>, view<64x72xf16>
    }
    vector.store %cw, %w_view[%w_r, %w_k] : vector<16xf16>, view<32x72xf16>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    // The loads of the last step read its own K range again. Their values are not used.
    %k_next_raw = index.add %k0, %c64 : index
    %k_next = index.min %k_next_raw, %k_last : index
    %xn = scf.for %j = [%c0 to %c8 step %c1](%acc = %zero_x : vector<8x4xf32>) -> (vector<8x4xf32>) unroll {
      %row = index.madd %j, %c8, %x_r : index
      %col0 = index.add %tile_col0, %row : index
      %col = index.min %col0, %last_col : index
      %xi0 = index.madd %col, %x_s1, %x_batch : index
      %xi1 = index.add %xi0, %x_k : index
      %xi = index.add %xi1, %k_next : index
      %xo = index.scale %xi, %four : index, offset -> offset
      %xv = buffer.view %input_noalias[%xo] : buffer -> view<4xf32>
      %l = vector.load %xv[%c0] : view<4xf32> -> vector<4xf32>
      %n = vector.insert %l into %acc[%j] : vector<4xf32>, vector<8x4xf32>
      scf.yield %n : vector<8x4xf32>
    }
    %wi = index.add %w_base, %k_next : index
    %wo = index.scale %wi, %two : index, offset -> offset
    %wv = buffer.view %weight_noalias[%wo] : buffer -> view<16xf16>
    %wn = vector.load %wv[%c0] : view<16xf16> -> vector<16xf16>
    %r0, %r1 = scf.for %kh = [%c0 to %c64 step %c16](%b0 = %a0 : vector<8xf32>, %b1 = %a1 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>) unroll {
      %lhs = vector.fragment.load<lhs> %x_view[%a_row, %kh] shape [%c16, %c16] : view<64x72xf16> -> vector<16xf16>
      %v0 = vector.load %w_view[%lane_n, %kh] : view<32x72xf16> -> vector<16xf16>
      %v1 = vector.load %w_view[%n1, %kh] : view<32x72xf16> -> vector<16xf16>
      %f0 = vector.fragment<rhs> %v0 shape [%c16, %c16] : vector<16xf16>
      %f1 = vector.fragment<rhs> %v1 shape [%c16, %c16] : vector<16xf16>
      %d0 = vector.mma %lhs, %f0, %b0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %d1 = vector.mma %lhs, %f1, %b1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      scf.yield %d0, %d1 : vector<8xf32>, vector<8xf32>
    }
    // The next K step overwrites the stages.
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %r0, %r1, %xn, %wn : vector<8xf32>, vector<8xf32>, vector<8x4xf32>, vector<16xf16>
  }

  %out_col = index.add %tile_col0, %a_row : index
  func.call @ggml_hrx_mm_wmma_store(%dst_noalias, %d_span, %d_batch, %d_s1, %out_col, %n_cols, %c0, %n_rows, %acc0) : (buffer, index, index, index, index, index, index, index, vector<8xf32>)
  func.call @ggml_hrx_mm_wmma_store(%dst_noalias, %d_span, %d_batch, %d_s1, %out_col, %n_cols, %c16, %n_rows, %acc1) : (buffer, index, index, index, index, index, index, index, vector<8xf32>)
  kernel.return
}
