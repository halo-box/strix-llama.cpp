// The load clamps the index into the span. Callers do not use a value from a clamped index.
func.def inline @ggml_hrx_mtf_load4(%wtype: index, %buf: buffer, %span: index, %index: index) -> (vector<4xf32>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c0_offset = index.constant 0 : offset
  %span4 = index.assume %span [range(%span, 4, 2147483647)] : index
  %span_last = index.sub %span4, %c4 : index
  %limit0 = index.sub %span4, %c3 : index
  %index_bounded = index.assume %index [range(%index, 0, 2147483646)] : index
  %clamped0 = index.min %index_bounded, %span_last : index
  %clamped, %limit = index.assume %clamped0, %limit0 [lt(%clamped0, %limit0)] : index, index
  %extent = index.add %limit, %c3 : index
  %is_f32 = index.cmp eq, %wtype, %c0 : index
  %is_f16 = index.cmp eq, %wtype, %c1 : index
  %values = scf.if %is_f32 -> (vector<4xf32>) {
    %view = buffer.view %buf[%c0_offset] : buffer -> view<[%extent]xf32>
    %v = vector.load %view[%clamped] : view<[%extent]xf32> -> vector<4xf32>
    scf.yield %v : vector<4xf32>
  } else {
    %h = scf.if %is_f16 -> (vector<4xf32>) {
      %view = buffer.view %buf[%c0_offset] : buffer -> view<[%extent]xf16>
      %v = vector.load %view[%clamped] : view<[%extent]xf16> -> vector<4xf16>
      %wide = vector.extf %v : vector<4xf16> to vector<4xf32>
      scf.yield %wide : vector<4xf32>
    } else {
      %view = buffer.view %buf[%c0_offset] : buffer -> view<[%extent]xbf16>
      %v = vector.load %view[%clamped] : view<[%extent]xbf16> -> vector<4xbf16>
      %wide = vector.extf %v : vector<4xbf16> to vector<4xf32>
      scf.yield %wide : vector<4xf32>
    }
    scf.yield %h : vector<4xf32>
  }
  func.return %values : vector<4xf32>
}

// 4 K values from k of a row or column. The caller zeroes a value past the row count or past K when it stages it.
func.def inline @ggml_hrx_mtf_fetch(%wtype: index, %buf: buffer, %span: index, %base: index, %k: index) -> (vector<4xf32>) {
  %index = index.add %base, %k : index
