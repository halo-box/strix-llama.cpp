  %col_valid = index.cmp ult, %col, %n_cols : index
  %ok = scalar.andi %row_valid, %col_valid : i1
  scf.if %ok {
    %d_offset = index.mul %col, %d_s1 : index
    %d_col = index.add %d_batch, %d_offset : index
    %d_index = index.add %d_col, %row : index
    func.call @ggml_hrx_mm_store(%dst, %d_span, %d_index, %value) : (buffer, index, index, f32)
  }
  func.return
}

// For a short K and plain weight types. Each lane computes one row for 8 columns. The sums are in K order.
