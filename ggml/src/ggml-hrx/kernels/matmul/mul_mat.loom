  %d_span = index.assume %d_span_in [range(%d_span_in, 1, 2147483647)] : index
  %n_split = index.assume %n_split_in [range(%n_split_in, 1, 65536)] : index
  %chunk = index.assume %chunk_in [range(%chunk_in, 1, 2147483647)] : index
  %split_stride = index.assume %split_stride_in [range(%split_stride_in, 0, 2147483647)] : index
  %wtype = config.get @ggml.mul_mat.weight_type : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %f32_id = index.constant 0 : index
  %b0 = index.constant 0 : offset
  %stage_bytes = index.constant 8192 : offset
  %x_stage_bytes = index.constant 9216 : offset
  %zero4 = vector.splatf 0.0 : vector<4xf32>
  %t0 = kernel.workitem.id<x> : index
  %t = index.assume %t0 [range(%t0, 0, 255)] : index
  %row_tile = kernel.workgroup.id<x> : index
  %col_tile = kernel.workgroup.id<y> : index
  %z = kernel.workgroup.id<z> : index
  %batch = index.div %z, %n_split : index
  %split = index.rem %z, %n_split : index
  %weight_noalias, %input_noalias, %dst_noalias = buffer.assume.noalias %weight, %input, %dst : buffer, buffer, buffer
  %w_buf = buffer.alloca<workgroup> align(16) %stage_bytes : buffer
  %x_buf = buffer.alloca<workgroup> align(16) %x_stage_bytes : buffer
  %w_s = buffer.view %w_buf[%b0] : buffer -> view<32x64xf32>
  %x_s = buffer.view %x_buf[%b0] : buffer -> view<64x36xf32>
  %w_batch0, %x_batch0, %d_batch0 = func.call @ggml_hrx_mul_mat_batch(%batch, %ne12, %r2, %r3, %w_s2, %w_s3, %x_s2, %x_s3, %d_s2, %d_s3) : (index, index, index, index, index, index, index, index, index, index) -> (index, index, index)
  %k_begin = index.mul %split, %chunk : index
  %k_rest = index.sub %k_size, %k_begin : index
  %k_len = index.min %k_rest, %chunk : index
  %w_batch = index.add %w_batch0, %k_begin : index
  %x_batch = index.add %x_batch0, %k_begin : index
  %d_split = index.mul %split, %split_stride : index
  %d_batch = index.add %d_batch0, %d_split : index
  %tile_row0 = index.mul %row_tile, %c64 : index
  %tile_col0 = index.mul %col_tile, %c64 : index

  // Weights: lane t reads 4 K values at 4 * (t / 64) and 16 more of row t % 64.
  %l_pos = index.rem %t, %c64 : index
  %l_q = index.div %t, %c64 : index
  %l_k0 = index.mul %l_q, %c4 : index
  %l_k1 = index.add %l_k0, %c16 : index
  %l_row = index.add %tile_row0, %l_pos : index
  %l_row_in = index.cmp ult, %l_row, %n_rows : index
  %last_row = index.sub %n_rows, %c1 : index
  %l_row_c = index.min %l_row, %last_row : index
  %l_w_off = index.mul %l_row_c, %w_s1 : index
  %l_w_base = index.add %w_batch, %l_w_off : index
  // x: lane t reads 4 K values at 4 * (t % 8) of columns t / 8 and t / 8 + 32.
  %c8 = index.constant 8 : index
  %lx_c0 = index.div %t, %c8 : index
  %lx_c1 = index.add %lx_c0, %c32 : index
  %lx_q = index.rem %t, %c8 : index
  %lx_k = index.mul %lx_q, %c4 : index
  %last_col = index.sub %n_cols, %c1 : index
  %lx_col0 = index.add %tile_col0, %lx_c0 : index
  %lx_col1 = index.add %tile_col0, %lx_c1 : index
  %lx_in0 = index.cmp ult, %lx_col0, %n_cols : index
  %lx_in1 = index.cmp ult, %lx_col1, %n_cols : index
  %lx_cc0 = index.min %lx_col0, %last_col : index
  %lx_cc1 = index.min %lx_col1, %last_col : index
  %lx_off0 = index.mul %lx_cc0, %x_s1 : index
  %lx_off1 = index.mul %lx_cc1, %x_s1 : index
  %lx_base0 = index.add %x_batch, %lx_off0 : index
  %lx_base1 = index.add %x_batch, %lx_off1 : index

  // Compute: lane t has rows 4 * (t % 16) and columns 4 * (t / 16) of the tile. Thus 16 lanes store 64 rows of a column.
  %o_r = index.rem %t, %c16 : index
  %o_c = index.div %t, %c16 : index
  %o_r0 = index.mul %o_r, %c4 : index
  %o_c0 = index.mul %o_c, %c4 : index
  %o_c1 = index.add %o_c0, %c1 : index
  %o_c2 = index.add %o_c0, %c2 : index
  %o_c3 = index.add %o_c0, %c3 : index

  %p_w0 = func.call @ggml_hrx_mtf_fetch(%wtype, %weight_noalias, %w_span, %l_w_base, %l_k0) : (index, buffer, index, index, index) -> (vector<4xf32>)
  %p_w1 = func.call @ggml_hrx_mtf_fetch(%wtype, %weight_noalias, %w_span, %l_w_base, %l_k1) : (index, buffer, index, index, index) -> (vector<4xf32>)
  %p_x0 = func.call @ggml_hrx_mtf_fetch(%f32_id, %input_noalias, %x_span, %lx_base0, %lx_k) : (index, buffer, index, index, index) -> (vector<4xf32>)
  %p_x1 = func.call @ggml_hrx_mtf_fetch(%f32_id, %input_noalias, %x_span, %lx_base1, %lx_k) : (index, buffer, index, index, index) -> (vector<4xf32>)
  %acc0, %acc1, %acc2, %acc3, %e_w0, %e_w1, %e_x0, %e_x1 = scf.for %ks = [%c0 to %k_len step %c32](%a0 = %zero4 : vector<4xf32>, %a1 = %zero4 : vector<4xf32>, %a2 = %zero4 : vector<4xf32>, %a3 = %zero4 : vector<4xf32>, %cw0 = %p_w0 : vector<4xf32>, %cw1 = %p_w1 : vector<4xf32>, %cx0 = %p_x0 : vector<4xf32>, %cx1 = %p_x1 : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) {
    %kc0 = index.add %ks, %l_k0 : index
    %kc1 = index.add %ks, %l_k1 : index
    func.call @ggml_hrx_mtf_stage(%w_s, %l_k0, %l_pos, %l_row_in, %kc0, %k_len, %cw0) : (view<32x64xf32>, index, index, i1, index, index, vector<4xf32>)
    func.call @ggml_hrx_mtf_stage(%w_s, %l_k1, %l_pos, %l_row_in, %kc1, %k_len, %cw1) : (view<32x64xf32>, index, index, i1, index, index, vector<4xf32>)
    %kcx = index.add %ks, %lx_k : index
    func.call @ggml_hrx_mtf_stage_x(%x_s, %lx_c0, %lx_k, %lx_in0, %kcx, %k_len, %cx0) : (view<64x36xf32>, index, index, i1, index, index, vector<4xf32>)
    func.call @ggml_hrx_mtf_stage_x(%x_s, %lx_c1, %lx_k, %lx_in1, %kcx, %k_len, %cx1) : (view<64x36xf32>, index, index, i1, index, index, vector<4xf32>)
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %kn = index.add %ks, %c32 : index
    %kn0 = index.add %kn, %l_k0 : index
    %kn1 = index.add %kn, %l_k1 : index
    %n_w0 = func.call @ggml_hrx_mtf_fetch(%wtype, %weight_noalias, %w_span, %l_w_base, %kn0) : (index, buffer, index, index, index) -> (vector<4xf32>)
    %n_w1 = func.call @ggml_hrx_mtf_fetch(%wtype, %weight_noalias, %w_span, %l_w_base, %kn1) : (index, buffer, index, index, index) -> (vector<4xf32>)
    %knx = index.add %kn, %lx_k : index
    %n_x0 = func.call @ggml_hrx_mtf_fetch(%f32_id, %input_noalias, %x_span, %lx_base0, %knx) : (index, buffer, index, index, index) -> (vector<4xf32>)
    %n_x1 = func.call @ggml_hrx_mtf_fetch(%f32_id, %input_noalias, %x_span, %lx_base1, %knx) : (index, buffer, index, index, index) -> (vector<4xf32>)
    %r0, %r1, %r2v, %r3v = scf.for %kk = [%c0 to %c32 step %c1](%b0v = %a0 : vector<4xf32>, %b1v = %a1 : vector<4xf32>, %b2v = %a2 : vector<4xf32>, %b3v = %a3 : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) unroll(%c4) {
      %wv = vector.load %w_s[%kk, %o_r0] : view<32x64xf32> -> vector<4xf32>
      %x0 = view.load %x_s[%o_c0, %kk] : view<64x36xf32> -> f32
      %x1 = view.load %x_s[%o_c1, %kk] : view<64x36xf32> -> f32
      %x2 = view.load %x_s[%o_c2, %kk] : view<64x36xf32> -> f32
      %x3 = view.load %x_s[%o_c3, %kk] : view<64x36xf32> -> f32
      %x0v = vector.splat %x0 : vector<4xf32>
      %x1v = vector.splat %x1 : vector<4xf32>
      %x2v = vector.splat %x2 : vector<4xf32>
      %x3v = vector.splat %x3 : vector<4xf32>
      %n0 = vector.fmaf %wv, %x0v, %b0v : vector<4xf32>
      %n1 = vector.fmaf %wv, %x1v, %b1v : vector<4xf32>
      %n2 = vector.fmaf %wv, %x2v, %b2v : vector<4xf32>
      %n3 = vector.fmaf %wv, %x3v, %b3v : vector<4xf32>
      scf.yield %n0, %n1, %n2, %n3 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
    }
    // The next K step overwrites the stages.
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %r0, %r1, %r2v, %r3v, %n_w0, %n_w1, %n_x0, %n_x1 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
  }

  %out_row = index.add %tile_row0, %o_r0 : index
  %out_col0 = index.add %tile_col0, %o_c0 : index
  %out_col1 = index.add %out_col0, %c1 : index
  %out_col2 = index.add %out_col0, %c2 : index
  %out_col3 = index.add %out_col0, %c3 : index
  %out_valid0 = index.cmp ult, %out_col0, %n_cols : index
  %out_valid1 = index.cmp ult, %out_col1, %n_cols : index
  %out_valid2 = index.cmp ult, %out_col2, %n_cols : index
  %out_valid3 = index.cmp ult, %out_col3, %n_cols : index
  %d_offset0 = index.mul %out_col0, %d_s1 : index
  %d_offset1 = index.mul %out_col1, %d_s1 : index
  %d_offset2 = index.mul %out_col2, %d_s1 : index
  %d_offset3 = index.mul %out_col3, %d_s1 : index
  %d_base0 = index.add %d_batch, %d_offset0 : index
  %d_base1 = index.add %d_batch, %d_offset1 : index
  %d_base2 = index.add %d_batch, %d_offset2 : index
  %d_base3 = index.add %d_batch, %d_offset3 : index
  func.call @ggml_hrx_mm_store4(%dst_noalias, %d_span, %d_base0, %out_row, %n_rows, %out_valid0, %acc0) : (buffer, index, index, index, index, i1, vector<4xf32>)
  func.call @ggml_hrx_mm_store4(%dst_noalias, %d_span, %d_base1, %out_row, %n_rows, %out_valid1, %acc1) : (buffer, index, index, index, index, i1, vector<4xf32>)
  func.call @ggml_hrx_mm_store4(%dst_noalias, %d_span, %d_base2, %out_row, %n_rows, %out_valid2, %acc2) : (buffer, index, index, index, index, i1, vector<4xf32>)
  func.call @ggml_hrx_mm_store4(%dst_noalias, %d_span, %d_base3, %out_row, %n_rows, %out_valid3, %acc3) : (buffer, index, index, index, index, i1, vector<4xf32>)
  kernel.return
}

kernel.def target(@ggml_wave32) export("ggml_mul_mat_taps4") @ggml_mul_mat_taps4(%groups: index) {
  %one = index.constant 1 : index
  %wg = index.constant 256 : index
  kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%wg, %one, %one) : index
} launch(%w: buffer, %x: buffer, %y: buffer) {
  %zero = index.constant 0 : offset
  %zero_idx = index.constant 0 : index
  %wg = index.constant 256 : index
  %x_stride = index.constant 16 : offset
  %y_stride = index.constant 4 : offset
  %g = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %i = index.madd %g, %wg, %lane : index
  %xoff = index.scale %i, %x_stride : index, offset -> offset
  %yoff = index.scale %i, %y_stride : index, offset -> offset
  %wv = buffer.view %w[%zero] : buffer -> view<4xf32>
  %xv = buffer.view %x[%xoff] : buffer -> view<4xf32>
  %yv = buffer.view %y[%yoff] : buffer -> view<1xf32>
  %weights = vector.load %wv[%zero_idx] : view<4xf32> -> vector<4xf32>
  %values = vector.load %xv[%zero_idx] : view<4xf32> -> vector<4xf32>
  %a0 = scalar.constant 0.0 : f32
  %w0 = vector.extract %weights[0] : vector<4xf32> -> f32
  %x0 = vector.extract %values[0] : vector<4xf32> -> f32
  %a1 = scalar.fmaf %w0, %x0, %a0 : f32
  %w1 = vector.extract %weights[1] : vector<4xf32> -> f32
  %x1 = vector.extract %values[1] : vector<4xf32> -> f32
  %a2 = scalar.fmaf %w1, %x1, %a1 : f32
  %w2 = vector.extract %weights[2] : vector<4xf32> -> f32
  %x2 = vector.extract %values[2] : vector<4xf32> -> f32
  %a3 = scalar.fmaf %w2, %x2, %a2 : f32
  %w3 = vector.extract %weights[3] : vector<4xf32> -> f32
  %x3 = vector.extract %values[3] : vector<4xf32> -> f32
  %a4 = scalar.fmaf %w3, %x3, %a3 : f32
  view.store %a4, %yv[0] : f32, view<1xf32>
  kernel.return
}
