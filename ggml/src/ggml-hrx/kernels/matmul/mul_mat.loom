  %st_k = index.rem %t, %c32 : index
  %st_xb, %st_xv = func.call @ggml_hrx_mm_sk_col(%st_col, %col0, %n_cols, %x_batch, %x_s1) : (index, index, index, index, index) -> (index, i1)
  %st_x = func.call @ggml_hrx_mm_stage_input(%input_noalias, %x_span, %st_xb, %st_xv, %x_s0, %st_k, %k_size) : (buffer, index, index, i1, index, index, index) -> (f32)
  view.store %st_x, %x_view[%st_col, %st_k] : f32, view<8x33xf32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %acc = scf.for %k = [%c0 to %k_size step %c1](%a = %zero8 : vector<8xf32>) -> (vector<8xf32>) unroll(%c4) schedule(recurrence) {
    %k_in = index.min %k, %c31 : index
    %wv = func.call @ggml_hrx_mm_weight_at(%wtype, %weight_noalias, %w_span, %w_base, %k, %k_size) : (index, buffer, index, index, index, index) -> (f32)
    %w = scf.select %row_valid, %wv, %zero : f32
    %x0 = view.load %x_view[%c0, %k_in] : view<8x33xf32> -> f32
    %x1 = view.load %x_view[%c1, %k_in] : view<8x33xf32> -> f32
    %x2 = view.load %x_view[%c2, %k_in] : view<8x33xf32> -> f32
    %x3 = view.load %x_view[%c3, %k_in] : view<8x33xf32> -> f32
    %x4 = view.load %x_view[%c4, %k_in] : view<8x33xf32> -> f32
    %x5 = view.load %x_view[%c5, %k_in] : view<8x33xf32> -> f32
    %x6 = view.load %x_view[%c6, %k_in] : view<8x33xf32> -> f32
    %x7 = view.load %x_view[%c7, %k_in] : view<8x33xf32> -> f32
    %xs = vector.from_elements %x0, %x1, %x2, %x3, %x4, %x5, %x6, %x7 : vector<8xf32>
    %ws = vector.splat %w : vector<8xf32>
    %next = vector.fmaf %ws, %xs, %a : vector<8xf32>
    scf.yield %next : vector<8xf32>
  }
  %v0 = vector.extract %acc[0] : vector<8xf32> -> f32
  %v1 = vector.extract %acc[1] : vector<8xf32> -> f32
  %v2 = vector.extract %acc[2] : vector<8xf32> -> f32
  %v3 = vector.extract %acc[3] : vector<8xf32> -> f32
  %v4 = vector.extract %acc[4] : vector<8xf32> -> f32
  %v5 = vector.extract %acc[5] : vector<8xf32> -> f32
  %v6 = vector.extract %acc[6] : vector<8xf32> -> f32
  %v7 = vector.extract %acc[7] : vector<8xf32> -> f32
  func.call @ggml_hrx_mm_sk_store(%dst_noalias, %d_span, %d_batch, %d_s1, %c0, %col0, %n_cols, %row, %row_valid, %v0) : (buffer, index, index, index, index, index, index, index, i1, f32)
  func.call @ggml_hrx_mm_sk_store(%dst_noalias, %d_span, %d_batch, %d_s1, %c1, %col0, %n_cols, %row, %row_valid, %v1) : (buffer, index, index, index, index, index, index, index, i1, f32)
  func.call @ggml_hrx_mm_sk_store(%dst_noalias, %d_span, %d_batch, %d_s1, %c2, %col0, %n_cols, %row, %row_valid, %v2) : (buffer, index, index, index, index, index, index, index, i1, f32)
  func.call @ggml_hrx_mm_sk_store(%dst_noalias, %d_span, %d_batch, %d_s1, %c3, %col0, %n_cols, %row, %row_valid, %v3) : (buffer, index, index, index, index, index, index, index, i1, f32)
  func.call @ggml_hrx_mm_sk_store(%dst_noalias, %d_span, %d_batch, %d_s1, %c4, %col0, %n_cols, %row, %row_valid, %v4) : (buffer, index, index, index, index, index, index, index, i1, f32)
  func.call @ggml_hrx_mm_sk_store(%dst_noalias, %d_span, %d_batch, %d_s1, %c5, %col0, %n_cols, %row, %row_valid, %v5) : (buffer, index, index, index, index, index, index, index, i1, f32)
  func.call @ggml_hrx_mm_sk_store(%dst_noalias, %d_span, %d_batch, %d_s1, %c6, %col0, %n_cols, %row, %row_valid, %v6) : (buffer, index, index, index, index, index, index, index, i1, f32)
  func.call @ggml_hrx_mm_sk_store(%dst_noalias, %d_span, %d_batch, %d_s1, %c7, %col0, %n_cols, %row, %row_valid, %v7) : (buffer, index, index, index, index, index, index, index, i1, f32)
  kernel.return
}

// The tiled kernel for one K range of each split. dst gets the partial sums of the split at split * split_stride.
// The caller makes sure that the weight type is plain, that chunk is a multiple of 32 and that each split has K values.
kernel.def target(@ggml_wave64) export("ggml_mul_mat_tiled_split") @ggml_mul_mat_tiled_split(%n_rows: index, %n_cols: index, %n_z: index) {
  %one = index.constant 1 : index
  %wg_size = index.constant 256 : index
  %c31 = index.constant 31 : index
  %c32 = index.constant 32 : index
  %c63 = index.constant 63 : index
  %c64 = index.constant 64 : index
  %rows_round = index.add %n_rows, %c63 : index
  %row_tiles = index.div %rows_round, %c64 : index
  %cols_round = index.add %n_cols, %c31 : index
  %col_tiles = index.div %cols_round, %c32 : index
  kernel.launch.config workgroups(%row_tiles, %col_tiles, %n_z) workgroup_size(%wg_size, %one, %one) : index
} launch(%k_size_in: index, %n_rows_in: index, %n_cols_in: index, %ne12_in: index, %r2_in: index, %r3_in: index, %w_s1_in: index, %w_s2_in: index, %w_s3_in: index, %w_span_in: index, %x_s0_in: index, %x_s1_in: index, %x_s2_in: index, %x_s3_in: index, %x_span_in: index, %d_s1_in: index, %d_s2_in: index, %d_s3_in: index, %d_span_in: index, %n_split_in: index, %chunk_in: index, %split_stride_in: index, %weight: buffer, %input: buffer, %dst: buffer) {
  // supports_mul_mat checks these ranges.
  %k_size = index.assume %k_size_in [range(%k_size_in, 1, 2147483647)] : index
  %n_rows = index.assume %n_rows_in [range(%n_rows_in, 1, 2147483647)] : index
  %n_cols = index.assume %n_cols_in [range(%n_cols_in, 1, 2147483647)] : index
  %ne12 = index.assume %ne12_in [range(%ne12_in, 1, 2147483647)] : index
  %r2 = index.assume %r2_in [range(%r2_in, 1, 2147483647)] : index
  %r3 = index.assume %r3_in [range(%r3_in, 1, 2147483647)] : index
  %w_s1 = index.assume %w_s1_in [range(%w_s1_in, 0, 2147483647)] : index
  %w_s2 = index.assume %w_s2_in [range(%w_s2_in, 0, 2147483647)] : index
  %w_s3 = index.assume %w_s3_in [range(%w_s3_in, 0, 2147483647)] : index
  %w_span = index.assume %w_span_in [range(%w_span_in, 1, 2147483647)] : index
  %x_s0 = index.assume %x_s0_in [range(%x_s0_in, 0, 2147483647)] : index
  %x_s1 = index.assume %x_s1_in [range(%x_s1_in, 0, 2147483647)] : index
  %x_s2 = index.assume %x_s2_in [range(%x_s2_in, 0, 2147483647)] : index
  %x_s3 = index.assume %x_s3_in [range(%x_s3_in, 0, 2147483647)] : index
  %x_span = index.assume %x_span_in [range(%x_span_in, 1, 2147483647)] : index
  %d_s1 = index.assume %d_s1_in [range(%d_s1_in, 0, 2147483647)] : index
  %d_s2 = index.assume %d_s2_in [range(%d_s2_in, 0, 2147483647)] : index
  %d_s3 = index.assume %d_s3_in [range(%d_s3_in, 0, 2147483647)] : index
  %d_span = index.assume %d_span_in [range(%d_span_in, 1, 2147483647)] : index
  %n_split = index.assume %n_split_in [range(%n_split_in, 1, 65536)] : index
  %chunk = index.assume %chunk_in [range(%chunk_in, 1, 2147483647)] : index
  %split_stride = index.assume %split_stride_in [range(%split_stride_in, 0, 2147483647)] : index
  %wtype = config.get @ggml.mul_mat.weight_type : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c24 = index.constant 24 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %w_stage_bytes = index.constant 8192 : offset
  %x_stage_bytes = index.constant 4224 : offset
  %t0 = kernel.workitem.id<x> : index
  %t = index.assume %t0 [range(%t0, 0, 255)] : index
  %row_tile = kernel.workgroup.id<x> : index
  %col_tile = kernel.workgroup.id<y> : index
  %z = kernel.workgroup.id<z> : index
  %batch = index.div %z, %n_split : index
  %split = index.rem %z, %n_split : index
  %weight_noalias, %input_noalias, %dst_noalias = buffer.assume.noalias %weight, %input, %dst : buffer, buffer, buffer
  %w_stage = buffer.alloca<workgroup> align(16) %w_stage_bytes : buffer
  %x_stage = buffer.alloca<workgroup> align(16) %x_stage_bytes : buffer
  %w_batch0, %x_batch0, %d_batch0 = func.call @ggml_hrx_mul_mat_batch(%batch, %ne12, %r2, %r3, %w_s2, %w_s3, %x_s2, %x_s3, %d_s2, %d_s3) : (index, index, index, index, index, index, index, index, index, index) -> (index, index, index)
  // The split reads K from k_begin. Plain weight types have one value for each weight unit.
  %k_begin = index.mul %split, %chunk : index
  %k_rest = index.sub %k_size, %k_begin : index
  %k_len = index.min %k_rest, %chunk : index
  %w_batch = index.add %w_batch0, %k_begin : index
  %x_k_offset = index.mul %k_begin, %x_s0 : index
  %x_batch = index.add %x_batch0, %x_k_offset : index
  %d_split = index.mul %split, %split_stride : index
  %d_batch = index.add %d_batch0, %d_split : index
  %tile_row0 = index.mul %row_tile, %c64 : index
  %tile_col0 = index.mul %col_tile, %c32 : index

  %w_local0 = index.div %t, %c8 : index
  %w_row0 = index.add %tile_row0, %w_local0 : index
  %w_row1 = index.add %w_row0, %c32 : index
  %w_valid0 = index.cmp ult, %w_row0, %n_rows : index
  %w_valid1 = index.cmp ult, %w_row1, %n_rows : index
  %w_offset0 = index.mul %w_row0, %w_s1 : index
  %w_offset1 = index.mul %w_row1, %w_s1 : index
  %w_base0 = index.add %w_batch, %w_offset0 : index
  %w_base1 = index.add %w_batch, %w_offset1 : index

  %x_local0 = index.div %t, %c32 : index
  %x_col0 = index.add %tile_col0, %x_local0 : index
  %x_col1 = index.add %x_col0, %c8 : index
  %x_col2 = index.add %x_col0, %c16 : index
  %x_col3 = index.add %x_col0, %c24 : index
  %x_valid0 = index.cmp ult, %x_col0, %n_cols : index
  %x_valid1 = index.cmp ult, %x_col1, %n_cols : index
  %x_valid2 = index.cmp ult, %x_col2, %n_cols : index
  %x_valid3 = index.cmp ult, %x_col3, %n_cols : index
  %x_offset0 = index.mul %x_col0, %x_s1 : index
  %x_offset1 = index.mul %x_col1, %x_s1 : index
  %x_offset2 = index.mul %x_col2, %x_s1 : index
  %x_offset3 = index.mul %x_col3, %x_s1 : index
  %x_base0 = index.add %x_batch, %x_offset0 : index
  %x_base1 = index.add %x_batch, %x_offset1 : index
  %x_base2 = index.add %x_batch, %x_offset2 : index
  %x_base3 = index.add %x_batch, %x_offset3 : index

  %acc0, %acc1 = func.call @ggml_hrx_mm_tile(%wtype, %k_len, %w_base0, %w_valid0, %w_base1, %w_valid1, %x_base0, %x_valid0, %x_base1, %x_valid1, %x_base2, %x_valid2, %x_base3, %x_valid3, %x_s0, %w_span, %x_span, %weight_noalias, %input_noalias, %w_stage, %x_stage) : (index, index, index, i1, index, i1, index, i1, index, i1, index, i1, index, i1, index, index, index, buffer, buffer, buffer, buffer) -> (vector<4xf32>, vector<4xf32>)

  %out_row_group = index.rem %t, %c16 : index
  %out_row_local = index.mul %out_row_group, %c4 : index
  %out_row = index.add %tile_row0, %out_row_local : index
  %out_local0 = index.div %t, %c16 : index
  %out_col0 = index.add %tile_col0, %out_local0 : index
  %out_col1 = index.add %out_col0, %c16 : index
  %out_valid0 = index.cmp ult, %out_col0, %n_cols : index
  %out_valid1 = index.cmp ult, %out_col1, %n_cols : index
  %d_offset0 = index.mul %out_col0, %d_s1 : index
  %d_offset1 = index.mul %out_col1, %d_s1 : index
  %d_base0 = index.add %d_batch, %d_offset0 : index
  %d_base1 = index.add %d_batch, %d_offset1 : index
  func.call @ggml_hrx_mm_store4(%dst_noalias, %d_span, %d_base0, %out_row, %n_rows, %out_valid0, %acc0) : (buffer, index, index, index, index, i1, vector<4xf32>)
  func.call @ggml_hrx_mm_store4(%dst_noalias, %d_span, %d_base1, %out_row, %n_rows, %out_valid1, %acc1) : (buffer, index, index, index, index, i1, vector<4xf32>)
  kernel.return
}

// Sums the n_split partial results in split order. part holds n_split blocks of split_stride values in dst order of n_rows x n_cols x n_batch.
kernel.def target(@ggml_wave32) export("ggml_mul_mat_split_reduce") @ggml_mul_mat_split_reduce(%n_out: index, %n_batch: index) {
  %one = index.constant 1 : index
  %wg_size = index.constant 256 : index
  %c255 = index.constant 255 : index
  %out_round = index.add %n_out, %c255 : index
  %out_tiles = index.div %out_round, %wg_size : index
  kernel.launch.config workgroups(%out_tiles, %n_batch, %one) workgroup_size(%wg_size, %one, %one) : index
} launch(%n_rows_in: index, %n_cols_in: index, %ne12_in: index, %n_split_in: index, %split_stride_in: index, %part_span_in: index, %d_s1_in: index, %d_s2_in: index, %d_s3_in: index, %d_span_in: index, %part: buffer, %dst: buffer) {
  // The caller checks these ranges.
  %n_rows = index.assume %n_rows_in [range(%n_rows_in, 1, 2147483647)] : index
  %n_cols = index.assume %n_cols_in [range(%n_cols_in, 1, 2147483647)] : index
  %ne12 = index.assume %ne12_in [range(%ne12_in, 1, 2147483647)] : index
  %n_split = index.assume %n_split_in [range(%n_split_in, 1, 65536)] : index
  %split_stride = index.assume %split_stride_in [range(%split_stride_in, 1, 2147483647)] : index
  %part_span = index.assume %part_span_in [range(%part_span_in, 1, 2147483647)] : index
  %d_s1 = index.assume %d_s1_in [range(%d_s1_in, 0, 2147483647)] : index
  %d_s2 = index.assume %d_s2_in [range(%d_s2_in, 0, 2147483647)] : index
  %d_s3 = index.assume %d_s3_in [range(%d_s3_in, 0, 2147483647)] : index
  %d_span = index.assume %d_span_in [range(%d_span_in, 1, 2147483647)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  %b0 = index.constant 0 : offset
  %zero = scalar.constant 0.0 : f32
  %t0 = kernel.workitem.id<x> : index
  %t = index.assume %t0 [range(%t0, 0, 255)] : index
  %tile = kernel.workgroup.id<x> : index
  %batch = kernel.workgroup.id<y> : index
  %part_noalias, %dst_noalias = buffer.assume.noalias %part, %dst : buffer, buffer
  %part_view = buffer.view %part_noalias[%b0] : buffer -> view<[%part_span]xf32>
  %n_out = index.mul %n_rows, %n_cols : index
  %o0 = index.mul %tile, %c256 : index
  %o = index.add %o0, %t : index
  %o_in = index.cmp ult, %o, %n_out : index
  scf.if %o_in {
    %row = index.rem %o, %n_rows : index
    %col = index.div %o, %n_rows : index
    %p_batch = index.mul %batch, %n_out : index
    %p_base = index.add %p_batch, %o : index
    %sum = scf.for %s = [%c0 to %n_split step %c1](%acc = %zero : f32) -> (f32) {
      %p_off = index.mul %s, %split_stride : index
      %p_raw = index.add %p_base, %p_off : index
      %p_idx = index.assume %p_raw [range(%p_raw, 0, 2147483646)] : index
      %p_ok = index.cmp ult, %p_idx, %part_span : index
      %next = scf.if %p_ok -> (f32) {
        %v = view.load %part_view[%p_idx] : view<[%part_span]xf32> -> f32
        %a = scalar.addf %acc, %v : f32
        scf.yield %a : f32
      } else {
        scf.yield %acc : f32
      }
      scf.yield %next : f32
    }
    %i12 = index.rem %batch, %ne12 : index
    %i13 = index.div %batch, %ne12 : index
    %d2 = index.mul %i12, %d_s2 : index
    %d3 = index.mul %i13, %d_s3 : index
    %d_b = index.add %d2, %d3 : index
    %d_c = index.mul %col, %d_s1 : index
    %d_bc = index.add %d_b, %d_c : index
    %d_index = index.add %d_bc, %row : index
    func.call @ggml_hrx_mm_store(%dst_noalias, %d_span, %d_index, %sum) : (buffer, index, index, f32)
  }
  kernel.return
}

// Lanes for each row of ggml_mul_mat_vec_f: 16, 32, 64, 128 or 256. A segment of min(lanes, 32) lanes reduces in a subgroup.
config.decl @ggml.mul_mat.vec_f_lanes : %value: index where [range(%value, 16, 256)]

template.decl @ggml.reduce.sum_f32(%value: f32, %lanes: index) -> (f32)

// The load clamps the index into the span. Callers do not use a value from a clamped index.
func.def inline @ggml_hrx_mvf_load8(%wtype: index, %buf: buffer, %span: index, %index: index) -> (vector<8xf32>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %c0_offset = index.constant 0 : offset
  %span8 = index.assume %span [range(%span, 8, 2147483647)] : index
  %span_last = index.sub %span8, %c8 : index
  %limit0 = index.sub %span8, %c7 : index
  %index_bounded = index.assume %index [range(%index, 0, 2147483646)] : index
  %clamped0 = index.min %index_bounded, %span_last : index
  %clamped, %limit = index.assume %clamped0, %limit0 [lt(%clamped0, %limit0)] : index, index
  %extent = index.add %limit, %c7 : index
  %is_f32 = index.cmp eq, %wtype, %c0 : index
  %is_f16 = index.cmp eq, %wtype, %c1 : index
  %values = scf.if %is_f32 -> (vector<8xf32>) {
    %view = buffer.view %buf[%c0_offset] : buffer -> view<[%extent]xf32>
    %v = vector.load %view[%clamped] : view<[%extent]xf32> -> vector<8xf32>
    scf.yield %v : vector<8xf32>
  } else {
    %h = scf.if %is_f16 -> (vector<8xf32>) {
      %view = buffer.view %buf[%c0_offset] : buffer -> view<[%extent]xf16>
      %v = vector.load %view[%clamped] : view<[%extent]xf16> -> vector<8xf16>
      %wide = vector.extf %v : vector<8xf16> to vector<8xf32>
      scf.yield %wide : vector<8xf32>
    } else {
      %view = buffer.view %buf[%c0_offset] : buffer -> view<[%extent]xbf16>
      %v = vector.load %view[%clamped] : view<[%extent]xbf16> -> vector<8xbf16>
      %wide = vector.extf %v : vector<8xbf16> to vector<8xf32>
      scf.yield %wide : vector<8xf32>
    }
    scf.yield %h : vector<8xf32>
  }
  func.return %values : vector<8xf32>
}

func.def inline @ggml_hrx_mvf_col(%use: i1, %ok: i1, %input: buffer, %x_span: index, %x_base: index, %k: index, %w: vector<8xf32>, %acc: vector<8xf32>) -> (vector<8xf32>) {
  %c0 = index.constant 0 : index
  %result = scf.if %use -> (vector<8xf32>) {
    %index = index.add %x_base, %k : index
    %x = func.call @ggml_hrx_mvf_load8(%c0, %input, %x_span, %index) : (index, buffer, index, index) -> (vector<8xf32>)
    %next = vector.fmaf %w, %x, %acc : vector<8xf32>
    %sel = scf.select %ok, %next, %acc : vector<8xf32>
    scf.yield %sel : vector<8xf32>
  } else {
    scf.yield %acc : vector<8xf32>
  }
  func.return %result : vector<8xf32>
}

func.def inline @ggml_hrx_mvf_stage(%use: i1, %writer: i1, %stage: view<128xf32>, %seg_id: index, %c: index, %acc: vector<8xf32>, %seg: index) {
  %c8 = index.constant 8 : index
  %c128 = index.constant 128 : index
  %zero = scalar.constant 0.0 : f32
  scf.if %use {
    %lane_sum = vector.reduce<addf> %acc, %zero : vector<8xf32>, f32
    %sum = template.apply<@ggml.reduce.sum_f32>(%lane_sum, %seg) : (f32, index) -> (f32)
    scf.if %writer {
      %base = index.mul %seg_id, %c8 : index
      %i_raw = index.add %base, %c : index
      %i = index.assume %i_raw [range(%i_raw, 0, 127)] : index
      %i_in = index.cmp ult, %i, %c128 : index
      scf.if %i_in {
