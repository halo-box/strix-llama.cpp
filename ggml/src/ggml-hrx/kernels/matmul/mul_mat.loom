// Weight strides and span are in weight units (see lib/mm_core.loom). Input and dst strides are in elements.
// All kernels have the same launch arguments. ggml_mul_mat_tiled_split adds 3 arguments, the split reduce has its own.

config.decl @ggml.mul_mat.weight_type : %value: index where [range(%value, 0, 4)]

// ggml_mul_mat_vec_xs unrolls one dot product for each column.
config.decl @ggml.mul_mat.vec_cols : %value: index where [range(%value, 1, 8)]

config.decl @ggml.mul_mat.vec_xs_workgroups : %value: index where [range(%value, 1, 65536)]

config.decl @ggml.mul_mat.vec_xs_depth : %value: index where [range(%value, 1, 4)]

// 1: the last superblock is partial. Only for weight types with 32-value blocks.
config.decl @ggml.mul_mat.vec_k_tail : %value: index where [range(%value, 0, 1)]

target.decl @ggml_wave64

target.decl @ggml_wave32

// @ggml.weight.offsets16 gives the same offsets as @ggml.weight.part16.
template.decl @ggml.weight.offsets16(%wtype: index, %part: index) -> (index, index, index, index)

template.decl @ggml.weight.part16(%wtype: index, %weight: buffer, %sb_byte: offset, %part: index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, index, index, index, index)

template.decl @ggml.weight.superblock(%wtype: index) -> (offset, offset, index)

func.decl @ggml_hrx_mm_tile(%wtype: index, %k_size: index, %w_base0: index, %w_valid0: i1, %w_base1: index, %w_valid1: i1, %x_base0: index, %x_valid0: i1, %x_base1: index, %x_valid1: i1, %x_base2: index, %x_valid2: i1, %x_base3: index, %x_valid3: i1, %x_s0: index, %w_span: index, %x_span: index, %weight: buffer, %input: buffer, %w_stage: buffer, %x_stage: buffer) -> (vector<4xf32>, vector<4xf32>)

func.decl @ggml_hrx_mm_store(%dst: buffer, %d_span: index, %index: index, %value: f32)

func.decl @ggml_hrx_mm_weight_at(%wtype: index, %weight: buffer, %w_span: index, %row_base: index, %k: index, %k_size: index) -> (f32)

func.decl @ggml_hrx_mm_stage_input(%input: buffer, %x_span: index, %x_base: index, %x_valid: i1, %x_s0: index, %k: index, %k_size: index) -> (f32)

func.decl @ggml_hrx_mv_col_base(%i: index, %n_tile: index, %n_cols: index, %x_batch: index, %x_s1: index, %k_size: index, %x_span: index, %ok_in: i1) -> (index, i1, i1, i1)

func.decl @ggml_hrx_mv_xload(%use: i1, %input: buffer, %x_base: index, %sb: index, %o0: index, %o1: index, %o2: index, %o3: index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>)

func.decl @ggml_hrx_mv_dot16(%use: i1, %w0: vector<4xf32>, %w1: vector<4xf32>, %w2: vector<4xf32>, %w3: vector<4xf32>, %x0: vector<4xf32>, %x1: vector<4xf32>, %x2: vector<4xf32>, %x3: vector<4xf32>) -> (f32)

func.decl @ggml_hrx_mm_store4(%dst: buffer, %d_span: index, %d_col_base: index, %row0: index, %n_rows: index, %col_valid: i1, %values: vector<4xf32>)

func.def inline @ggml_hrx_mul_mat_batch(%batch: index, %ne12: index, %r2: index, %r3: index, %w_s2: index, %w_s3: index, %x_s2: index, %x_s3: index, %d_s2: index, %d_s3: index) -> (index, index, index) {
  %i12 = index.rem %batch, %ne12 : index
  %i13 = index.div %batch, %ne12 : index
  %i02 = index.div %i12, %r2 : index
  %i03 = index.div %i13, %r3 : index
  %w2 = index.mul %i02, %w_s2 : index
  %w3 = index.mul %i03, %w_s3 : index
  %w_base = index.add %w2, %w3 : index
  %x2 = index.mul %i12, %x_s2 : index
  %x3 = index.mul %i13, %x_s3 : index
  %x_base = index.add %x2, %x3 : index
  %d2 = index.mul %i12, %d_s2 : index
  %d3 = index.mul %i13, %d_s3 : index
  %d_base = index.add %d2, %d3 : index
  func.return %w_base, %x_base, %d_base : index, index, index
}

// vec_xs_workgroups is a multiple of the CU count. Fewer workgroups give a long tail.
func.def inline @ggml_hrx_mv_xs_plan(%n_rows: index, %k_size: index) -> (index, index, index, index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %n_wg_target = config.get @ggml.mul_mat.vec_xs_workgroups : index
  %n_wg_target_m1 = index.sub %n_wg_target, %c1 : index
  %c255 = index.constant 255 : index
  %c256 = index.constant 256 : index
  %k_tail = config.get @ggml.mul_mat.vec_k_tail : index
  %k_pad = index.mul %k_tail, %c255 : index
  %k_round = index.add %k_size, %k_pad : index
  %n_sb0 = index.div %k_round, %c256 : index
  %n_sb1 = index.min %n_sb0, %c16 : index
  %no_sb = index.cmp eq, %n_sb1, %c0 : index
  %n_sb2 = scf.select %no_sb, %c1, %n_sb1 : index
  %n_sb = index.assume %n_sb2 [range(%n_sb2, 1, 16)] : index
  %rows_par0 = index.div %c16, %n_sb : index
  %rows_par = index.assume %rows_par0 [range(%rows_par0, 1, 16)] : index
  %rows_par_m1 = index.sub %rows_par, %c1 : index
  %rows_round = index.add %n_rows, %rows_par_m1 : index
  %total_pass = index.div %rows_round, %rows_par : index
  %pass_round = index.add %total_pass, %n_wg_target_m1 : index
  %n_pass0 = index.div %pass_round, %n_wg_target : index
  %n_pass1 = index.min %n_pass0, %c32 : index
  // Each workgroup loads all activations once. Thus use at least 4 passes when this keeps 16 workgroups.
  %c4 = index.constant 4 : index
  %c64 = index.constant 64 : index
  %many_pass = index.cmp uge, %total_pass, %c64 : index
  %min_pass = scf.select %many_pass, %c4, %c1 : index
  %few_pass = index.cmp ult, %n_pass1, %min_pass : index
  %n_pass2 = scf.select %few_pass, %min_pass, %n_pass1 : index
  %n_pass = index.assume %n_pass2 [range(%n_pass2, 1, 32)] : index
  %n_pass_m1 = index.sub %n_pass, %c1 : index
  %wg_round = index.add %total_pass, %n_pass_m1 : index
  %n_wg = index.div %wg_round, %n_pass : index
  func.return %n_sb, %rows_par, %n_pass, %n_wg : index, index, index, index
}

// Callers keep p < 32, col < 8 and slot < 16. Thus the index is below 4096.
func.def inline @ggml_hrx_mv_xs_stage_index(%p: index, %col: index, %slot: index) -> (index) {
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c31 = index.constant 31 : index
  %p_min = index.min %p, %c31 : index
  %col_min = index.min %col, %c7 : index
  %slot_min = index.min %slot, %c15 : index
  %p_in = index.assume %p_min [range(%p_min, 0, 31)] : index
  %col_in = index.assume %col_min [range(%col_min, 0, 7)] : index
  %slot_in = index.assume %slot_min [range(%slot_min, 0, 15)] : index
  %p_cols = index.mul %p_in, %c8 : index
  %p_col = index.add %p_cols, %col_in : index
  %p_slots = index.mul %p_col, %c16 : index
  %index = index.add %p_slots, %slot_in : index
  func.return %index : index
}

// For few input columns and K <= 4096. The activations stay in registers for all passes of a workgroup.
// The caller makes sure that K is a multiple of 256 (32 with vec_k_tail) and that x is contiguous along K.
kernel.def target(@ggml_wave32) export("ggml_mul_mat_vec_xs") @ggml_mul_mat_vec_xs(%n_rows: index, %k_size: index, %n_batch: index) {
  // Launch configuration cannot call functions. Thus this repeats @ggml_hrx_mv_xs_plan.
  %c0 = index.constant 0 : index
  %one = index.constant 1 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %n_wg_target = config.get @ggml.mul_mat.vec_xs_workgroups : index
  %n_wg_target_m1 = index.sub %n_wg_target, %one : index
  %wg_size = index.constant 256 : index
  %c255 = index.constant 255 : index
  %k_tail = config.get @ggml.mul_mat.vec_k_tail : index
  %k_pad = index.mul %k_tail, %c255 : index
  %k_round = index.add %k_size, %k_pad : index
  %n_sb0 = index.div %k_round, %wg_size : index
  %n_sb1 = index.min %n_sb0, %c16 : index
  %no_sb = index.cmp eq, %n_sb1, %c0 : index
  %n_sb2 = scf.select %no_sb, %one, %n_sb1 : index
  %n_sb = index.assume %n_sb2 [range(%n_sb2, 1, 16)] : index
  %rows_par0 = index.div %c16, %n_sb : index
  %rows_par = index.assume %rows_par0 [range(%rows_par0, 1, 16)] : index
  %rows_par_m1 = index.sub %rows_par, %one : index
  %rows_round = index.add %n_rows, %rows_par_m1 : index
  %total_pass = index.div %rows_round, %rows_par : index
  %pass_round = index.add %total_pass, %n_wg_target_m1 : index
  %n_pass0 = index.div %pass_round, %n_wg_target : index
  %n_pass1 = index.min %n_pass0, %c32 : index
  %c4 = index.constant 4 : index
  %c64 = index.constant 64 : index
  %many_pass = index.cmp uge, %total_pass, %c64 : index
  %min_pass = scf.select %many_pass, %c4, %one : index
  %few_pass = index.cmp ult, %n_pass1, %min_pass : index
  %n_pass2 = scf.select %few_pass, %min_pass, %n_pass1 : index
  %n_pass = index.assume %n_pass2 [range(%n_pass2, 1, 32)] : index
  %n_pass_m1 = index.sub %n_pass, %one : index
  %wg_round = index.add %total_pass, %n_pass_m1 : index
  %n_wg = index.div %wg_round, %n_pass : index
  kernel.launch.config workgroups(%n_wg, %one, %n_batch) workgroup_size(%wg_size, %one, %one) : index
} launch(%k_size_in: index, %n_rows_in: index, %n_cols_in: index, %ne12_in: index, %r2_in: index, %r3_in: index, %w_s1_in: index, %w_s2_in: index, %w_s3_in: index, %w_span_in: index, %x_s0_in: index, %x_s1_in: index, %x_s2_in: index, %x_s3_in: index, %x_span_in: index, %d_s1_in: index, %d_s2_in: index, %d_s3_in: index, %d_span_in: index, %weight: buffer, %input: buffer, %dst: buffer) {
  // supports_mul_mat checks these ranges.
  %k_size = index.assume %k_size_in [range(%k_size_in, 1, 2147483647)] : index
  %n_rows = index.assume %n_rows_in [range(%n_rows_in, 1, 2147483647)] : index
  %n_cols = index.assume %n_cols_in [range(%n_cols_in, 1, 2147483647)] : index
  %ne12 = index.assume %ne12_in [range(%ne12_in, 1, 2147483647)] : index
  %r2 = index.assume %r2_in [range(%r2_in, 1, 2147483647)] : index
  %r3 = index.assume %r3_in [range(%r3_in, 1, 2147483647)] : index
  %w_s1 = index.assume %w_s1_in [range(%w_s1_in, 0, 2147483647)] : index
  %w_s2 = index.assume %w_s2_in [range(%w_s2_in, 0, 2147483647)] : index
  %w_s3 = index.assume %w_s3_in [range(%w_s3_in, 0, 2147483647)] : index
  %w_span = index.assume %w_span_in [range(%w_span_in, 1, 2147483647)] : index
  %x_s1 = index.assume %x_s1_in [range(%x_s1_in, 0, 2147483647)] : index
  %x_s2 = index.assume %x_s2_in [range(%x_s2_in, 0, 2147483647)] : index
  %x_s3 = index.assume %x_s3_in [range(%x_s3_in, 0, 2147483647)] : index
  %x_span = index.assume %x_span_in [range(%x_span_in, 1, 2147483647)] : index
  %d_s1 = index.assume %d_s1_in [range(%d_s1_in, 0, 2147483647)] : index
  %d_s2 = index.assume %d_s2_in [range(%d_s2_in, 0, 2147483647)] : index
  %d_s3 = index.assume %d_s3_in [range(%d_s3_in, 0, 2147483647)] : index
  %d_span = index.assume %d_span_in [range(%d_span_in, 1, 2147483647)] : index
  %wtype = config.get @ggml.mul_mat.weight_type : index
  %n_tile = config.get @ggml.mul_mat.vec_cols : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c256 = index.constant 256 : index
  %c4096 = index.constant 4096 : index
  %stage_bytes = index.constant 16384 : offset
  %b0 = index.constant 0 : offset
  %zero = scalar.constant 0.0 : f32
  %zero4 = vector.splatf 0.0 : vector<4xf32>
  %true = scalar.constant true : i1
  %false = scalar.constant false : i1
  %depth = config.get @ggml.mul_mat.vec_xs_depth : index
  %t0 = kernel.workitem.id<x> : index
  %t = index.assume %t0 [range(%t0, 0, 255)] : index
  %slot = index.div %t, %c16 : index
  %part = index.rem %t, %c16 : index
  %wg = kernel.workgroup.id<x> : index
  %batch = kernel.workgroup.id<z> : index
  %weight_noalias, %input_noalias, %dst_noalias = buffer.assume.noalias %weight, %input, %dst : buffer, buffer, buffer
  %stage = buffer.alloca<workgroup> align(16) %stage_bytes : buffer
  %stage_view = buffer.view %stage[%b0] : buffer -> view<4096xf32>
  %unit_bytes, %sb_bytes, %sb_units = template.apply<@ggml.weight.superblock>(%wtype) : (index) -> (offset, offset, index)
  %n_sb, %rows_par, %n_pass, %n_wg = func.call @ggml_hrx_mv_xs_plan(%n_rows, %k_size) : (index, index) -> (index, index, index, index)
  %row_off = index.div %slot, %n_sb : index
  %sb = index.rem %slot, %n_sb : index
  %slot_on = index.cmp ult, %row_off, %rows_par : index
  %pass0 = index.mul %wg, %n_pass : index
  %row0 = index.mul %pass0, %rows_par : index
  %wg_rows = index.mul %n_pass, %rows_par : index
  %row_end_raw = index.add %row0, %wg_rows : index
  %row_end = index.min %row_end_raw, %n_rows : index
  %last_row = index.sub %row_end, %c1 : index
  %w_batch, %x_batch, %d_batch = func.call @ggml_hrx_mul_mat_batch(%batch, %ne12, %r2, %r3, %w_s2, %w_s3, %x_s2, %x_s3, %d_s2, %d_s3) : (index, index, index, index, index, index, index, index, index, index) -> (index, index, index)
  // If the last row is in the weight span, all rows of the workgroup are in it.
  %w_last_offset = index.mul %last_row, %w_s1 : index
  %w_last_base = index.add %w_batch, %w_last_offset : index
  %k_tail = config.get @ggml.mul_mat.vec_k_tail : index
  %has_tail = index.cmp ne, %k_tail, %c0 : index
  %full_units = index.mul %n_sb, %sb_units : index
  %k_units = index.mul %k_size, %sb_units : index
  %tail_units = index.div %k_units, %c256 : index
  %row_units = scf.select %has_tail, %tail_units, %full_units : index
  %w_last_end = index.add %w_last_base, %row_units : index
  %w_ok = index.cmp ule, %w_last_end, %w_span : index
  %x_base0, %use0, %store0, %x_ok0 = func.call @ggml_hrx_mv_col_base(%c0, %n_tile, %n_cols, %x_batch, %x_s1, %k_size, %x_span, %true) : (index, index, index, index, index, index, index, i1) -> (index, i1, i1, i1)
  %x_base1, %use1, %store1, %x_ok1 = func.call @ggml_hrx_mv_col_base(%c1, %n_tile, %n_cols, %x_batch, %x_s1, %k_size, %x_span, %x_ok0) : (index, index, index, index, index, index, index, i1) -> (index, i1, i1, i1)
  %x_base2, %use2, %store2, %x_ok2 = func.call @ggml_hrx_mv_col_base(%c2, %n_tile, %n_cols, %x_batch, %x_s1, %k_size, %x_span, %x_ok1) : (index, index, index, index, index, index, index, i1) -> (index, i1, i1, i1)
  %x_base3, %use3, %store3, %x_ok3 = func.call @ggml_hrx_mv_col_base(%c3, %n_tile, %n_cols, %x_batch, %x_s1, %k_size, %x_span, %x_ok2) : (index, index, index, index, index, index, index, i1) -> (index, i1, i1, i1)
  %x_base4, %use4, %store4, %x_ok4 = func.call @ggml_hrx_mv_col_base(%c4, %n_tile, %n_cols, %x_batch, %x_s1, %k_size, %x_span, %x_ok3) : (index, index, index, index, index, index, index, i1) -> (index, i1, i1, i1)
  %x_base5, %use5, %store5, %x_ok5 = func.call @ggml_hrx_mv_col_base(%c5, %n_tile, %n_cols, %x_batch, %x_s1, %k_size, %x_span, %x_ok4) : (index, index, index, index, index, index, index, i1) -> (index, i1, i1, i1)
  %x_base6, %use6, %store6, %x_ok6 = func.call @ggml_hrx_mv_col_base(%c6, %n_tile, %n_cols, %x_batch, %x_s1, %k_size, %x_span, %x_ok5) : (index, index, index, index, index, index, index, i1) -> (index, i1, i1, i1)
  %x_base7, %use7, %store7, %x_ok = func.call @ggml_hrx_mv_col_base(%c7, %n_tile, %n_cols, %x_batch, %x_s1, %k_size, %x_span, %x_ok6) : (index, index, index, index, index, index, index, i1) -> (index, i1, i1, i1)
  %ok = scf.select %w_ok, %x_ok, %false : i1
  scf.if %ok {
    %o0, %o1, %o2, %o3 = template.apply<@ggml.weight.offsets16>(%wtype, %part) : (index, index) -> (index, index, index, index)
    // A lane past K in the partial superblock loads no data. The dot products stay uniform in each group of 16 lanes.
    %sb_k = index.mul %sb, %c256 : index
    %lane_last = index.add %o3, %c4 : index
    %lane_end = index.add %sb_k, %lane_last : index
    %lane_in = index.cmp ule, %lane_end, %k_size : index
    %lane_ok = scf.select %has_tail, %lane_in, %true : i1
    %xu0 = scf.select %lane_ok, %use0, %false : i1
    %xu1 = scf.select %lane_ok, %use1, %false : i1
    %xu2 = scf.select %lane_ok, %use2, %false : i1
    %xu3 = scf.select %lane_ok, %use3, %false : i1
    %xu4 = scf.select %lane_ok, %use4, %false : i1
    %xu5 = scf.select %lane_ok, %use5, %false : i1
    %xu6 = scf.select %lane_ok, %use6, %false : i1
    %xu7 = scf.select %lane_ok, %use7, %false : i1
    %x00, %x01, %x02, %x03 = func.call @ggml_hrx_mv_xload(%xu0, %input_noalias, %x_base0, %sb, %o0, %o1, %o2, %o3) : (i1, buffer, index, index, index, index, index, index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>)
    %x10, %x11, %x12, %x13 = func.call @ggml_hrx_mv_xload(%xu1, %input_noalias, %x_base1, %sb, %o0, %o1, %o2, %o3) : (i1, buffer, index, index, index, index, index, index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>)
    %x20, %x21, %x22, %x23 = func.call @ggml_hrx_mv_xload(%xu2, %input_noalias, %x_base2, %sb, %o0, %o1, %o2, %o3) : (i1, buffer, index, index, index, index, index, index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>)
    %x30, %x31, %x32, %x33 = func.call @ggml_hrx_mv_xload(%xu3, %input_noalias, %x_base3, %sb, %o0, %o1, %o2, %o3) : (i1, buffer, index, index, index, index, index, index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>)
    %x40, %x41, %x42, %x43 = func.call @ggml_hrx_mv_xload(%xu4, %input_noalias, %x_base4, %sb, %o0, %o1, %o2, %o3) : (i1, buffer, index, index, index, index, index, index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>)
    %x50, %x51, %x52, %x53 = func.call @ggml_hrx_mv_xload(%xu5, %input_noalias, %x_base5, %sb, %o0, %o1, %o2, %o3) : (i1, buffer, index, index, index, index, index, index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>)
    %x60, %x61, %x62, %x63 = func.call @ggml_hrx_mv_xload(%xu6, %input_noalias, %x_base6, %sb, %o0, %o1, %o2, %o3) : (i1, buffer, index, index, index, index, index, index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>)
    %x70, %x71, %x72, %x73 = func.call @ggml_hrx_mv_xload(%xu7, %input_noalias, %x_base7, %sb, %o0, %o1, %o2, %o3) : (i1, buffer, index, index, index, index, index, index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>)
    %w_batch_byte = index.scale %w_batch, %unit_bytes : index, offset -> offset
    %sb_offset = index.scale %sb, %sb_bytes : index, offset -> offset
    %w_sb_byte = index.add %w_batch_byte, %sb_offset : offset
    %in_tile = index.cmp ult, %part, %n_tile : index
    %writer = scf.select %slot_on, %in_tile, %false : i1
    %is1 = index.cmp eq, %part, %c1 : index
    %is2 = index.cmp eq, %part, %c2 : index
    %is3 = index.cmp eq, %part, %c3 : index
    %is4 = index.cmp eq, %part, %c4 : index
    %is5 = index.cmp eq, %part, %c5 : index
    %is6 = index.cmp eq, %part, %c6 : index
    %is7 = index.cmp eq, %part, %c7 : index
    scf.for %p = [%c0 to %n_pass step %c1] pipeline(%depth) {
      // A row past the end reads the last row. The final sum skips its partial.
      %pass = index.add %pass0, %p : index
      %pass_row = index.mul %pass, %rows_par : index
      %row_raw = index.add %pass_row, %row_off : index
      %row_in = index.cmp ult, %row_raw, %n_rows : index
      %row = scf.select %row_in, %row_raw, %last_row : index
      %w_row = index.mul %row, %w_s1 : index
      %w_row_byte = index.scale %w_row, %unit_bytes : index, offset -> offset
      %sb_byte = index.add %w_sb_byte, %w_row_byte : offset
      %d0, %d1, %d2, %d3 = scf.if %lane_ok -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) {
        %e0, %e1, %e2, %e3, %q0, %q1, %q2, %q3 = template.apply<@ggml.weight.part16>(%wtype, %weight_noalias, %sb_byte, %part) : (index, buffer, offset, index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, index, index, index, index)
        scf.yield %e0, %e1, %e2, %e3 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
      } else {
        scf.yield %zero4, %zero4, %zero4, %zero4 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
      }
      %s0 = func.call @ggml_hrx_mv_dot16(%use0, %d0, %d1, %d2, %d3, %x00, %x01, %x02, %x03) : (i1, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) -> (f32)
      %s1 = func.call @ggml_hrx_mv_dot16(%use1, %d0, %d1, %d2, %d3, %x10, %x11, %x12, %x13) : (i1, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) -> (f32)
      %s2 = func.call @ggml_hrx_mv_dot16(%use2, %d0, %d1, %d2, %d3, %x20, %x21, %x22, %x23) : (i1, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) -> (f32)
      %s3 = func.call @ggml_hrx_mv_dot16(%use3, %d0, %d1, %d2, %d3, %x30, %x31, %x32, %x33) : (i1, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) -> (f32)
      %s4 = func.call @ggml_hrx_mv_dot16(%use4, %d0, %d1, %d2, %d3, %x40, %x41, %x42, %x43) : (i1, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) -> (f32)
      %s5 = func.call @ggml_hrx_mv_dot16(%use5, %d0, %d1, %d2, %d3, %x50, %x51, %x52, %x53) : (i1, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) -> (f32)
      %s6 = func.call @ggml_hrx_mv_dot16(%use6, %d0, %d1, %d2, %d3, %x60, %x61, %x62, %x63) : (i1, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) -> (f32)
      %s7 = func.call @ggml_hrx_mv_dot16(%use7, %d0, %d1, %d2, %d3, %x70, %x71, %x72, %x73) : (i1, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) -> (f32)
      %v1 = scf.select %is1, %s1, %s0 : f32
      %v2 = scf.select %is2, %s2, %v1 : f32
      %v3 = scf.select %is3, %s3, %v2 : f32
      %v4 = scf.select %is4, %s4, %v3 : f32
      %v5 = scf.select %is5, %s5, %v4 : f32
      %v6 = scf.select %is6, %s6, %v5 : f32
      %v7 = scf.select %is7, %s7, %v6 : f32
      scf.if %writer {
        %i_raw = func.call @ggml_hrx_mv_xs_stage_index(%p, %part, %slot) : (index, index, index) -> (index)
        %i = index.assume %i_raw [range(%i_raw, 0, 4095)] : index
        %i_in = index.cmp ult, %i, %c4096 : index
        scf.if %i_in {
          view.store %v7, %stage_view[%i] : f32, view<4096xf32>
        }
      }
    }
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  scf.if %ok {
    %n_out = index.mul %wg_rows, %n_tile : index
    scf.for %o_raw = [%t to %n_out step %c256] {
      %o = index.assume %o_raw [range(%o_raw, 0, 4095)] : index
      %row_local = index.div %o, %n_tile : index
      %col = index.rem %o, %n_tile : index
      %p = index.div %row_local, %rows_par : index
      %ro = index.rem %row_local, %rows_par : index
      %row = index.add %row0, %row_local : index
      %row_in = index.cmp ult, %row, %n_rows : index
      %col_in = index.cmp ult, %col, %n_cols : index
      %st = scf.select %row_in, %col_in, %false : i1
      scf.if %st {
        %ro_slots = index.mul %ro, %n_sb : index
        %sum = scf.for %j = [%c0 to %n_sb step %c1](%acc = %zero : f32) -> (f32) {
          %slot_j = index.add %ro_slots, %j : index
          %i_raw = func.call @ggml_hrx_mv_xs_stage_index(%p, %col, %slot_j) : (index, index, index) -> (index)
          %i = index.assume %i_raw [range(%i_raw, 0, 4095)] : index
          %i_in = index.cmp ult, %i, %c4096 : index
          %next = scf.if %i_in -> (f32) {
            %part_sum = view.load %stage_view[%i] : view<4096xf32> -> f32
            %a = scalar.addf %acc, %part_sum : f32
            scf.yield %a : f32
          } else {
            scf.yield %acc : f32
          }
          scf.yield %next : f32
        }
        %d_offset = index.mul %col, %d_s1 : index
        %d_col = index.add %d_batch, %d_offset : index
        %d_index = index.add %d_col, %row : index
        func.call @ggml_hrx_mm_store(%dst_noalias, %d_span, %d_index, %sum) : (buffer, index, index, f32)
      }
    }
  }
  kernel.return
}

