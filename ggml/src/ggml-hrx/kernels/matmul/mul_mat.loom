  %vz = scf.select %ok, %v, %zero4 : vector<4xf32>
  %k1 = index.add %k4, %c1 : index
  %k2 = index.add %k4, %c2 : index
  %k3 = index.add %k4, %c3 : index
  %v0 = vector.extract %vz[0] : vector<4xf32> -> f32
  %v1 = vector.extract %vz[1] : vector<4xf32> -> f32
  %v2 = vector.extract %vz[2] : vector<4xf32> -> f32
  %v3 = vector.extract %vz[3] : vector<4xf32> -> f32
  view.store %v0, %stage[%k4, %pos] : f32, view<32x64xf32>
  view.store %v1, %stage[%k1, %pos] : f32, view<32x64xf32>
  view.store %v2, %stage[%k2, %pos] : f32, view<32x64xf32>
  view.store %v3, %stage[%k3, %pos] : f32, view<32x64xf32>
  func.return
}

// x is staged by column: 8 lanes load 32 contiguous K values of a column.
func.def inline @ggml_hrx_mtf_stage_x(%stage: view<64x36xf32>, %pos: index, %k4: index, %valid: i1, %k: index, %k_len: index, %v: vector<4xf32>) {
  %zero4 = vector.splatf 0.0 : vector<4xf32>
  %k_in = index.cmp ult, %k, %k_len : index
  %ok = scalar.andi %valid, %k_in : i1
  %vz = scf.select %ok, %v, %zero4 : vector<4xf32>
  vector.store %vz, %stage[%pos, %k4] : vector<4xf32>, view<64x36xf32>
  func.return
}

// 64 x 64 tile of plain weight types with K steps of 32. Each lane computes 4 rows x 4 columns.
// The next K step is loaded to registers while the lanes compute the current step.
