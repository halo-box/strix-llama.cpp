// Input column c of the small-K kernel. A column past n_cols reads nothing.
func.def inline @ggml_hrx_mm_sk_col(%c: index, %col0: index, %n_cols: index, %x_batch: index, %x_s1: index) -> (index, i1) {
  %col = index.add %col0, %c : index
  %valid = index.cmp ult, %col, %n_cols : index
  %x_offset = index.mul %col, %x_s1 : index
  %x_base = index.add %x_batch, %x_offset : index
  func.return %x_base, %valid : index, i1
}

func.def inline @ggml_hrx_mm_sk_store(%dst: buffer, %d_span: index, %d_batch: index, %d_s1: index, %c: index, %col0: index, %n_cols: index, %row: index, %row_valid: i1, %value: f32) {
