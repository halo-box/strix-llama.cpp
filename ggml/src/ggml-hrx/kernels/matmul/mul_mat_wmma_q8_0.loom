  %last_col = index.sub %n_cols, %c1 : index
  %x_col = index.min %x_col0, %last_col : index
  %x_offset = index.mul %x_col, %x_s1 : index
  %x_base = index.add %x_batch, %x_offset : index
  %x_k0 = index.mul %x_part, %c32 : index
  %x_k1 = index.add %x_k0, %c8 : index
  %x_k2 = index.add %x_k0, %c16 : index
  %x_k3 = index.add %x_k0, %c24 : index

  %sub_col_group = index.rem %s, %c2 : index
  %sub_row_group = index.div %s, %c2 : index
  %sub_col0 = index.mul %sub_col_group, %c64 : index
  %sub_row0 = index.mul %sub_row_group, %c32 : index

  %init = template.apply<@ggml.mma.zero_acc>() : () -> (vector<8xf32>)
  %d_load, %q0_first, %q1_first, %x0_first, %x1_first = func.call @ggml_hrx_mmq8_loads(%weight_noalias, %w_span, %w_base, %input_noalias, %x_span, %x_base, %w_k0, %x_k0) : (buffer, index, index, buffer, index, index, index, index) -> (i16, vector<8xi16>, vector<8xi16>, vector<8xf32>, vector<8xf32>)
  %x2_first = func.call @ggml_hrx_mmq8_input8(%input_noalias, %x_span, %x_base, %x_k2) : (buffer, index, index, index) -> (vector<8xf32>)
  %x3_first = func.call @ggml_hrx_mmq8_input8(%input_noalias, %x_span, %x_base, %x_k3) : (buffer, index, index, index) -> (vector<8xf32>)
  %d_first, %xh0_first, %xh1_first = func.call @ggml_hrx_mmq8_mask(%k_size, %w_k0, %x_k0, %d_load, %x0_first, %x1_first) : (index, index, index, i16, vector<8xf32>, vector<8xf32>) -> (i16, vector<8xf16>, vector<8xf16>)
  %d_unused, %xh2_first, %xh3_first = func.call @ggml_hrx_mmq8_mask(%k_size, %w_k0, %x_k0, %d_load, %x2_first, %x3_first) : (index, index, index, i16, vector<8xf32>, vector<8xf32>) -> (i16, vector<8xf16>, vector<8xf16>)
  %acc00, %acc01, %acc10, %acc11, %acc20, %acc21, %acc30, %acc31, %d_last, %q0_last, %q1_last, %xh0_last, %xh1_last, %xh2_last, %xh3_last = scf.for %k0 = [%c0 to %k_size step %c64](%a00 = %init : vector<8xf32>, %a01 = %init : vector<8xf32>, %a10 = %init : vector<8xf32>, %a11 = %init : vector<8xf32>, %a20 = %init : vector<8xf32>, %a21 = %init : vector<8xf32>, %a30 = %init : vector<8xf32>, %a31 = %init : vector<8xf32>, %d = %d_first : i16, %q0 = %q0_first : vector<8xi16>, %q1 = %q1_first : vector<8xi16>, %xh0 = %xh0_first : vector<8xf16>, %xh1 = %xh1_first : vector<8xf16>, %xh2 = %xh2_first : vector<8xf16>, %xh3 = %xh3_first : vector<8xf16>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, i16, vector<8xi16>, vector<8xi16>, vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>) {
    %v0, %v1, %v2, %v3 = template.apply<@ggml.q8_0.decode32_f16>(%d, %q0, %q1) : (i16, vector<8xi16>, vector<8xi16>) -> (vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>)
    vector.store %v0, %w_view[%w_local, %w_k0] : vector<8xf16>, view<128x72xf16>
    vector.store %v1, %w_view[%w_local, %w_k1] : vector<8xf16>, view<128x72xf16>
    vector.store %v2, %w_view[%w_local, %w_k2] : vector<8xf16>, view<128x72xf16>
    vector.store %v3, %w_view[%w_local, %w_k3] : vector<8xf16>, view<128x72xf16>
    vector.store %xh0, %x_view[%x_local, %x_k0] : vector<8xf16>, view<128x72xf16>
    vector.store %xh1, %x_view[%x_local, %x_k1] : vector<8xf16>, view<128x72xf16>
    vector.store %xh2, %x_view[%x_local, %x_k2] : vector<8xf16>, view<128x72xf16>
    vector.store %xh3, %x_view[%x_local, %x_k3] : vector<8xf16>, view<128x72xf16>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    // The loads after the last step read valid memory. Their values are not used.
    %k_next = index.add %k0, %c64 : index
    %w_k_next = index.add %k_next, %w_k0 : index
    %x_k_next = index.add %k_next, %x_k0 : index
    %x_k_next2 = index.add %k_next, %x_k2 : index
    %x_k_next3 = index.add %k_next, %x_k3 : index
    %d_raw, %q0n, %q1n, %x0n, %x1n = func.call @ggml_hrx_mmq8_loads(%weight_noalias, %w_span, %w_base, %input_noalias, %x_span, %x_base, %w_k_next, %x_k_next) : (buffer, index, index, buffer, index, index, index, index) -> (i16, vector<8xi16>, vector<8xi16>, vector<8xf32>, vector<8xf32>)
    %x2n = func.call @ggml_hrx_mmq8_input8(%input_noalias, %x_span, %x_base, %x_k_next2) : (buffer, index, index, index) -> (vector<8xf32>)
    %x3n = func.call @ggml_hrx_mmq8_input8(%input_noalias, %x_span, %x_base, %x_k_next3) : (buffer, index, index, index) -> (vector<8xf32>)
    scf.schedule.fence
    %n00, %n01, %n10, %n11, %n20, %n21, %n30, %n31 = template.apply<@ggml.mma.k64_4x2>(%x_stage, %w_stage, %sub_col0, %sub_row0, %a00, %a01, %a10, %a11, %a20, %a21, %a30, %a31) : (buffer, buffer, index, index, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>)
    scf.schedule.fence
    %dn, %xh0n, %xh1n = func.call @ggml_hrx_mmq8_mask(%k_size, %w_k_next, %x_k_next, %d_raw, %x0n, %x1n) : (index, index, index, i16, vector<8xf32>, vector<8xf32>) -> (i16, vector<8xf16>, vector<8xf16>)
    %dn_unused, %xh2n, %xh3n = func.call @ggml_hrx_mmq8_mask(%k_size, %w_k_next, %x_k_next, %d_raw, %x2n, %x3n) : (index, index, index, i16, vector<8xf32>, vector<8xf32>) -> (i16, vector<8xf16>, vector<8xf16>)
    // The next K step overwrites the stages.
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %n00, %n01, %n10, %n11, %n20, %n21, %n30, %n31, %dn, %q0n, %q1n, %xh0n, %xh1n, %xh2n, %xh3n : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, i16, vector<8xi16>, vector<8xi16>, vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>
