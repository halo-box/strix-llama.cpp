  func.call @ggml_hrx_mm_wmma_store(%dst_noalias, %d_span, %d_batch, %d_s1, %out_col2, %n_cols, %out_row0, %n_rows, %acc20) : (buffer, index, index, index, index, index, index, index, vector<8xf32>)
  func.call @ggml_hrx_mm_wmma_store(%dst_noalias, %d_span, %d_batch, %d_s1, %out_col2, %n_cols, %out_row1, %n_rows, %acc21) : (buffer, index, index, index, index, index, index, index, vector<8xf32>)
  func.call @ggml_hrx_mm_wmma_store(%dst_noalias, %d_span, %d_batch, %d_s1, %out_col3, %n_cols, %out_row0, %n_rows, %acc30) : (buffer, index, index, index, index, index, index, index, vector<8xf32>)
  func.call @ggml_hrx_mm_wmma_store(%dst_noalias, %d_span, %d_batch, %d_s1, %out_col3, %n_cols, %out_row1, %n_rows, %acc31) : (buffer, index, index, index, index, index, index, index, vector<8xf32>)
