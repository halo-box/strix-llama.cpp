    }
    // The next tile writes the LDS again.
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %kt_n, %cm_new, %cl_new, %con0, %con1, %con2, %con3, %con4, %con5, %con6, %con7, %nx_r0, %nx_r1 : index, f32, f32, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf16>, vector<8xf16>
  }

  // The sink of the head is one more logit in the softmax. It has no V row. A row with no unmasked key gets 0, as on the CPU.
  %sinks_on = index.cmp ne, %has_sinks, %c0 : index
  %sink_row = scalar.andi %sinks_on, %rv : i1
