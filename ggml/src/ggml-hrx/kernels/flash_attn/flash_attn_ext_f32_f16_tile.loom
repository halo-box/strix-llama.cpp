  %bs_view = buffer.view %bias_s[%zero] : buffer -> view<[%bs_span]xf32>
  %r_off_b = index.scale %r_off, %f32_bytes : index, offset -> offset
  %cls_view = buffer.view %range[%r_off_b] : buffer -> view<[%r_span]xi32>

  // K [32 x 128] and V^T [128 x 32] tiles, rows padded by 8 halves.
  %k_bytes = index.constant 8704 : offset
  %k_lds = buffer.alloca<workgroup> align(16) %k_bytes : buffer
  %k_view = buffer.view %k_lds[%zero] : buffer -> view<32x136xf16>
  %vt_bytes = index.constant 10240 : offset
  %vt_lds = buffer.alloca<workgroup> align(16) %vt_bytes : buffer
  %vt_view = buffer.view %vt_lds[%zero] : buffer -> view<128x40xf16>
  %vtw_view = buffer.view %vt_lds[%zero] : buffer -> view<128x20xi32>

  // The wave's head and query tile. The lane's query is tok.
  %hl = index.rem %wave, %hg : index
  %sub = index.div %wave, %hg : index
  %h0 = index.mul %group, %hg : index
  %head = index.add %h0, %hl : index
  %ik2 = index.div %h0, %ratio : index
  %ik3 = index.div %iq3, %r3 : index
  %tq0 = index.mul %tile, %qt : index
  %tq1 = index.add %tq0, %sub : index
  %tok0 = index.mul %tq1, %c16 : index
  %tok = index.add %tok0, %lane_col : index
  %rv = index.cmp ult, %tok, %n_q : index

