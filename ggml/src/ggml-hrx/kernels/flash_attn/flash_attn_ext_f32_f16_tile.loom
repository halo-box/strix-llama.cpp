  %q_o2 = index.mul %head, %q_s2 : index
  %q_o3 = index.mul %iq3, %q_s3 : index
  %q_o12 = index.add %q_o1, %q_o2 : index
  %q_base = index.add %q_o12, %q_o3 : index
  %q_top = index.sub %q_span, %c1 : index
  %qd0 = index.constant 0 : index
  %qb0 = index.add %q_base, %qd0 : index
  %qh0 = func.call @ggml_hrx_fat_q16(%q_view, %q_span, %q_top, %qb0, %rv, %scale) : (view<[%q_span]xf32>, index, index, index, i1, f32) -> (vector<16xf16>)
  %qf0 = vector.fragment<rhs> %qh0 shape [%c16, %c16] : vector<16xf16>
  %qd1 = index.constant 16 : index
  %qb1 = index.add %q_base, %qd1 : index
  %qh1 = func.call @ggml_hrx_fat_q16(%q_view, %q_span, %q_top, %qb1, %rv, %scale) : (view<[%q_span]xf32>, index, index, index, i1, f32) -> (vector<16xf16>)
  %qf1 = vector.fragment<rhs> %qh1 shape [%c16, %c16] : vector<16xf16>
  %qd2 = index.constant 32 : index
  %qb2 = index.add %q_base, %qd2 : index
  %qh2 = func.call @ggml_hrx_fat_q16(%q_view, %q_span, %q_top, %qb2, %rv, %scale) : (view<[%q_span]xf32>, index, index, index, i1, f32) -> (vector<16xf16>)
  %qf2 = vector.fragment<rhs> %qh2 shape [%c16, %c16] : vector<16xf16>
  %qd3 = index.constant 48 : index
  %qb3 = index.add %q_base, %qd3 : index
  %qh3 = func.call @ggml_hrx_fat_q16(%q_view, %q_span, %q_top, %qb3, %rv, %scale) : (view<[%q_span]xf32>, index, index, index, i1, f32) -> (vector<16xf16>)
  %qf3 = vector.fragment<rhs> %qh3 shape [%c16, %c16] : vector<16xf16>
  %qd4 = index.constant 64 : index
  %qb4 = index.add %q_base, %qd4 : index
  %qh4 = func.call @ggml_hrx_fat_q16(%q_view, %q_span, %q_top, %qb4, %rv, %scale) : (view<[%q_span]xf32>, index, index, index, i1, f32) -> (vector<16xf16>)
  %qf4 = vector.fragment<rhs> %qh4 shape [%c16, %c16] : vector<16xf16>
  %qd5 = index.constant 80 : index
  %qb5 = index.add %q_base, %qd5 : index
  %qh5 = func.call @ggml_hrx_fat_q16(%q_view, %q_span, %q_top, %qb5, %rv, %scale) : (view<[%q_span]xf32>, index, index, index, i1, f32) -> (vector<16xf16>)
  %qf5 = vector.fragment<rhs> %qh5 shape [%c16, %c16] : vector<16xf16>
  %qd6 = index.constant 96 : index
  %qb6 = index.add %q_base, %qd6 : index
  %qh6 = func.call @ggml_hrx_fat_q16(%q_view, %q_span, %q_top, %qb6, %rv, %scale) : (view<[%q_span]xf32>, index, index, index, i1, f32) -> (vector<16xf16>)
  %qf6 = vector.fragment<rhs> %qh6 shape [%c16, %c16] : vector<16xf16>
  %qd7 = index.constant 112 : index
  %qb7 = index.add %q_base, %qd7 : index
  %qh7 = func.call @ggml_hrx_fat_q16(%q_view, %q_span, %q_top, %qb7, %rv, %scale) : (view<[%q_span]xf32>, index, index, index, i1, f32) -> (vector<16xf16>)
  %qf7 = vector.fragment<rhs> %qh7 shape [%c16, %c16] : vector<16xf16>

  // Mask row of the lane's query and head, bias rows of the query and head. The queries of all sequences are flattened.
  %mask_cfg = config.get @ggml.flash_attn.mask : index
  %mask_on = index.cmp ne, %mask_cfg, %c0 : index
  %bias_cfg = config.get @ggml.flash_attn.bias : index
  %bias_on = index.cmp ne, %bias_cfg, %c0 : index
  %im2 = index.rem %head, %m_ne2 : index
  %im3 = index.rem %iq3, %m_ne3 : index
  %nq_top = index.sub %n_q, %c1 : index
  %tok_c = index.min %tok, %nq_top : index
  %bins_top = index.sub %n_bins, %c1 : index
  %vec_cfg = config.get @ggml.flash_attn.vec_mask : index
  %vec_on = index.cmp ne, %vec_cfg, %c0 : index
  %m_top16 = index.sub %m_span, %c16 : index
  %i_top16 = index.sub %i_span, %c16 : index
  %mb_t = index.mul %tok_c, %m_s1 : index
  %mb_h = index.mul %im2, %m_s2 : index
  %mb_s = index.mul %im3, %m_s3 : index
  %mb_th = index.add %mb_t, %mb_h : index
  %mb = index.add %mb_th, %mb_s : index
  %qf_s = index.mul %iq3, %n_q : index
  %q_flat = index.add %qf_s, %tok_c : index
  %ib = index.mul %q_flat, %i_s1 : index
  %tb_q = index.mul %q_flat, %n_head : index
  %tb_qh = index.add %tb_q, %head : index
  %tb = index.mul %tb_qh, %n_bins : index
  %bsub_cfg = config.get @ggml.flash_attn.bias_sub : index
  %bsub_on = index.cmp ne, %bsub_cfg, %c0 : index
  %s_row = scf.if %bsub_on -> (f32) {
    %bs_q = index.mul %q_flat, %bs_s2 : index
    %bs_h = index.mul %head, %bs_s1 : index
    %bs_raw0 = index.add %bs_q, %bs_h : index
    %bs_raw = index.assume %bs_raw0 [range(%bs_raw0, 0, 2147483646)] : index
    %bs_top = index.sub %bs_span, %c1 : index
    %bs_idx0 = index.min %bs_raw, %bs_top : index
    %bs_idx = index.assume %bs_idx0 [lt(%bs_idx0, %bs_span)] : index
    %sv0 = view.load %bs_view[%bs_idx] : view<[%bs_span]xf32> -> f32
    scf.yield %sv0 : f32
  } else {
    scf.yield %zero_f32 : f32
  }

  %bmm_cfg = config.get @ggml.flash_attn.bias_mm : index
  %bmm_on = index.cmp ne, %bmm_cfg, %c0 : index
  %zero16f = vector.splatf 0.0 : vector<16xf32>
  %rr_view = buffer.view %bias_r[%zero] : buffer -> view<[%rr_span]xf32>
  %rr_q = index.mul %q_flat, %rr_s2 : index
  %rr_h = index.mul %head, %rr_s1 : index
  %rr_b = index.add %rr_q, %rr_h : index
  %rr_top = index.sub %rr_span, %c1 : index
  %rq = scf.if %bmm_on -> (vector<16xf32>) {
    %rq16 = func.call @ggml_hrx_fat_load16(%rr_view, %rr_span, %rr_top, %rr_b, %rv, %one_f32) : (view<[%rr_span]xf32>, index, index, index, i1, f32) -> (vector<16xf32>)
    scf.yield %rq16 : vector<16xf32>
  } else {
    scf.yield %zero16f : vector<16xf32>
  }

  // Tile classes: the wave's own block row, and the block rows of the workgroup.
  %kv_round = index.add %n_kv, %c31 : index
  %n_kt = index.div %kv_round, %c32 : index
  %cls_on = index.cmp ne, %has_cls, %c0 : index
  %own_r0 = index.mul %im3, %m_ne2 : index
  %own_r1 = index.add %own_r0, %im2 : index
  %own_r2 = index.mul %own_r1, %n_qb : index
  %own_r3 = index.add %own_r2, %tq1 : index
  %own_row = index.mul %own_r3, %n_words : index
  %mix_base = index.mul %n_rowsb, %n_words : index
  %own_mrow = index.add %own_row, %mix_base : index
  %wqb0 = index.mul %tile, %qt : index
  // The class words of the workgroup's block rows in LDS: act of row s at 64 s, mix at 512 + 64 s, the union of act at 1024,
  // toe at 1088 + 64 s, full at 1600 + 64 s. The host checks one mask head row and at most 64 words.
  %cls_bytes = index.constant 8448 : offset
  %cls_lds = buffer.alloca<workgroup> align(16) %cls_bytes : buffer
  %l_view = buffer.view %cls_lds[%zero] : buffer -> view<2112xi32>
  %c64w = index.constant 64 : index
  %c63w = index.constant 63 : index
  %c511w = index.constant 511 : index
  %c512w = index.constant 512 : index
  %c1024w = index.constant 1024 : index
  %c1088w = index.constant 1088 : index
  %c1600w = index.constant 1600 : index
  %zero_i32c = scalar.constant 0 : i32
  scf.if %cls_on {
    %fill_n = index.mul %qt, %n_words : index
    scf.for %e = [%t to %fill_n step %wg_size] {
      %fs = index.div %e, %n_words : index
      %fw = index.rem %e, %n_words : index
      %fqb = index.add %wqb0, %fs : index
      %fin = index.cmp ult, %fqb, %n_qb : index
      %fr0 = index.mul %im3, %n_qb : index
      %fr1 = index.add %fr0, %fqb : index
      %frow = index.mul %fr1, %n_words : index
      %fmrow = index.add %frow, %mix_base : index
      %ftrow = index.add %fmrow, %mix_base : index
      %ffrow = index.add %ftrow, %mix_base : index
      %fa0 = func.call @ggml_hrx_fat_cls(%cls_view, %r_span, %frow, %fw) : (view<[%r_span]xi32>, index, index, index) -> (i32)
      %fm0 = func.call @ggml_hrx_fat_cls(%cls_view, %r_span, %fmrow, %fw) : (view<[%r_span]xi32>, index, index, index) -> (i32)
      %ft0 = func.call @ggml_hrx_fat_cls(%cls_view, %r_span, %ftrow, %fw) : (view<[%r_span]xi32>, index, index, index) -> (i32)
      %ff0 = func.call @ggml_hrx_fat_cls(%cls_view, %r_span, %ffrow, %fw) : (view<[%r_span]xi32>, index, index, index) -> (i32)
      %fa = scf.select %fin, %fa0, %zero_i32c : i32
      %fm = scf.select %fin, %fm0, %zero_i32c : i32
      %ft = scf.select %fin, %ft0, %zero_i32c : i32
      %ff = scf.select %fin, %ff0, %zero_i32c : i32
      %fo0 = index.mul %fs, %c64w : index
      %fo1 = index.add %fo0, %fw : index
      %fo = index.min %fo1, %c511w : index
      %fmo = index.add %fo, %c512w : index
      view.store %fa, %l_view[%fo] : i32, view<2112xi32>
      view.store %fm, %l_view[%fmo] : i32, view<2112xi32>
      %fto = index.add %fo, %c1088w : index
      %ffo = index.add %fo, %c1600w : index
      view.store %ft, %l_view[%fto] : i32, view<2112xi32>
      view.store %ff, %l_view[%ffo] : i32, view<2112xi32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.for %uw = [%t to %n_words step %wg_size] {
      %un = scf.for %us = [%c0 to %qt step %c1](%uacc = %zero_i32c : i32) -> (i32) {
        %uo0 = index.mul %us, %c64w : index
        %uo1 = index.add %uo0, %uw : index
        %uo = index.min %uo1, %c511w : index
        %uv = view.load %l_view[%uo] : view<2112xi32> -> i32
        %uor = scalar.ori %uacc, %uv : i32
        scf.yield %uor : i32
      }
      %uwc = index.min %uw, %c63w : index
      %ui = index.add %uwc, %c1024w : index
      view.store %un, %l_view[%ui] : i32, view<2112xi32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  }
  %bins_top_i32 = index.cast %bins_top : index to i32
  // The bias of a plain tile: the last bin, mask 0.
  %crow = scf.if %bias_on -> (f32) {
    %cb = scf.if %bmm_on -> (f32) {
      %cm = func.call @ggml_hrx_fat_mm(%t_view, %t_span, %bins_top, %w_s1, %bins_top_i32, %rq, %zero_f32, %s_row) : (view<[%t_span]xf32>, index, index, index, i32, vector<16xf32>, f32, f32) -> (f32)
      scf.yield %cm : f32
    } else {
      %ct = func.call @ggml_hrx_fat_table(%t_view, %t_span, %bins_top, %tb, %bins_top_i32, %zero_f32, %s_row) : (view<[%t_span]xf32>, index, index, index, i32, f32, f32) -> (f32)
      scf.yield %ct : f32
    }
    scf.yield %cb : f32
  } else {
    scf.yield %zero_f32 : f32
  }
  %crow8 = vector.splat %crow : vector<8xf32>
  // Toeplitz tiles: 48 x 18 halves of LDS for each wave, e of the wave's block row at 4 R + 32 (row n_words) + kt.
  %toep_cfg = config.get @ggml.flash_attn.toep : index
  %toep_on = index.cmp ne, %toep_cfg, %c0 : index
  %c1728x = index.constant 1728 : index
  %c4l = index.constant 4 : index
  %one_bx = index.constant 1 : offset
  %x_size0 = index.mul %waves, %c1728x : index
  %x_size = scf.select %toep_on, %x_size0, %c16 : index
  %x_bytes = index.scale %x_size, %one_bx : index, offset -> offset
  %x_lds = buffer.alloca<workgroup> align(16) %x_bytes : buffer
  %x_off0 = index.mul %wave, %c1728x : index
  %x_off1 = scf.select %toep_on, %x_off0, %c0 : index
  %x_off = index.scale %x_off1, %one_bx : index, offset -> offset
  %x_view = buffer.view %x_lds[%x_off] : buffer -> view<48x18xf16>
  %e_r0 = index.mul %own_row, %c32 : index
  %e_r1 = index.mul %mix_base, %c4l : index
  %e_rbase = index.add %e_r0, %e_r1 : index
  %r_top = index.sub %r_span, %c1 : index

  %k_o2 = index.mul %ik2, %k_s2 : index
  %k_o3 = index.mul %ik3, %k_s3 : index
  %k_head = index.add %k_o2, %k_o3 : index
  %v_o2 = index.mul %ik2, %v_s2 : index
  %v_o3 = index.mul %ik3, %v_s3 : index
  %v_head = index.add %v_o2, %v_o3 : index
  %k_layout = encoding.layout.strided [%k_s1, 1] : encoding<layout>
  %v_layout = encoding.layout.strided [%v_s1, 1] : encoding<layout>
  %kv_last = index.sub %n_kv, %c1 : index

  // Loaders of the prefetch: waves 0-7 take key 4 w + lane % 4, channels 8 (lane / 4) and 64 more; waves 8-15 take keys 2 p and
  // 2 p + 1 with p = lane % 16, channels 8 (2 (w - 8) + lane / 16).
  %pf_cfg = config.get @ggml.flash_attn.prefetch : index
  %pf_on = index.cmp ne, %pf_cfg, %c0 : index
  %c7l = index.constant 7 : index
  %c8l = index.constant 8 : index
  %c15l = index.constant 15 : index
  %c16l = index.constant 16 : index
  %c64l = index.constant 64 : index
  %is_kl = index.cmp ult, %wave, %c8l : index
  %ge8 = index.cmp uge, %wave, %c8l : index
  %lt16 = index.cmp ult, %wave, %c16l : index
  %is_vl0 = scalar.andi %ge8, %lt16 : i1
  %is_vl = scalar.andi %is_vl0, %pf_on : i1
  %wk = index.min %wave, %c7l : index
  %lm4 = index.rem %lane, %c4l : index
  %ld4 = index.div %lane, %c4l : index
  %kl_key0 = index.mul %wk, %c4l : index
  %kl_key1 = index.add %kl_key0, %lm4 : index
  %kl_key = index.assume %kl_key1 [range(%kl_key1, 0, 31)] : index
  %kl_d0a = index.mul %ld4, %c8l : index
  %kl_d0 = index.assume %kl_d0a [range(%kl_d0a, 0, 56), multiple_of(%kl_d0a, 8)] : index
  %kl_d1a = index.add %kl_d0, %c64l : index
  %kl_d1 = index.assume %kl_d1a [range(%kl_d1a, 64, 120), multiple_of(%kl_d1a, 8)] : index
  // w - 8 for the V loaders.
  %wv = index.rem %wave, %c8l : index
  %vl_kp = index.assume %lane_col [range(%lane_col, 0, 15)] : index
  %vl_ch0 = index.mul %wv, %c2 : index
  %vl_ch1 = index.add %vl_ch0, %lane_half : index
  %vl_d0a = index.mul %vl_ch1, %c8l : index
  %vl_d0 = index.assume %vl_d0a [range(%vl_d0a, 0, 120), multiple_of(%vl_d0a, 8)] : index
  %vl_key0 = index.mul %vl_kp, %c2 : index
  %zero8h = vector.splatf 0.0 : vector<8xf16>
  %kt0 = func.call @ggml_hrx_fat_next(%cls_on, %l_view, %c0, %n_kt) : (i1, view<2112xi32>, index, index) -> (index)
  %pro_kt_c0 = index.sub %n_kt, %c1 : index
  %pro_kt_c = index.min %kt0, %pro_kt_c0 : index
  %pro_kbase = index.mul %pro_kt_c, %c32 : index
  %pro_r0, %pro_r1 = scf.if %pf_on -> (vector<8xf16>, vector<8xf16>) {
    %pro_rr0, %pro_rr1 = scf.if %is_kl -> (vector<8xf16>, vector<8xf16>) {
      %pro_kk = index.add %pro_kbase, %kl_key : index
      %pro_kin = index.cmp ult, %pro_kk, %n_kv : index
      %pro_kc = index.min %pro_kk, %kv_last : index
      %pro_ka = func.call @ggml_hrx_fat_row8(%k_aligned, %k_head, %k_s1, %pro_kc, %kl_d0, %pro_kin) : (buffer, index, index, index, index, i1) -> (vector<8xf16>)
      %pro_kb2 = func.call @ggml_hrx_fat_row8(%k_aligned, %k_head, %k_s1, %pro_kc, %kl_d1, %pro_kin) : (buffer, index, index, index, index, i1) -> (vector<8xf16>)
      scf.yield %pro_ka, %pro_kb2 : vector<8xf16>, vector<8xf16>
    } else {
      %pro_vr0, %pro_vr1 = scf.if %is_vl -> (vector<8xf16>, vector<8xf16>) {
        %pro_va_k = index.add %pro_kbase, %vl_key0 : index
        %pro_vb_k = index.add %pro_va_k, %c1 : index
        %pro_va_in = index.cmp ult, %pro_va_k, %n_kv : index
        %pro_vb_in = index.cmp ult, %pro_vb_k, %n_kv : index
        %pro_va_c = index.min %pro_va_k, %kv_last : index
        %pro_vb_c = index.min %pro_vb_k, %kv_last : index
        %pro_va = func.call @ggml_hrx_fat_row8(%v_aligned, %v_head, %v_s1, %pro_va_c, %vl_d0, %pro_va_in) : (buffer, index, index, index, index, i1) -> (vector<8xf16>)
        %pro_vb = func.call @ggml_hrx_fat_row8(%v_aligned, %v_head, %v_s1, %pro_vb_c, %vl_d0, %pro_vb_in) : (buffer, index, index, index, index, i1) -> (vector<8xf16>)
        scf.yield %pro_va, %pro_vb : vector<8xf16>, vector<8xf16>
      } else {
        scf.yield %zero8h, %zero8h : vector<8xf16>, vector<8xf16>
      }
      scf.yield %pro_vr0, %pro_vr1 : vector<8xf16>, vector<8xf16>
    }
    scf.yield %pro_rr0, %pro_rr1 : vector<8xf16>, vector<8xf16>
  } else {
    scf.yield %zero8h, %zero8h : vector<8xf16>, vector<8xf16>
  }
  %ko0_0_c = index.constant 0 : index
  %ko0_0 = index.add %ko0_0_c, %lane_half : index
  %ko0_1_c = index.constant 2 : index
  %ko0_1 = index.add %ko0_1_c, %lane_half : index
  %ko0_2_c = index.constant 4 : index
  %ko0_2 = index.add %ko0_2_c, %lane_half : index
  %ko0_3_c = index.constant 6 : index
  %ko0_3 = index.add %ko0_3_c, %lane_half : index
  %ko0_4_c = index.constant 8 : index
  %ko0_4 = index.add %ko0_4_c, %lane_half : index
  %ko0_5_c = index.constant 10 : index
  %ko0_5 = index.add %ko0_5_c, %lane_half : index
  %ko0_6_c = index.constant 12 : index
  %ko0_6 = index.add %ko0_6_c, %lane_half : index
  %ko0_7_c = index.constant 14 : index
  %ko0_7 = index.add %ko0_7_c, %lane_half : index
  %ko1_0_c = index.constant 16 : index
  %ko1_0 = index.add %ko1_0_c, %lane_half : index
  %ko1_1_c = index.constant 18 : index
  %ko1_1 = index.add %ko1_1_c, %lane_half : index
  %ko1_2_c = index.constant 20 : index
  %ko1_2 = index.add %ko1_2_c, %lane_half : index
  %ko1_3_c = index.constant 22 : index
  %ko1_3 = index.add %ko1_3_c, %lane_half : index
  %ko1_4_c = index.constant 24 : index
  %ko1_4 = index.add %ko1_4_c, %lane_half : index
  %ko1_5_c = index.constant 26 : index
  %ko1_5 = index.add %ko1_5_c, %lane_half : index
  %ko1_6_c = index.constant 28 : index
  %ko1_6 = index.add %ko1_6_c, %lane_half : index
  %ko1_7_c = index.constant 30 : index
  %ko1_7 = index.add %ko1_7_c, %lane_half : index
  %krow0_c = index.constant 0 : index
  %krow0_0 = index.add %krow0_c, %lane_col : index
  %krow0 = index.assume %krow0_0 [range(%krow0_0, 0, 31)] : index
  %krow1_c = index.constant 16 : index
  %krow1_0 = index.add %krow1_c, %lane_col : index
  %krow1 = index.assume %krow1_0 [range(%krow1_0, 0, 31)] : index
  %vrow0_c = index.constant 0 : index
  %vrow0_0 = index.add %vrow0_c, %lane_col : index
  %vrow0 = index.assume %vrow0_0 [range(%vrow0_0, 0, 127)] : index
  %vrow1_c = index.constant 16 : index
  %vrow1_0 = index.add %vrow1_c, %lane_col : index
  %vrow1 = index.assume %vrow1_0 [range(%vrow1_0, 0, 127)] : index
  %vrow2_c = index.constant 32 : index
  %vrow2_0 = index.add %vrow2_c, %lane_col : index
  %vrow2 = index.assume %vrow2_0 [range(%vrow2_0, 0, 127)] : index
  %vrow3_c = index.constant 48 : index
  %vrow3_0 = index.add %vrow3_c, %lane_col : index
  %vrow3 = index.assume %vrow3_0 [range(%vrow3_0, 0, 127)] : index
  %vrow4_c = index.constant 64 : index
  %vrow4_0 = index.add %vrow4_c, %lane_col : index
  %vrow4 = index.assume %vrow4_0 [range(%vrow4_0, 0, 127)] : index
  %vrow5_c = index.constant 80 : index
  %vrow5_0 = index.add %vrow5_c, %lane_col : index
  %vrow5 = index.assume %vrow5_0 [range(%vrow5_0, 0, 127)] : index
  %vrow6_c = index.constant 96 : index
  %vrow6_0 = index.add %vrow6_c, %lane_col : index
  %vrow6 = index.assume %vrow6_0 [range(%vrow6_0, 0, 127)] : index
  %vrow7_c = index.constant 112 : index
