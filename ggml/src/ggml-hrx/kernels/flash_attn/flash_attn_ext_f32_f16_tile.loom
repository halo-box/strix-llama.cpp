// FLASH_ATTN_EXT for large batches with matrix ops, d_k = d_v = 128, wave32.
// A workgroup takes qt tiles of 16 queries of hg heads that share one KV head: one wave for each tile and head.
// The waves load each 32-key tile of K and V once into LDS. A wave computes S^T = K Q^T, so that each lane holds the scores of one
// query: lanes l and l + 16 hold the even and the odd keys. Thus the softmax needs one lane exchange and P stays in registers.
// The output is O^T = V^T P^T. With a mask, the loop visits the 32-key tiles that a row of the workgroup sees
// (flash_attn_ext_range_f16.loom). A wave whose rows do not see a tile gets -inf for its keys, and a plain tile (mask 0 and the last
// bin for all its keys) needs no mask or index loads: its keys get the bias of the last bin. With toep, a Toeplitz tile (bias index
// e + i - j for row i and key j, mask 0 for the keys seen) gets its bias from 3 matrix products with f16 inputs of 48 rows of w
// and r of the 16 queries. Key j of query q takes row 31 + q - j: the values cross lanes in LDS.
// The keys of the mask that are -inf get p = 0. Their V values must be finite, as in a KV cache.

target.decl @ggml_wave32

// 1 means that the lanes load the mask and the indices of 16 keys at once. The host checks the alignment and that the rows
// hold the keys up to the next multiple of 32.
config.decl @ggml.flash_attn.head_first : %value: index where [range(%value, 0, 1)]
config.decl @ggml.flash_attn.vec_mask : %value: index where [range(%value, 0, 1)]
// 1 means that the host fused the MUL_MAT that makes the bias table: the table binding holds w [16, n_bins] and bias_r holds r
// [16, heads, queries]. The kernel computes the table value of a key from its bin.
config.decl @ggml.flash_attn.bias_mm : %value: index where [range(%value, 0, 1)]
// 1 means that the node has a mask.
config.decl @ggml.flash_attn.mask : %value: index where [range(%value, 0, 1)]
// 1 means that the node has an indexed bias (motifs/fa_bias.loom).
config.decl @ggml.flash_attn.bias : %value: index where [range(%value, 0, 1)]
// 1 means that the host fused a SUB(table, s) into the node. The kernel subtracts s of the row from the table values.
config.decl @ggml.flash_attn.bias_sub : %value: index where [range(%value, 0, 1)]
// Heads and 16-query tiles of a workgroup. hg divides the heads of a KV head.
config.decl @ggml.flash_attn.hg : %value: index where [range(%value, 1, 8)]
config.decl @ggml.flash_attn.qt : %value: index where [range(%value, 1, 8)]
// 1 means that waves 0-7 load the K tile and waves 8-15 the V tile of the next tile into registers while all waves compute.
// The workgroup has at least 16 waves.
config.decl @ggml.flash_attn.prefetch : %value: index where [range(%value, 0, 1)]
// 1 means that Toeplitz tiles get the bias from matrix products. Needs bias_mm, the tile classes and at most 18 waves.
config.decl @ggml.flash_attn.toep : %value: index where [range(%value, 0, 1)]

// Mask and indexed bias of key kc of the row, -1e30 if ok is false. mb, ib and tb point to the rows of a valid query and kc < n_kv,
// thus the mask and index loads are in their bindings. The bin is clamped into the table row.
// The sum is rounded to f16, as in motifs/fa_bias.loom.
func.def inline @ggml_hrx_fat_key(%m_view: view<[%m_span]xf16>, %m_span: index, %i_view: view<[%i_span]xi32>, %i_span: index, %t_view: view<[%t_span]xf32>, %t_span: index, %mask_on: i1, %bias_on: i1, %bins_top: index, %mb: index, %ib: index, %tb: index, %kc: index, %ok: i1, %s: f32) -> (f32) {
  %zero_f32 = scalar.constant 0.0 : f32
  %neg_large = scalar.constant -1e+30 : f32
  %m = scf.if %mask_on -> (f32) {
    %mi0 = index.add %mb, %kc : index
    %mi = index.assume %mi0 [range(%mi0, 0, 2147483646), lt(%mi0, %m_span)] : index
    %h = view.load %m_view[%mi] : view<[%m_span]xf16> -> f16
    %f = scalar.extf %h : f16 to f32
    scf.yield %f : f32
  } else {
    scf.yield %zero_f32 : f32
  }
  %r = scf.if %bias_on -> (f32) {
    %ii0 = index.add %ib, %kc : index
    %ii = index.assume %ii0 [range(%ii0, 0, 2147483646), lt(%ii0, %i_span)] : index
    %bin_i32 = view.load %i_view[%ii] : view<[%i_span]xi32> -> i32
    %bin0 = index.cast %bin_i32 : i32 to index
    %c0 = index.constant 0 : index
    %bin1 = index.max %bin0, %c0 : index
    %bin = index.min %bin1, %bins_top : index
    %ti0 = index.add %tb, %bin : index
    %ti = index.assume %ti0 [range(%ti0, 0, 2147483646), lt(%ti0, %t_span)] : index
    %b = view.load %t_view[%ti] : view<[%t_span]xf32> -> f32
    %bs = scalar.subf %b, %s : f32
    %sum = scalar.addf %m, %bs : f32
    %sh = scalar.fptrunc %sum : f32 to f16
    %sr = scalar.extf %sh : f16 to f32
    scf.yield %sr : f32
  } else {
    scf.yield %m : f32
  }
  %v = scf.select %ok, %r, %neg_large : f32
  func.return %v : f32
}

// table[tb + bin] - s added to the mask value m, rounded to f16. The bin is clamped into the table row.
func.def inline @ggml_hrx_fat_table(%t_view: view<[%t_span]xf32>, %t_span: index, %bins_top: index, %tb: index, %bin_i32: i32, %m: f32, %s: f32) -> (f32) {
  %c0 = index.constant 0 : index
  %bin0 = index.cast %bin_i32 : i32 to index
  %bin1 = index.max %bin0, %c0 : index
  %bin = index.min %bin1, %bins_top : index
  %ti0 = index.add %tb, %bin : index
  %ti = index.assume %ti0 [range(%ti0, 0, 2147483646), lt(%ti0, %t_span)] : index
  %b = view.load %t_view[%ti] : view<[%t_span]xf32> -> f32
  %bs = scalar.subf %b, %s : f32
  %sum = scalar.addf %m, %bs : f32
  %sh = scalar.fptrunc %sum : f32 to f16
  %sr = scalar.extf %sh : f16 to f32
  func.return %sr : f32
}

// The bias as a product: sum over 16 k of w[bin][k] * r[k] in k order with fma, as ggml_mul_mat_small_k sums it, then - s
// added to the mask value m and rounded to f16. The bin is clamped into w. Rows of w are 16-byte aligned.
func.def inline @ggml_hrx_fat_mm(%w_view: view<[%w_span]xf32>, %w_span: index, %bins_top: index, %w_s1: index, %bin_i32: i32, %r: vector<16xf32>, %m: f32, %s: f32) -> (f32) {
  %c0 = index.constant 0 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c12 = index.constant 12 : index
  %zero_f32 = scalar.constant 0.0 : f32
  %bin0 = index.cast %bin_i32 : i32 to index
  %bin1 = index.max %bin0, %c0 : index
  %bin = index.min %bin1, %bins_top : index
  %w_top = index.sub %w_span, %c4 : index
  %wbase = index.mul %bin, %w_s1 : index
  %wb0 = index.assume %wbase [range(%wbase, 0, 2147483640), multiple_of(%wbase, 4), le(%wbase, %w_top)] : index
  %wv0 = vector.load %w_view[%wb0] : view<[%w_span]xf32> -> vector<4xf32>
  %wb1_0 = index.add %wbase, %c4 : index
  %wb1 = index.assume %wb1_0 [range(%wb1_0, 0, 2147483640), multiple_of(%wb1_0, 4), le(%wb1_0, %w_top)] : index
  %wv1 = vector.load %w_view[%wb1] : view<[%w_span]xf32> -> vector<4xf32>
  %wb2_0 = index.add %wbase, %c8 : index
  %wb2 = index.assume %wb2_0 [range(%wb2_0, 0, 2147483640), multiple_of(%wb2_0, 4), le(%wb2_0, %w_top)] : index
  %wv2 = vector.load %w_view[%wb2] : view<[%w_span]xf32> -> vector<4xf32>
  %wb3_0 = index.add %wbase, %c12 : index
  %wb3 = index.assume %wb3_0 [range(%wb3_0, 0, 2147483640), multiple_of(%wb3_0, 4), le(%wb3_0, %w_top)] : index
  %wv3 = vector.load %w_view[%wb3] : view<[%w_span]xf32> -> vector<4xf32>
  %w0 = vector.extract %wv0[0] : vector<4xf32> -> f32
  %r0 = vector.extract %r[0] : vector<16xf32> -> f32
  %a0 = scalar.fmaf %w0, %r0, %zero_f32 : f32
  %w1 = vector.extract %wv0[1] : vector<4xf32> -> f32
  %r1 = vector.extract %r[1] : vector<16xf32> -> f32
  %a1 = scalar.fmaf %w1, %r1, %a0 : f32
  %w2 = vector.extract %wv0[2] : vector<4xf32> -> f32
  %r2 = vector.extract %r[2] : vector<16xf32> -> f32
  %a2 = scalar.fmaf %w2, %r2, %a1 : f32
  %w3 = vector.extract %wv0[3] : vector<4xf32> -> f32
  %r3 = vector.extract %r[3] : vector<16xf32> -> f32
  %a3 = scalar.fmaf %w3, %r3, %a2 : f32
  %w4 = vector.extract %wv1[0] : vector<4xf32> -> f32
  %r4 = vector.extract %r[4] : vector<16xf32> -> f32
  %a4 = scalar.fmaf %w4, %r4, %a3 : f32
  %w5 = vector.extract %wv1[1] : vector<4xf32> -> f32
  %r5 = vector.extract %r[5] : vector<16xf32> -> f32
  %a5 = scalar.fmaf %w5, %r5, %a4 : f32
  %w6 = vector.extract %wv1[2] : vector<4xf32> -> f32
  %r6 = vector.extract %r[6] : vector<16xf32> -> f32
  %a6 = scalar.fmaf %w6, %r6, %a5 : f32
  %w7 = vector.extract %wv1[3] : vector<4xf32> -> f32
  %r7 = vector.extract %r[7] : vector<16xf32> -> f32
  %a7 = scalar.fmaf %w7, %r7, %a6 : f32
  %w8 = vector.extract %wv2[0] : vector<4xf32> -> f32
  %r8 = vector.extract %r[8] : vector<16xf32> -> f32
  %a8 = scalar.fmaf %w8, %r8, %a7 : f32
  %w9 = vector.extract %wv2[1] : vector<4xf32> -> f32
  %r9 = vector.extract %r[9] : vector<16xf32> -> f32
  %a9 = scalar.fmaf %w9, %r9, %a8 : f32
  %w10 = vector.extract %wv2[2] : vector<4xf32> -> f32
  %r10 = vector.extract %r[10] : vector<16xf32> -> f32
  %a10 = scalar.fmaf %w10, %r10, %a9 : f32
  %w11 = vector.extract %wv2[3] : vector<4xf32> -> f32
  %r11 = vector.extract %r[11] : vector<16xf32> -> f32
  %a11 = scalar.fmaf %w11, %r11, %a10 : f32
  %w12 = vector.extract %wv3[0] : vector<4xf32> -> f32
  %r12 = vector.extract %r[12] : vector<16xf32> -> f32
  %a12 = scalar.fmaf %w12, %r12, %a11 : f32
  %w13 = vector.extract %wv3[1] : vector<4xf32> -> f32
  %r13 = vector.extract %r[13] : vector<16xf32> -> f32
  %a13 = scalar.fmaf %w13, %r13, %a12 : f32
  %w14 = vector.extract %wv3[2] : vector<4xf32> -> f32
  %r14 = vector.extract %r[14] : vector<16xf32> -> f32
  %a14 = scalar.fmaf %w14, %r14, %a13 : f32
  %w15 = vector.extract %wv3[3] : vector<4xf32> -> f32
  %r15 = vector.extract %r[15] : vector<16xf32> -> f32
  %a15 = scalar.fmaf %w15, %r15, %a14 : f32
  %bs = scalar.subf %a15, %s : f32
  %sum = scalar.addf %m, %bs : f32
  %sh = scalar.fptrunc %sum : f32 to f16
  %sr = scalar.extf %sh : f16 to f32
  func.return %sr : f32
}

// The value of the other lane of the query (lane xor 16).
func.def inline @ggml_hrx_fat_partner8(%x: vector<8xf32>) -> (vector<8xf32>) {
  %exchange = scalar.constant 16 : i32
  %width = scalar.constant 32 : i32
  %x0 = vector.extract %x[0] : vector<8xf32> -> f32
  %y0, %u0 = kernel.subgroup.shuffle<xor> %x0, %exchange, %width : f32, i32, i32
  %x1 = vector.extract %x[1] : vector<8xf32> -> f32
  %y1, %u1 = kernel.subgroup.shuffle<xor> %x1, %exchange, %width : f32, i32, i32
  %x2 = vector.extract %x[2] : vector<8xf32> -> f32
  %y2, %u2 = kernel.subgroup.shuffle<xor> %x2, %exchange, %width : f32, i32, i32
  %x3 = vector.extract %x[3] : vector<8xf32> -> f32
  %y3, %u3 = kernel.subgroup.shuffle<xor> %x3, %exchange, %width : f32, i32, i32
  %x4 = vector.extract %x[4] : vector<8xf32> -> f32
  %y4, %u4 = kernel.subgroup.shuffle<xor> %x4, %exchange, %width : f32, i32, i32
  %x5 = vector.extract %x[5] : vector<8xf32> -> f32
  %y5, %u5 = kernel.subgroup.shuffle<xor> %x5, %exchange, %width : f32, i32, i32
  %x6 = vector.extract %x[6] : vector<8xf32> -> f32
  %y6, %u6 = kernel.subgroup.shuffle<xor> %x6, %exchange, %width : f32, i32, i32
  %x7 = vector.extract %x[7] : vector<8xf32> -> f32
  %y7, %u7 = kernel.subgroup.shuffle<xor> %x7, %exchange, %width : f32, i32, i32
  %y = vector.from_elements %y0, %y1, %y2, %y3, %y4, %y5, %y6, %y7 : vector<8xf32>
  func.return %y : vector<8xf32>
}

func.def inline @ggml_hrx_fat_partner1(%x: f32) -> (f32) {
  %exchange = scalar.constant 16 : i32
  %width = scalar.constant 32 : i32
  %y, %u = kernel.subgroup.shuffle<xor> %x, %exchange, %width : f32, i32, i32
  func.return %y : f32
}

// P^T fragment of 16 keys from the p values of the lane (keys of its parity) and of its partner.
func.def inline @ggml_hrx_fat_pt(%p: vector<8xf32>, %hi_half: i1) -> (vector<16xf16>) {
  %c16 = index.constant 16 : index
  %q = func.call @ggml_hrx_fat_partner8(%p) : (vector<8xf32>) -> (vector<8xf32>)
  %even = scf.select %hi_half, %q, %p : vector<8xf32>
  %odd = scf.select %hi_half, %p, %q : vector<8xf32>
  %pf = vector.interleave<0> %even, %odd : vector<8xf32>, vector<8xf32> -> vector<16xf32>
  %ph = vector.fptrunc %pf : vector<16xf32> to vector<16xf16>
  %pt = vector.fragment<rhs> %ph shape [%c16, %c16] : vector<16xf16>
  func.return %pt : vector<16xf16>
}

// 16 values of a row from base, scaled. The loads are clamped into the binding. A row past n_q gets 0.
func.def inline @ggml_hrx_fat_load16(%q_view: view<[%q_span]xf32>, %q_span: index, %q_top: index, %base: index, %rv: i1, %scale: f32) -> (vector<16xf32>) {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %c9 = index.constant 9 : index
  %c10 = index.constant 10 : index
  %c11 = index.constant 11 : index
  %c12 = index.constant 12 : index
  %c13 = index.constant 13 : index
  %c14 = index.constant 14 : index
  %c15 = index.constant 15 : index
  %r0_1 = index.assume %base [range(%base, 0, 2147483646)] : index
  %r0_2 = index.min %r0_1, %q_top : index
  %r0 = index.assume %r0_2 [lt(%r0_2, %q_span)] : index
  %x0 = view.load %q_view[%r0] : view<[%q_span]xf32> -> f32
  %s0 = scalar.mulf %x0, %scale : f32
  %r1_0 = index.add %base, %c1 : index
  %r1_1 = index.assume %r1_0 [range(%r1_0, 0, 2147483646)] : index
  %r1_2 = index.min %r1_1, %q_top : index
  %r1 = index.assume %r1_2 [lt(%r1_2, %q_span)] : index
  %x1 = view.load %q_view[%r1] : view<[%q_span]xf32> -> f32
  %s1 = scalar.mulf %x1, %scale : f32
  %r2_0 = index.add %base, %c2 : index
  %r2_1 = index.assume %r2_0 [range(%r2_0, 0, 2147483646)] : index
  %r2_2 = index.min %r2_1, %q_top : index
  %r2 = index.assume %r2_2 [lt(%r2_2, %q_span)] : index
  %x2 = view.load %q_view[%r2] : view<[%q_span]xf32> -> f32
  %s2 = scalar.mulf %x2, %scale : f32
  %r3_0 = index.add %base, %c3 : index
  %r3_1 = index.assume %r3_0 [range(%r3_0, 0, 2147483646)] : index
  %r3_2 = index.min %r3_1, %q_top : index
  %r3 = index.assume %r3_2 [lt(%r3_2, %q_span)] : index
  %x3 = view.load %q_view[%r3] : view<[%q_span]xf32> -> f32
  %s3 = scalar.mulf %x3, %scale : f32
  %r4_0 = index.add %base, %c4 : index
  %r4_1 = index.assume %r4_0 [range(%r4_0, 0, 2147483646)] : index
  %r4_2 = index.min %r4_1, %q_top : index
  %r4 = index.assume %r4_2 [lt(%r4_2, %q_span)] : index
  %x4 = view.load %q_view[%r4] : view<[%q_span]xf32> -> f32
  %s4 = scalar.mulf %x4, %scale : f32
  %r5_0 = index.add %base, %c5 : index
  %r5_1 = index.assume %r5_0 [range(%r5_0, 0, 2147483646)] : index
  %r5_2 = index.min %r5_1, %q_top : index
  %r5 = index.assume %r5_2 [lt(%r5_2, %q_span)] : index
  %x5 = view.load %q_view[%r5] : view<[%q_span]xf32> -> f32
  %s5 = scalar.mulf %x5, %scale : f32
  %r6_0 = index.add %base, %c6 : index
  %r6_1 = index.assume %r6_0 [range(%r6_0, 0, 2147483646)] : index
  %r6_2 = index.min %r6_1, %q_top : index
  %r6 = index.assume %r6_2 [lt(%r6_2, %q_span)] : index
  %x6 = view.load %q_view[%r6] : view<[%q_span]xf32> -> f32
  %s6 = scalar.mulf %x6, %scale : f32
  %r7_0 = index.add %base, %c7 : index
  %r7_1 = index.assume %r7_0 [range(%r7_0, 0, 2147483646)] : index
  %r7_2 = index.min %r7_1, %q_top : index
  %r7 = index.assume %r7_2 [lt(%r7_2, %q_span)] : index
  %x7 = view.load %q_view[%r7] : view<[%q_span]xf32> -> f32
  %s7 = scalar.mulf %x7, %scale : f32
  %r8_0 = index.add %base, %c8 : index
  %r8_1 = index.assume %r8_0 [range(%r8_0, 0, 2147483646)] : index
  %r8_2 = index.min %r8_1, %q_top : index
  %r8 = index.assume %r8_2 [lt(%r8_2, %q_span)] : index
  %x8 = view.load %q_view[%r8] : view<[%q_span]xf32> -> f32
  %s8 = scalar.mulf %x8, %scale : f32
  %r9_0 = index.add %base, %c9 : index
  %r9_1 = index.assume %r9_0 [range(%r9_0, 0, 2147483646)] : index
  %r9_2 = index.min %r9_1, %q_top : index
  %r9 = index.assume %r9_2 [lt(%r9_2, %q_span)] : index
  %x9 = view.load %q_view[%r9] : view<[%q_span]xf32> -> f32
  %s9 = scalar.mulf %x9, %scale : f32
  %r10_0 = index.add %base, %c10 : index
  %r10_1 = index.assume %r10_0 [range(%r10_0, 0, 2147483646)] : index
  %r10_2 = index.min %r10_1, %q_top : index
  %r10 = index.assume %r10_2 [lt(%r10_2, %q_span)] : index
  %x10 = view.load %q_view[%r10] : view<[%q_span]xf32> -> f32
  %s10 = scalar.mulf %x10, %scale : f32
  %r11_0 = index.add %base, %c11 : index
  %r11_1 = index.assume %r11_0 [range(%r11_0, 0, 2147483646)] : index
  %r11_2 = index.min %r11_1, %q_top : index
  %r11 = index.assume %r11_2 [lt(%r11_2, %q_span)] : index
  %x11 = view.load %q_view[%r11] : view<[%q_span]xf32> -> f32
  %s11 = scalar.mulf %x11, %scale : f32
  %r12_0 = index.add %base, %c12 : index
  %r12_1 = index.assume %r12_0 [range(%r12_0, 0, 2147483646)] : index
  %r12_2 = index.min %r12_1, %q_top : index
  %r12 = index.assume %r12_2 [lt(%r12_2, %q_span)] : index
  %x12 = view.load %q_view[%r12] : view<[%q_span]xf32> -> f32
  %s12 = scalar.mulf %x12, %scale : f32
  %r13_0 = index.add %base, %c13 : index
  %r13_1 = index.assume %r13_0 [range(%r13_0, 0, 2147483646)] : index
  %r13_2 = index.min %r13_1, %q_top : index
  %r13 = index.assume %r13_2 [lt(%r13_2, %q_span)] : index
  %x13 = view.load %q_view[%r13] : view<[%q_span]xf32> -> f32
  %s13 = scalar.mulf %x13, %scale : f32
  %r14_0 = index.add %base, %c14 : index
  %r14_1 = index.assume %r14_0 [range(%r14_0, 0, 2147483646)] : index
  %r14_2 = index.min %r14_1, %q_top : index
  %r14 = index.assume %r14_2 [lt(%r14_2, %q_span)] : index
  %x14 = view.load %q_view[%r14] : view<[%q_span]xf32> -> f32
  %s14 = scalar.mulf %x14, %scale : f32
  %r15_0 = index.add %base, %c15 : index
  %r15_1 = index.assume %r15_0 [range(%r15_0, 0, 2147483646)] : index
  %r15_2 = index.min %r15_1, %q_top : index
  %r15 = index.assume %r15_2 [lt(%r15_2, %q_span)] : index
  %x15 = view.load %q_view[%r15] : view<[%q_span]xf32> -> f32
  %s15 = scalar.mulf %x15, %scale : f32
  %v = vector.from_elements %s0, %s1, %s2, %s3, %s4, %s5, %s6, %s7, %s8, %s9, %s10, %s11, %s12, %s13, %s14, %s15 : vector<16xf32>
  %zero16 = vector.splatf 0.0 : vector<16xf32>
  %vz = scf.select %rv, %v, %zero16 : vector<16xf32>
  func.return %vz : vector<16xf32>
}

// 16 channels of a query, scaled and rounded to f16.
func.def inline @ggml_hrx_fat_q16(%q_view: view<[%q_span]xf32>, %q_span: index, %q_top: index, %base: index, %rv: i1, %scale: f32) -> (vector<16xf16>) {
  %v = func.call @ggml_hrx_fat_load16(%q_view, %q_span, %q_top, %base, %rv, %scale) : (view<[%q_span]xf32>, index, index, index, i1, f32) -> (vector<16xf32>)
  %h = vector.fptrunc %v : vector<16xf32> to vector<16xf16>
  func.return %h : vector<16xf16>
}

// 8 channels of a K or V row from d0, or 0 if valid is false. The caller clamps the key.
func.def inline @ggml_hrx_fat_row8(%buf: buffer, %head: index, %s1: index, %key: index, %d0: index, %valid: i1) -> (vector<8xf16>) {
  %f16_bytes = index.constant 2 : offset
  %r1 = index.mul %key, %s1 : index
  %r2 = index.add %head, %r1 : index
  %off = index.scale %r2, %f16_bytes : index, offset -> offset
  %row = buffer.view %buf[%off] : buffer -> view<128xf16>
  %x = vector.load %row[%d0] : view<128xf16> -> vector<8xf16>
  %zero8h = vector.splatf 0.0 : vector<8xf16>
  %r = scf.select %valid, %x, %zero8h : vector<8xf16>
  func.return %r : vector<8xf16>
}

// Word w of the class bits of the block row at row_base (n_words words a row). The load is clamped into the binding.
func.def inline @ggml_hrx_fat_cls(%c_view: view<[%c_span]xi32>, %c_span: index, %row_base: index, %w: index) -> (i32) {
  %c1 = index.constant 1 : index
  %i0 = index.add %row_base, %w : index
  %i1 = index.assume %i0 [range(%i0, 0, 2147483646)] : index
  %top = index.sub %c_span, %c1 : index
  %i2 = index.min %i1, %top : index
  %i = index.assume %i2 [lt(%i2, %c_span)] : index
  %v = view.load %c_view[%i] : view<[%c_span]xi32> -> i32
  func.return %v : i32
}

// The first tile from kt on that a block row of the workgroup sees, or n_kt. The union bits of the workgroup are in LDS from
// element 1024. Without classes all tiles.
func.def inline @ggml_hrx_fat_next(%cls_on: i1, %l_view: view<2112xi32>, %kt: index, %n_kt: index) -> (index) {
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
  %c63 = index.constant 63 : index
  %c1024 = index.constant 1024 : index
  %zero_i32 = scalar.constant 0 : i32
  %one_i32 = scalar.constant 1 : i32
  %r = scf.if %cls_on -> (index) {
    %t_end, %t_sh = scf.while(%t0w = %kt : index) -> (index, i32) {
      %t = index.assume %t0w [range(%t0w, 0, 1073741824)] : index
      %in = index.cmp ult, %t, %n_kt : index
      %w0 = index.div %t, %c32 : index
      %w1 = index.min %w0, %c63 : index
      %wi = index.add %w1, %c1024 : index
      %wl = view.load %l_view[%wi] : view<2112xi32> -> i32
      %wd = scf.select %in, %wl, %zero_i32 : i32
      %b = index.rem %t, %c32 : index
      %b_i32 = index.cast %b : index to i32
      %sh = scalar.shrui %wd, %b_i32 : i32
      %bit = scalar.andi %sh, %one_i32 : i32
      %found = scalar.cmpi ne, %bit, %zero_i32 : i32
      %nf = scalar.xori %found, %in : i1
      %more = scalar.andi %nf, %in : i1
      scf.condition %more, %t, %sh : i1, index, i32
    } do(%tt0: index, %shh: i32) {
      %tt = index.assume %tt0 [range(%tt0, 0, 1073741824)] : index
      // A word without more set bits moves to the next word.
      %empty = scalar.cmpi eq, %shh, %zero_i32 : i32
      %t1 = index.add %tt, %c1 : index
      %tw0 = index.add %tt, %c32 : index
      %tw1 = index.div %tw0, %c32 : index
      %tw = index.mul %tw1, %c32 : index
      %tn = scf.select %empty, %tw, %t1 : index
      scf.yield %tn : index
    }
    %tc = index.min %t_end, %n_kt : index
    scf.yield %tc : index
  } else {
    %tk = index.min %kt, %n_kt : index
    scf.yield %tk : index
  }
  func.return %r : index
}

// Row clamp(row, 0, bins_top) of w rounded to f16, as an lhs fragment. Rows of w are 16-byte aligned.
func.def inline @ggml_hrx_fat_wfrag32(%w_view: view<[%w_span]xf32>, %w_span: index, %bins_top: index, %w_s1: index, %row_i32: i32) -> (vector<16xf16>) {
  %c0 = index.constant 0 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c12 = index.constant 12 : index
  %c16 = index.constant 16 : index
  %row0 = index.cast %row_i32 : i32 to index
  %row1 = index.max %row0, %c0 : index
  %row = index.min %row1, %bins_top : index
  %w_top = index.sub %w_span, %c4 : index
  %wbase = index.mul %row, %w_s1 : index
  %wb0 = index.assume %wbase [range(%wbase, 0, 2147483640), multiple_of(%wbase, 4), le(%wbase, %w_top)] : index
  %wv0 = vector.load %w_view[%wb0] : view<[%w_span]xf32> -> vector<4xf32>
  %wb1_0 = index.add %wbase, %c4 : index
  %wb1 = index.assume %wb1_0 [range(%wb1_0, 0, 2147483640), multiple_of(%wb1_0, 4), le(%wb1_0, %w_top)] : index
  %wv1 = vector.load %w_view[%wb1] : view<[%w_span]xf32> -> vector<4xf32>
  %wb2_0 = index.add %wbase, %c8 : index
  %wb2 = index.assume %wb2_0 [range(%wb2_0, 0, 2147483640), multiple_of(%wb2_0, 4), le(%wb2_0, %w_top)] : index
  %wv2 = vector.load %w_view[%wb2] : view<[%w_span]xf32> -> vector<4xf32>
  %wb3_0 = index.add %wbase, %c12 : index
  %wb3 = index.assume %wb3_0 [range(%wb3_0, 0, 2147483640), multiple_of(%wb3_0, 4), le(%wb3_0, %w_top)] : index
  %wv3 = vector.load %w_view[%wb3] : view<[%w_span]xf32> -> vector<4xf32>
  %we0 = vector.extract %wv0[0] : vector<4xf32> -> f32
  %we1 = vector.extract %wv0[1] : vector<4xf32> -> f32
  %we2 = vector.extract %wv0[2] : vector<4xf32> -> f32
  %we3 = vector.extract %wv0[3] : vector<4xf32> -> f32
  %we4 = vector.extract %wv1[0] : vector<4xf32> -> f32
  %we5 = vector.extract %wv1[1] : vector<4xf32> -> f32
  %we6 = vector.extract %wv1[2] : vector<4xf32> -> f32
  %we7 = vector.extract %wv1[3] : vector<4xf32> -> f32
  %we8 = vector.extract %wv2[0] : vector<4xf32> -> f32
  %we9 = vector.extract %wv2[1] : vector<4xf32> -> f32
  %we10 = vector.extract %wv2[2] : vector<4xf32> -> f32
  %we11 = vector.extract %wv2[3] : vector<4xf32> -> f32
  %we12 = vector.extract %wv3[0] : vector<4xf32> -> f32
  %we13 = vector.extract %wv3[1] : vector<4xf32> -> f32
  %we14 = vector.extract %wv3[2] : vector<4xf32> -> f32
  %we15 = vector.extract %wv3[3] : vector<4xf32> -> f32
  %wf = vector.from_elements %we0, %we1, %we2, %we3, %we4, %we5, %we6, %we7, %we8, %we9, %we10, %we11, %we12, %we13, %we14, %we15 : vector<16xf32>
  %wh = vector.fptrunc %wf : vector<16xf32> to vector<16xf16>
  %fr = vector.fragment<lhs> %wh shape [%c16, %c16] : vector<16xf16>
  func.return %fr : vector<16xf16>
}

kernel.def target(@ggml_wave32) export("ggml_flash_attn_ext_f32_f16_tile") @ggml_flash_attn_ext_f32_f16_tile(%n_tiles: index, %n_groups: index, %n_z: index) {
  %one = index.constant 1 : index
  %c32 = index.constant 32 : index
  %hg = config.get @ggml.flash_attn.hg : index
  %qt = config.get @ggml.flash_attn.qt : index
  %waves = index.mul %hg, %qt : index
  %wg_size = index.mul %waves, %c32 : index
  %head_first = config.get @ggml.flash_attn.head_first : index
  %x_heads = index.cmp eq, %head_first, %one : index
  %gx = scf.select %x_heads, %n_groups, %n_tiles : index
  %gy = scf.select %x_heads, %n_tiles, %n_groups : index
  kernel.launch.config workgroups(%gx, %gy, %n_z) workgroup_size(%wg_size, %one, %one) : index
} launch(%n_q_in: index, %n_head_in: index, %n_kv_in: index, %ratio_in: index, %r3_in: index, %q_s1_in: index, %q_s2_in: index, %q_s3_in: index, %q_span_in: index, %k_s1_in: index, %k_s2_in: index, %k_s3_in: index, %v_s1_in: index, %v_s2_in: index, %v_s3_in: index, %m_ne2_in: index, %m_ne3_in: index, %m_s1_in: index, %m_s2_in: index, %m_s3_in: index, %m_span_in: index, %dst_span_in: index, %scale_bits: index, %has_sinks: index, %s_span_in: index, %n_bins_in: index, %i_s1_in: index, %t_span_in: index, %i_span_in: index, %bs_s1_in: index, %bs_s2_in: index, %bs_span_in: index, %has_cls: index, %r_off_in: index, %r_span_in: index, %n_qb_in: index, %n_rowsb_in: index, %n_words_in: index, %w_s1_in: index, %rr_s1_in: index, %rr_s2_in: index, %rr_span_in: index, %q: buffer, %k: buffer, %v: buffer, %mask: buffer, %sinks: buffer, %dst: buffer, %range: buffer, %bias_t: buffer, %bias_i: buffer, %bias_s: buffer, %bias_r: buffer) {
  // The caller checks these ranges and the K/V alignment.
