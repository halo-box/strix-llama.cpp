      %lmax0 = vector.reduce<maxnumf> %sm0, %neg_large : vector<8xf32>, f32
      %kv1_0 = vector.load %k_view[%krow1, %c0_d] : view<32x136xf16> -> vector<16xf16>
      %kl1_0 = vector.fragment<lhs> %kv1_0 shape [%c16, %c16] : vector<16xf16>
      %s1_0 = vector.mma %kl1_0, %qf0, %init : vector<16xf16>, vector<16xf16>, vector<8xf32>
