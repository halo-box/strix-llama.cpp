  %n_kv = index.assume %n_kv_in [range(%n_kv_in, 1, 2147483647)] : index
  %ratio = index.assume %ratio_in [range(%ratio_in, 1, 2147483647)] : index
  %r3 = index.assume %r3_in [range(%r3_in, 1, 2147483647)] : index
  %q_s1 = index.assume %q_s1_in [range(%q_s1_in, 0, 2147483647)] : index
  %q_s2 = index.assume %q_s2_in [range(%q_s2_in, 0, 2147483647)] : index
  %q_s3 = index.assume %q_s3_in [range(%q_s3_in, 0, 2147483647)] : index
  %q_span = index.assume %q_span_in [range(%q_span_in, 1, 2147483647)] : index
  %k_s1 = index.assume %k_s1_in [range(%k_s1_in, 0, 16777216), multiple_of(%k_s1_in, 8)] : index
  %k_s2 = index.assume %k_s2_in [range(%k_s2_in, 0, 2147483647), multiple_of(%k_s2_in, 8)] : index
  %k_s3 = index.assume %k_s3_in [range(%k_s3_in, 0, 2147483647), multiple_of(%k_s3_in, 8)] : index
  %v_s1 = index.assume %v_s1_in [range(%v_s1_in, 0, 16777216), multiple_of(%v_s1_in, 8)] : index
  %v_s2 = index.assume %v_s2_in [range(%v_s2_in, 0, 2147483647), multiple_of(%v_s2_in, 8)] : index
  %v_s3 = index.assume %v_s3_in [range(%v_s3_in, 0, 2147483647), multiple_of(%v_s3_in, 8)] : index
  %m_ne2 = index.assume %m_ne2_in [range(%m_ne2_in, 1, 2147483647)] : index
  %m_ne3 = index.assume %m_ne3_in [range(%m_ne3_in, 1, 2147483647)] : index
  %m_s1 = index.assume %m_s1_in [range(%m_s1_in, 0, 2147483647)] : index
  %m_s2 = index.assume %m_s2_in [range(%m_s2_in, 0, 2147483647)] : index
  %m_s3 = index.assume %m_s3_in [range(%m_s3_in, 0, 2147483647)] : index
  %m_span = index.assume %m_span_in [range(%m_span_in, 1, 2147483647)] : index
  %dst_span = index.assume %dst_span_in [range(%dst_span_in, 1, 2147483647)] : index
  %s_span = index.assume %s_span_in [range(%s_span_in, 1, 2147483647)] : index
  %n_bins = index.assume %n_bins_in [range(%n_bins_in, 1, 2147483647)] : index
  %i_s1 = index.assume %i_s1_in [range(%i_s1_in, 0, 2147483647)] : index
  %t_span = index.assume %t_span_in [range(%t_span_in, 1, 2147483647)] : index
  %i_span = index.assume %i_span_in [range(%i_span_in, 1, 2147483647)] : index
  %bs_s1 = index.assume %bs_s1_in [range(%bs_s1_in, 0, 2147483647)] : index
  %bs_s2 = index.assume %bs_s2_in [range(%bs_s2_in, 0, 2147483647)] : index
  %bs_span = index.assume %bs_span_in [range(%bs_span_in, 1, 2147483647)] : index
  %r_off = index.assume %r_off_in [range(%r_off_in, 0, 2147483647)] : index
  %r_span = index.assume %r_span_in [range(%r_span_in, 2, 2147483647)] : index
  %n_qb = index.assume %n_qb_in [range(%n_qb_in, 1, 2147483647)] : index
  %n_rowsb = index.assume %n_rowsb_in [range(%n_rowsb_in, 1, 2147483647)] : index
  %n_words = index.assume %n_words_in [range(%n_words_in, 1, 2147483647)] : index
  %w_s1 = index.assume %w_s1_in [range(%w_s1_in, 0, 2147483647), multiple_of(%w_s1_in, 4)] : index
  %rr_s1 = index.assume %rr_s1_in [range(%rr_s1_in, 0, 2147483647)] : index
  %rr_s2 = index.assume %rr_s2_in [range(%rr_s2_in, 0, 2147483647)] : index
  %rr_span = index.assume %rr_span_in [range(%rr_span_in, 1, 2147483647)] : index

  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c8 = index.constant 8 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c31 = index.constant 31 : index
  %c32 = index.constant 32 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %c0_d = index.constant 0 : index
  %c0_r = index.constant 0 : index
  %c16_d = index.constant 16 : index
  %c16_r = index.constant 16 : index
  %c32_d = index.constant 32 : index
  %c48_d = index.constant 48 : index
  %c64_d = index.constant 64 : index
  %c80_d = index.constant 80 : index
  %c96_d = index.constant 96 : index
  %c112_d = index.constant 112 : index
  %c0_vr = index.constant 0 : index
  %c1_vr = index.constant 1 : index
  %c2_vr = index.constant 2 : index
  %c3_vr = index.constant 3 : index
  %c4_vr = index.constant 4 : index
  %c5_vr = index.constant 5 : index
  %c6_vr = index.constant 6 : index
  %c7_vr = index.constant 7 : index
  %c63_ow = index.constant 63 : index
  %c64_ow = index.constant 64 : index
  %c511_ow = index.constant 511 : index
  %c512_ow = index.constant 512 : index
  %c1088_ow = index.constant 1088 : index
  %c1600_ow = index.constant 1600 : index
  %zero = index.constant 0 : offset
  %f16_bytes = index.constant 2 : offset
  %f32_bytes = index.constant 4 : offset
  %zero_f32 = scalar.constant 0.0 : f32
  %one_f32 = scalar.constant 1.0 : f32
  %zero_f16 = scalar.constant 0.0 : f16
  // This value replaces -inf. Thus exp(s - max) stays finite for fully masked rows.
  %neg_large = scalar.constant -1e+30 : f32
  %neg8 = vector.splatf -1e+30 : vector<8xf32>
  %zero8 = vector.splatf 0.0 : vector<8xf32>
  %zero16h = vector.splatf 0.0 : vector<16xf16>
  %init = vector.fragment<init> %zero8 shape [%c16, %c16] : vector<8xf32>

  %hg0 = config.get @ggml.flash_attn.hg : index
