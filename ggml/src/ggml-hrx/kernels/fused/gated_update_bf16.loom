target.decl @ggml_wave32

func.decl @ggml_hrx_gmma_update(%x: buffer, %m: buffer, %y: buffer, %x_s1: index, %m_s1: index, %y_s1: index, %tok: index, %ch: index, %fs: f32, %gs: f32)

func.def inline @ggml_hrx_ctrl_bf16_norm(%src: buffer, %dst: buffer, %src_row: index, %dst_row: index, %eps_bits: index) {
  %c0 = index.constant 0 : index
  %c576 = index.constant 576 : index
  %c256 = index.constant 256 : index
  %two = index.constant 2 : offset
  %four = index.constant 4 : offset
  %src_off = index.scale %src_row, %four : index, offset -> offset
  %dst_off = index.scale %dst_row, %two : index, offset -> offset
  %in = buffer.view %src[%src_off] : buffer -> view<576x4xf32>
  %out = buffer.view %dst[%dst_off] : buffer -> view<576x4xbf16>
  %tid = kernel.workitem.id<x> : index
  %zero4 = vector.splatf 0.0 : vector<4xf32>
  %zero = scalar.constant 0.0 : f32
  %a = vector.load %in[%tid, %c0] : view<576x4xf32> -> vector<4xf32>
  %j = index.add %tid, %c256 : index
  %b = vector.load %in[%j, %c0] : view<576x4xf32> -> vector<4xf32>
  %k = index.add %j, %c256 : index
  %tail = index.cmp ult, %k, %c576 : index
  %c = scf.if %tail -> (vector<4xf32>) {
    %v = vector.load %in[%k, %c0] : view<576x4xf32> -> vector<4xf32>
    scf.yield %v : vector<4xf32>
  } else {
    scf.yield %zero4 : vector<4xf32>
  }
  %a2 = vector.mulf %a, %a : vector<4xf32>
  %b2 = vector.mulf %b, %b : vector<4xf32>
  %c2 = vector.mulf %c, %c : vector<4xf32>
  %sa = vector.reduce<addf> %a2, %zero : vector<4xf32>, f32
  %sb = vector.reduce<addf> %b2, %sa : vector<4xf32>, f32
  %sc = vector.reduce<addf> %c2, %sb : vector<4xf32>, f32
  %sum = kernel.workgroup.reduce<addf> %sc : f32
  %eps_i = index.cast %eps_bits : index to i32
  %eps_vec = vector.from_elements %eps_i : vector<1xi32>
  %eps_f = vector.bitcast %eps_vec : vector<1xi32> to vector<1xf32>
  %eps = vector.extract %eps_f[0] : vector<1xf32> -> f32
  %width = scalar.constant 2304.0 : f32
  %mean = scalar.divf %sum, %width : f32
  %biased = scalar.addf %mean, %eps : f32
  %rms = scalar.sqrtf %biased : f32
  %one = scalar.constant 1.0 : f32
  %scale = scalar.divf %one, %rms : f32
  %s4 = vector.splat %scale : vector<4xf32>
  %as = vector.mulf %a, %s4 : vector<4xf32>
  %bs = vector.mulf %b, %s4 : vector<4xf32>
  %ah = vector.fptrunc %as : vector<4xf32> to vector<4xbf16>
  %bh = vector.fptrunc %bs : vector<4xf32> to vector<4xbf16>
  vector.store %ah, %out[%tid, %c0] : vector<4xbf16>, view<576x4xbf16>
  vector.store %bh, %out[%j, %c0] : vector<4xbf16>, view<576x4xbf16>
  scf.if %tail {
    %cs = vector.mulf %c, %s4 : vector<4xf32>
    %ch = vector.fptrunc %cs : vector<4xf32> to vector<4xbf16>
    vector.store %ch, %out[%k, %c0] : vector<4xbf16>, view<576x4xbf16>
  }
  func.return
}

func.def inline @ggml_hrx_ctrl_bf16_pack(%src: buffer, %dst: buffer, %row: index, %dst_byte: offset) {
  %c0 = index.constant 0 : index
  %c256 = index.constant 256 : index
  %c576 = index.constant 576 : index
  %src_row_bytes = index.constant 18432 : offset
  %dst_row_bytes = index.constant 9216 : offset
  %from = index.scale %row, %src_row_bytes : index, offset -> offset
  %to_row = index.scale %row, %dst_row_bytes : index, offset -> offset
  %to = index.add %dst_byte, %to_row : offset
  %w = buffer.view %src[%from] : buffer -> view<576x8xf32>
  %p = buffer.view %dst[%to] : buffer -> view<576x8xbf16>
  %tid = kernel.workitem.id<x> : index
  scf.for %i = [%tid to %c576 step %c256] {
    %v = vector.load %w[%i, %c0] : view<576x8xf32> -> vector<8xf32>
    %h = vector.fptrunc %v : vector<8xf32> to vector<8xbf16>
    vector.store %h, %p[%i, %c0] : vector<8xbf16>, view<576x8xbf16>
  }
  func.return
}

// Normalize the two input rows in F32 before rounding, as in the native Loom controller.
// Pack the three F32 weight matrices once per controller call in the same launch.
kernel.def target(@ggml_wave32) export("ggml_inkling_ctrl_prepare_bf16") @ggml_inkling_ctrl_prepare_bf16(%tokens: index) {
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %weights = index.constant 128 : index
  %threads = index.constant 256 : index
  %groups = index.madd %tokens, %two, %weights : index
  kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%n_in: index, %xs: index, %ms: index, %eps_x: index, %eps_m: index, %x: buffer, %m: buffer, %wd: buffer, %wf: buffer, %wg: buffer, %scratch: buffer) {
  %n = index.assume %n_in [range(%n_in, 64, 8192), multiple_of(%n_in, 64)] : index
  %g = kernel.workgroup.id<x> : index
  %c0 = index.constant 0 : index
  %c2 = index.constant 2 : index
  %c96 = index.constant 96 : index
  %c64 = index.constant 64 : index
  %e = index.constant 2304 : index
  %k = index.constant 4608 : index
  %row_bytes = index.constant 9344 : offset
  %wd_bytes = index.constant 589824 : offset
  %wf_bytes = index.constant 294912 : offset
  %inputs = index.mul %n, %c2 : index
  %is_input = index.cmp ult, %g, %inputs : index
  scf.if %is_input {
    %is_x = index.cmp ult, %g, %n : index
    %src = scf.select %is_x, %x, %m : buffer
    %stride = scf.select %is_x, %xs, %ms : index
    %eps = scf.select %is_x, %eps_x, %eps_m : index
    %half = scf.select %is_x, %c0, %e : index
    %base = scf.select %is_x, %c0, %n : index
    %token = index.sub %g, %base : index
    %in_row = index.mul %token, %stride : index
    %out_row = index.madd %token, %k, %half : index
    func.call @ggml_hrx_ctrl_bf16_norm(%src, %scratch, %in_row, %out_row, %eps) : (buffer, buffer, index, index, index)
  } else {
    %i = index.sub %g, %inputs : index
    %is_down = index.cmp ult, %i, %c64 : index
    %is_forget = index.cmp ult, %i, %c96 : index
    %down = index.scale %n, %row_bytes : index, offset -> offset
    %forget = index.add %down, %wd_bytes : offset
    %gain = index.add %forget, %wf_bytes : offset
    %up_w = scf.select %is_forget, %wf, %wg : buffer
    %weight = scf.select %is_down, %wd, %up_w : buffer
    %up_off = scf.select %is_forget, %forget, %gain : offset
    %off = scf.select %is_down, %down, %up_off : offset
    %up_base = scf.select %is_forget, %c64, %c96 : index
    %base = scf.select %is_down, %c0, %up_base : index
    %row = index.sub %i, %base : index
    func.call @ggml_hrx_ctrl_bf16_pack(%weight, %scratch, %row, %off) : (buffer, buffer, index, offset)
  }
  kernel.return
}

// Down projection uses 64 tokens and 64 outputs per workgroup, with 32x32 per wave.
kernel.def target(@ggml_wave32) export("ggml_inkling_ctrl_down_bf16") @ggml_inkling_ctrl_down_bf16(%tokens: index) {
  %one = index.constant 1 : index
  %c64 = index.constant 64 : index
  %threads = index.constant 128 : index
  %groups = index.div %tokens, %c64 : index
  kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%n_in: index, %scratch: buffer) {
  %n = index.assume %n_in [range(%n_in, 64, 8192), multiple_of(%n_in, 64)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %k = index.constant 4608 : index
  %zero = index.constant 0 : offset
  %xrow_bytes = index.constant 9216 : offset
  %row_bytes = index.constant 9344 : offset
  %stage_bytes = index.constant 9216 : offset
  %as_alloc = buffer.alloca<workgroup> align(16) %stage_bytes : buffer
  %bs_alloc = buffer.alloca<workgroup> align(16) %stage_bytes : buffer
  %as = buffer.view %as_alloc[%zero] : buffer -> view<64x72xbf16>
  %bs = buffer.view %bs_alloc[%zero] : buffer -> view<64x72xbf16>
  %w_off = index.scale %n, %row_bytes : index, offset -> offset
  %z_off = index.scale %n, %xrow_bytes : index, offset -> offset
  %x = buffer.view %scratch[%zero] : buffer -> view<[%n]x4608xbf16>
  %w = buffer.view %scratch[%w_off] : buffer -> view<64x4608xbf16>
  %z = buffer.view %scratch[%z_off] : buffer -> view<[%n]x64xbf16>
  %tile = kernel.workgroup.id<x> : index
  %tile_row = index.mul %tile, %c64 : index
  %t = kernel.workitem.id<x> : index
  %lane = kernel.subgroup.lane.id : index
  %wave = kernel.subgroup.id : index
  %wave_row = index.div %wave, %c2 : index
  %a0 = index.mul %wave_row, %c32 : index
  %a1 = index.add %a0, %c16 : index
  %wave_col = index.rem %wave, %c2 : index
  %col = index.rem %lane, %c16 : index
  %b0 = index.madd %wave_col, %c32, %col : index
  %b1 = index.add %b0, %c16 : index
  %local_row = index.div %t, %c2 : index
  %half = index.rem %t, %c2 : index
  %local_k = index.mul %half, %c32 : index
  %xrow_raw = index.add %tile_row, %local_row : index
  %xrow = index.assume %xrow_raw [lt(%xrow_raw, %n)] : index
  %z8 = vector.splatf 0.0 : vector<8xf32>
  %init = vector.fragment<init> %z8 shape [%c16, %c16] : vector<8xf32>
  %p00, %p01, %p10, %p11 = scf.for %kk = [%c0 to %k step %c64](%c00 = %init : vector<8xf32>, %c01 = %init : vector<8xf32>, %c10 = %init : vector<8xf32>, %c11 = %init : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    %load_k = index.add %kk, %local_k : index
    %av = vector.load %x[%xrow, %load_k] : view<[%n]x4608xbf16> -> vector<32xbf16>
    %bv = vector.load %w[%local_row, %load_k] : view<64x4608xbf16> -> vector<32xbf16>
    vector.store %av, %as[%local_row, %local_k] : vector<32xbf16>, view<64x72xbf16>
    vector.store %bv, %bs[%local_row, %local_k] : vector<32xbf16>, view<64x72xbf16>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %d00, %d01, %d10, %d11 = scf.for %fi = [%c0 to %c64 step %c16](%f00 = %c00 : vector<8xf32>, %f01 = %c01 : vector<8xf32>, %f10 = %c10 : vector<8xf32>, %f11 = %c11 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) unroll {
      %l0 = vector.fragment.load<lhs> %as[%a0, %fi] shape [%c16, %c16] : view<64x72xbf16> -> vector<16xbf16>
      %l1 = vector.fragment.load<lhs> %as[%a1, %fi] shape [%c16, %c16] : view<64x72xbf16> -> vector<16xbf16>
      %v0 = vector.load %bs[%b0, %fi] : view<64x72xbf16> -> vector<16xbf16>
      %v1 = vector.load %bs[%b1, %fi] : view<64x72xbf16> -> vector<16xbf16>
      %r0 = vector.fragment<rhs> %v0 shape [%c16, %c16] : vector<16xbf16>
      %r1 = vector.fragment<rhs> %v1 shape [%c16, %c16] : vector<16xbf16>
      %s00 = vector.mma %l0, %r0, %f00 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
      %s01 = vector.mma %l0, %r1, %f01 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
      %s10 = vector.mma %l1, %r0, %f10 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
      %s11 = vector.mma %l1, %r1, %f11 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
      scf.yield %s00, %s01, %s10, %s11 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %d00, %d01, %d10, %d11 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  %h00 = vector.fptrunc %p00 : vector<8xf32> to vector<8xbf16>
  %h01 = vector.fptrunc %p01 : vector<8xf32> to vector<8xbf16>
  %h10 = vector.fptrunc %p10 : vector<8xf32> to vector<8xbf16>
  %h11 = vector.fptrunc %p11 : vector<8xf32> to vector<8xbf16>
  %lane_row = index.div %lane, %c16 : index
  %tile_a = index.add %tile_row, %a0 : index
  %tile_b = index.add %tile_row, %a1 : index
  scf.for %i = [%c0 to %c8 step %c1] unroll {
    %r = index.madd %i, %c2, %lane_row : index
    %ra_raw = index.add %tile_a, %r : index
    %rb_raw = index.add %tile_b, %r : index
    %ra = index.assume %ra_raw [lt(%ra_raw, %n)] : index
    %rb = index.assume %rb_raw [lt(%rb_raw, %n)] : index
    %v00 = vector.extract %h00[%i] : vector<8xbf16> -> bf16
    %v01 = vector.extract %h01[%i] : vector<8xbf16> -> bf16
    %v10 = vector.extract %h10[%i] : vector<8xbf16> -> bf16
    %v11 = vector.extract %h11[%i] : vector<8xbf16> -> bf16
    view.store %v00, %z[%ra, %b0] : bf16, view<[%n]x64xbf16>
    view.store %v01, %z[%ra, %b1] : bf16, view<[%n]x64xbf16>
    view.store %v10, %z[%rb, %b0] : bf16, view<[%n]x64xbf16>
    view.store %v11, %z[%rb, %b1] : bf16, view<[%n]x64xbf16>
  }
  kernel.return
}

// Apply BF16 gain and forget projections, then use the tuned F32 tanh and residual update.
kernel.def target(@ggml_wave32) export("ggml_inkling_ctrl_apply_bf16") @ggml_inkling_ctrl_apply_bf16(%n_t: index) {
  %one = index.constant 1 : index
  %c64 = index.constant 64 : index
  %wg_size = index.constant 128 : index
  %groups = index.constant 36 : index
  %tiles = index.div %n_t, %c64 : index
  kernel.launch.config workgroups(%groups, %tiles, %one) workgroup_size(%wg_size, %one, %one) : index
} launch(%n_in: index, %x_s1: index, %m_s1: index, %y_s1: index, %x: buffer, %m: buffer, %scratch: buffer, %y: buffer) {
  %n = index.assume %n_in [range(%n_in, 64, 8192), multiple_of(%n_in, 64)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c0_offset = index.constant 0 : offset
  %group = kernel.workgroup.id<x> : index
  %tile = kernel.workgroup.id<y> : index
  %tid_raw = kernel.workitem.id<x> : index
  %t = index.assume %tid_raw [range(%tid_raw, 0, 127)] : index
  %s_raw = kernel.subgroup.id : index
  %s = index.assume %s_raw [range(%s_raw, 0, 3)] : index
  %lane_raw = kernel.subgroup.lane.id : index
  %lane = index.assume %lane_raw [range(%lane_raw, 0, 31)] : index

  // The BF16 stages of z, Wf and Wg.
  %lds_bytes = index.constant 27648 : offset
  %lds = buffer.alloca<workgroup> align(16) %lds_bytes : buffer
  %o_f = index.constant 9216 : offset
  %o_g = index.constant 18432 : offset
  %zs = buffer.view %lds[%c0_offset] : buffer -> view<64x72xbf16>
  %fs = buffer.view %lds[%o_f] : buffer -> view<64x72xbf16>
  %gs = buffer.view %lds[%o_g] : buffer -> view<64x72xbf16>

  %xrow_bytes = index.constant 9216 : offset
  %row_bytes = index.constant 9344 : offset
  %wd_bytes = index.constant 589824 : offset
  %wf_bytes = index.constant 294912 : offset
  %z_off = index.scale %n, %xrow_bytes : index, offset -> offset
  %weight_off = index.scale %n, %row_bytes : index, offset -> offset
  %wf_off = index.add %weight_off, %wd_bytes : offset
  %wg_off = index.add %wf_off, %wf_bytes : offset
  %z = buffer.view %scratch[%z_off] : buffer -> view<[%n]x64xbf16>
  %wf = buffer.view %scratch[%wf_off] : buffer -> view<2304x64xbf16>
  %wg = buffer.view %scratch[%wg_off] : buffer -> view<2304x64xbf16>
  %ld_r = index.div %t, %c2 : index
  %ld_c = index.rem %t, %c2 : index
  %ld_k = index.mul %ld_c, %c32 : index
  %tok0 = index.mul %tile, %c64 : index
  %row0 = index.mul %group, %c64 : index
  %tok_raw = index.add %tok0, %ld_r : index
  %tok = index.assume %tok_raw [lt(%tok_raw, %n)] : index
  %row = index.add %row0, %ld_r : index
  %zv = vector.load %z[%tok, %ld_k] : view<[%n]x64xbf16> -> vector<32xbf16>
  %fv = vector.load %wf[%row, %ld_k] : view<2304x64xbf16> -> vector<32xbf16>
  %gv = vector.load %wg[%row, %ld_k] : view<2304x64xbf16> -> vector<32xbf16>
  vector.store %zv, %zs[%ld_r, %ld_k] : vector<32xbf16>, view<64x72xbf16>
  vector.store %fv, %fs[%ld_r, %ld_k] : vector<32xbf16>, view<64x72xbf16>
  vector.store %gv, %gs[%ld_r, %ld_k] : vector<32xbf16>, view<64x72xbf16>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

  %wr = index.div %s, %c2 : index
  %wc = index.rem %s, %c2 : index
  %a_row0 = index.mul %wr, %c32 : index
  %a_row1 = index.add %a_row0, %c16 : index
  %b_col0 = index.mul %wc, %c32 : index
  %lane_n = index.rem %lane, %c16 : index
  %lane_m = index.div %lane, %c16 : index
  %rc0 = index.add %b_col0, %lane_n : index
  %rc1 = index.add %rc0, %c16 : index
  %zero8 = vector.splatf 0.0 : vector<8xf32>
  %init = vector.fragment<init> %zero8 shape [%c16, %c16] : vector<8xf32>
  %f00, %f01, %f10, %f11, %g00, %g01, %g10, %g11 = scf.for %kh = [%c0 to %c64 step %c16](%af00 = %init : vector<8xf32>, %af01 = %init : vector<8xf32>, %af10 = %init : vector<8xf32>, %af11 = %init : vector<8xf32>, %ag00 = %init : vector<8xf32>, %ag01 = %init : vector<8xf32>, %ag10 = %init : vector<8xf32>, %ag11 = %init : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) unroll {
    %l0 = vector.fragment.load<lhs> %zs[%a_row0, %kh] shape [%c16, %c16] : view<64x72xbf16> -> vector<16xbf16>
    %l1 = vector.fragment.load<lhs> %zs[%a_row1, %kh] shape [%c16, %c16] : view<64x72xbf16> -> vector<16xbf16>
    %fv0 = vector.load %fs[%rc0, %kh] : view<64x72xbf16> -> vector<16xbf16>
    %fv1 = vector.load %fs[%rc1, %kh] : view<64x72xbf16> -> vector<16xbf16>
    %gv0 = vector.load %gs[%rc0, %kh] : view<64x72xbf16> -> vector<16xbf16>
    %gv1 = vector.load %gs[%rc1, %kh] : view<64x72xbf16> -> vector<16xbf16>
    %fr0 = vector.fragment<rhs> %fv0 shape [%c16, %c16] : vector<16xbf16>
    %fr1 = vector.fragment<rhs> %fv1 shape [%c16, %c16] : vector<16xbf16>
    %gr0 = vector.fragment<rhs> %gv0 shape [%c16, %c16] : vector<16xbf16>
    %gr1 = vector.fragment<rhs> %gv1 shape [%c16, %c16] : vector<16xbf16>
    %nf00 = vector.mma %l0, %fr0, %af00 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %nf01 = vector.mma %l0, %fr1, %af01 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %nf10 = vector.mma %l1, %fr0, %af10 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %nf11 = vector.mma %l1, %fr1, %af11 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %ng00 = vector.mma %l0, %gr0, %ag00 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %ng01 = vector.mma %l0, %gr1, %ag01 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %ng10 = vector.mma %l1, %gr0, %ag10 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %ng11 = vector.mma %l1, %gr1, %ag11 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    scf.yield %nf00, %nf01, %nf10, %nf11, %ng00, %ng01, %ng10, %ng11 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  %ch0 = index.add %row0, %rc0 : index
  %ch1 = index.add %row0, %rc1 : index
  %tb0 = index.add %tok0, %a_row0 : index
  %tb1 = index.add %tok0, %a_row1 : index
  scf.for %i = [%c0 to %c8 step %c1] unroll {
    %i2 = index.mul %i, %c2 : index
    %ti = index.add %lane_m, %i2 : index
    %tok_a = index.add %tb0, %ti : index
