// argsort of f32 rows to i32 indices. One workgroup for each row. Strides are in elements.
// Rank sort in workgroup memory: the rank of value i is the count of values that come before it.
// Equal values keep the order of their indices (a stable sort). -0 and +0 are equal.

// 0 ascending, 1 descending.
config.decl @ggml.argsort.order : %value: index where [range(%value, 0, 1)]
// Row capacity of the workgroup memory, at least ne0.
config.decl @ggml.argsort.cols : %value: index where [range(%value, 1, 4096)]
config.decl @ggml.argsort.wg_size : %value: index where [range(%value, 64, 1024), multiple_of(%value, 64)]

target.decl @ggml_wave64

// Signed integer key with the same order as the f32 values. For descending order, the key order is reversed.
func.def inline @ggml_hrx_argsort_key(%x: f32, %desc: i1) -> (i32) {
  %c0_f32 = scalar.constant 0.0 : f32
  %c0_i32 = scalar.constant 0 : i32
  %mag = scalar.constant 2147483647 : i32
  %all = scalar.constant -1 : i32
  %bits = scalar.bitcast %x : f32 to i32
  %is_zero = scalar.cmpf oeq, %x, %c0_f32 : f32
  %neg = scalar.cmpi slt, %bits, %c0_i32 : i32
  %flipped = scalar.xori %bits, %mag : i32
  %signed = scf.select %neg, %flipped, %bits : i32
  %key0 = scf.select %is_zero, %c0_i32, %signed : i32
  %reversed = scalar.xori %key0, %all : i32
  %key = scf.select %desc, %reversed, %key0 : i32
  func.return %key : i32
}

kernel.def target(@ggml_wave64) export("ggml_argsort_f32") @ggml_argsort_f32(%rows: index) {
  %one = index.constant 1 : index
  %wg_size = config.get @ggml.argsort.wg_size : index
  kernel.launch.config workgroups(%rows, %one, %one) workgroup_size(%wg_size, %one, %one) : index
} launch(%ne0_in: index, %ne1_in: index, %ne2_in: index, %s1_in: index, %s2_in: index, %s3_in: index, %src_span_in: index, %d1_in: index, %d2_in: index, %d3_in: index, %dst_span_in: index, %src: buffer, %dst: buffer) {
  // supports_argsort checks these ranges.
  %ne0 = index.assume %ne0_in [range(%ne0_in, 1, 4096)] : index
  %ne1 = index.assume %ne1_in [range(%ne1_in, 1, 2147483647)] : index
  %ne2 = index.assume %ne2_in [range(%ne2_in, 1, 2147483647)] : index
  %s1 = index.assume %s1_in [range(%s1_in, 0, 2147483647)] : index
  %s2 = index.assume %s2_in [range(%s2_in, 0, 2147483647)] : index
  %s3 = index.assume %s3_in [range(%s3_in, 0, 2147483647)] : index
  %src_span = index.assume %src_span_in [range(%src_span_in, 1, 2147483647)] : index
  %d1 = index.assume %d1_in [range(%d1_in, 0, 2147483647)] : index
  %d2 = index.assume %d2_in [range(%d2_in, 0, 2147483647)] : index
  %d3 = index.assume %d3_in [range(%d3_in, 0, 2147483647)] : index
  %dst_span = index.assume %dst_span_in [range(%dst_span_in, 1, 2147483647)] : index
  %order = config.get @ggml.argsort.order : index
  %cols = config.get @ggml.argsort.cols : index
  %wg_size = config.get @ggml.argsort.wg_size : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %one_b = index.constant 1 : offset
  %zero = index.constant 0 : offset
  %desc = index.cmp eq, %order, %c1 : index
  %row = kernel.workgroup.id<x> : index
  %item = kernel.workitem.id<x> : index

  %i1 = index.rem %row, %ne1 : index
  %t0 = index.div %row, %ne1 : index
  %i2 = index.rem %t0, %ne2 : index
  %i3 = index.div %t0, %ne2 : index
  %so1 = index.mul %i1, %s1 : index
  %so2 = index.mul %i2, %s2 : index
  %so3 = index.mul %i3, %s3 : index
  %so12 = index.add %so1, %so2 : index
  %src_base = index.add %so12, %so3 : index
  %do1 = index.mul %i1, %d1 : index
  %do2 = index.mul %i2, %d2 : index
  %do3 = index.mul %i3, %d3 : index
  %do12 = index.add %do1, %do2 : index
  %dst_base = index.add %do12, %do3 : index

  %src_view = buffer.view %src[%zero] : buffer -> view<[%src_span]xf32>
  %dst_view = buffer.view %dst[%zero] : buffer -> view<[%dst_span]xi32>
  %key_bytes0 = index.mul %cols, %c4 : index
  %key_bytes = index.scale %key_bytes0, %one_b : index, offset -> offset
  %lds = buffer.alloca<workgroup> align(16) %key_bytes : buffer
  %keys = buffer.view %lds[%zero] : buffer -> view<[%cols]xi32>
  %n = index.min %ne0, %cols : index

  scf.for %c = [%item to %n step %wg_size] {
    %src_idx = index.add %src_base, %c : index
    %src_off = index.assume %src_idx [range(%src_idx, 0, 2147483646)] : index
    %src_ok = index.cmp ult, %src_off, %src_span : index
    %c0_f32 = scalar.constant 0.0 : f32
    %x = scf.if %src_ok -> (f32) {
      %l = view.load %src_view[%src_off] : view<[%src_span]xf32> -> f32
      scf.yield %l : f32
    } else {
      scf.yield %c0_f32 : f32
    }
    %key = func.call @ggml_hrx_argsort_key(%x, %desc) : (f32, i1) -> (i32)
    view.store %key, %keys[%c] : i32, view<[%cols]xi32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

  scf.for %c = [%item to %n step %wg_size] {
    %my_key = view.load %keys[%c] : view<[%cols]xi32> -> i32
    %rank = scf.for %o = [%c0 to %n step %c1](%acc = %c0 : index) -> (index) unroll(%c4) {
      %k = view.load %keys[%o] : view<[%cols]xi32> -> i32
      %less = scalar.cmpi slt, %k, %my_key : i32
      %equal = scalar.cmpi eq, %k, %my_key : i32
      %lower = index.cmp ult, %o, %c : index
      %tie = scalar.andi %equal, %lower : i1
      %before = scalar.ori %less, %tie : i1
      %inc = scf.select %before, %c1, %c0 : index
      %next = index.add %acc, %inc : index
      scf.yield %next : index
    }
    %dst_idx = index.add %dst_base, %rank : index
    %dst_off = index.assume %dst_idx [range(%dst_idx, 0, 2147483646)] : index
    %dst_ok = index.cmp ult, %dst_off, %dst_span : index
    scf.if %dst_ok {
      %c_i32 = index.cast %c : index to i32
      view.store %c_i32, %dst_view[%dst_off] : i32, view<[%dst_span]xi32>
    }
  }
  kernel.return
}
