# hooks_link(<target> UNITS <files...>)
#   Adds the hook files UNITS to <target> with a generated registrar (see hooks/ggml/include/ggml-hooks-link.h).
#   The registrar is an object library built without the compile options of <target>: it runs when the library is
#   loaded, also in a GGML_BACKEND_DL CPU variant that the CPU cannot run. Call it once per target, UNITS can be empty.
#
# hooks_wrap(<target> [API] SYMBOLS <symbols...>)
#   Link-time wrapping: every call to <symbol> from another object file goes to __wrap_<symbol>, which can call
#   __real_<symbol>. Applies to the link of <target> and of everything that links it.
#   Calls inside the object file that defines <symbol> are not wrapped: tools/check-wraps.sh checks that each
#   internal symbol is still called from another file. API: public functions, called by the users of the library.

set(HOOKS_ROOT ${CMAKE_CURRENT_LIST_DIR}/..)
set(HOOKS_SECTIONS ggml_hook_drivers ggml_hook_exts ggml_hook_params ggml_hook_kernels)

function(hooks_link target)
    cmake_parse_arguments(ARG "" "" "UNITS" ${ARGN})
    string(MAKE_C_IDENTIFIER "${target}" tid)

    set(anchors "")
    set(refs    "")
    foreach (src ${ARG_UNITS})
        file(RELATIVE_PATH rel ${HOOKS_ROOT} ${src})
        string(MAKE_C_IDENTIFIER "${rel}" uid)
        set_property(SOURCE ${src} TARGET_DIRECTORY ${target} APPEND PROPERTY COMPILE_DEFINITIONS GGML_HOOK_UNIT=${uid})
        string(APPEND anchors "extern int ggml_hook_unit_${uid};\n")
        string(APPEND refs    "    &ggml_hook_unit_${uid},\n")
    endforeach()

    set(sections "")
    set(calls    "")
    set(kind 0)
    foreach (sec ${HOOKS_SECTIONS})
        string(APPEND sections "extern const void * const __start_${sec}[] __attribute__((weak, visibility(\"hidden\")));\n")
        string(APPEND sections "extern const void * const __stop_${sec}[] __attribute__((weak, visibility(\"hidden\")));\n")
        string(APPEND calls    "        if (__start_${sec}) { ggml_hook_register_section(${kind}, __start_${sec}, __stop_${sec}, &ggml_hooks_module_${tid}); }\n")
        math(EXPR kind "${kind} + 1")
    endforeach()

    set(gen ${CMAKE_BINARY_DIR}/hooks-registrar/${tid}.cpp)
    file(CONFIGURE OUTPUT ${gen} CONTENT "// generated by hooks/cmake/hooks-link.cmake for ${target}
extern \"C\" {
void ggml_hook_register_section(int kind, const void * const * begin, const void * const * end, const void * module);
void ggml_hook_unregister_module(const void * module);
${sections}${anchors}
extern const char ggml_hooks_module_${tid};
const char ggml_hooks_module_${tid} = 0;
extern int * const ggml_hooks_keep_${tid}[];
__attribute__((used)) int * const ggml_hooks_keep_${tid}[] = {
${refs}    nullptr,
};
}
namespace {
struct ggml_hooks_registrar {
    ggml_hooks_registrar() {
${calls}    }
    ~ggml_hooks_registrar() { ggml_hook_unregister_module(&ggml_hooks_module_${tid}); }
} ggml_hooks_registrar_instance;
}
" @ONLY)

    add_library(${target}-hooks-registrar OBJECT ${gen})
    set_target_properties(${target}-hooks-registrar PROPERTIES POSITION_INDEPENDENT_CODE ON)
    target_sources(${target} PRIVATE ${ARG_UNITS} $<TARGET_OBJECTS:${target}-hooks-registrar>)
    target_compile_definitions(${target} PRIVATE GGML_HOOKS_KEEP=${tid})

    get_target_property(type ${target} TYPE)
    if (type STREQUAL "STATIC_LIBRARY" OR type STREQUAL "OBJECT_LIBRARY")
        target_link_options(${target} INTERFACE "LINKER:-u,ggml_hooks_keep_${tid}")
    endif()
endfunction()

function(hooks_wrap target)
    cmake_parse_arguments(ARG "API" "" "SYMBOLS" ${ARGN})
    set(kind internal)
    if (ARG_API)
        set(kind api)
    endif()
    get_target_property(type ${target} TYPE)
    set(scope PUBLIC)
    if (type STREQUAL "STATIC_LIBRARY" OR type STREQUAL "OBJECT_LIBRARY" OR type STREQUAL "INTERFACE_LIBRARY")
        set(scope INTERFACE)
    endif()
    foreach (sym ${ARG_SYMBOLS})
        target_link_options(${target} ${scope} "LINKER:--wrap=${sym}")
        set_property(GLOBAL APPEND PROPERTY HOOKS_WRAPPED_SYMBOLS "${kind}:${target}:${sym}")
    endforeach()
endfunction()
